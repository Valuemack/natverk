    { namn: "Erikshjälpen – Årsberättelse 2025", url: "https://erikshjalpen.se/app/uploads/2026/05/EH_Arsberattelse_2025_digital.pdf", text: "stiftelsen, org.nr, separat juridisk person", datum: "2026-11-27" },
    { namn: "Erikshjälpen Second Hand – Människor, miljö och barnrätt 2025", url: "https://erikshjalpen.se/app/uploads/2026/05/ESH-Manniskor-miljo-och-barnratt-2025.pdf", text: "497 mnkr, 105,7 mnkr, 28 procent, personal", datum: "2026-11-27" },
    { namn: "Stockholms Stadsmission – Årsredovisning 2025", url: "https://www.stadsmissionen.se/sites/default/files/2026-06/AR_2025_260508_low%20res.pdf", text: "26 butiker, 276,9 mnkr, 501 volontärer", datum: "2026-11-27" },
    { namn: "PMU – Om oss", url: "https://pmu.se/om-oss/", text: "1965, Pingst", datum: "2026-11-27" },
    { namn: "PMU – Driva PMU-butik", url: "https://pmu.se/secondhand/drivapmubutik/", datum: "2026-11-27" },
    { namn: "Hela Människan – Om oss", url: "https://helamanniskan.se/om-oss/", datum: "2026-11-27" },
    { namn: "Björkåfrihet – Vår historia", url: "https://bjorkafrihet.se/var-historia/", datum: "2026-11-27" },
    { namn: "Artikel2 – Om oss", url: "https://artikel2.se/om-oss/", datum: "2026-11-27" },
    { namn: "Lindra – Om Lindra Second Hand", url: "https://lindra.se/om-lindra-second-hand/", datum: "2026-11-27" },
    { namn: "Svensk Insamlingskontroll", url: "https://www.insamlingskontroll.se/", text: "90-konto, grundad 1943", datum: "2026-11-27" },
