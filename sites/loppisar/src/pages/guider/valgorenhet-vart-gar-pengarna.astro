    { namn: "Välgörenhetsbutiker i Sverige", href: "/valgorenhet/", text: `${valg} butiker per organisation` },
    { namn: "Vad tar butikerna emot?", href: "/guider/skanka-mobler-och-saker/", text: "Skänka rätt" },
    { namn: "Vad händer med det du skänker?", href: "/guider/vad-hander-med-det-du-skanker/", text: "Butik, export, återvinning" },
    { namn: "När har loppisarna öppet?", href: "/guider/oppettider-second-hand/", text: "Öppettider per organisation" },
  ]}
