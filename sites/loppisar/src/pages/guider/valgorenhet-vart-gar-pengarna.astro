    { namn: "Röda Korset – Årsberättelse 2025", url: "https://www.rodakorset.se/siteassets/bilder/om-oss/seminarier/260428_rk_ab_2025_webb2.pdf", text: "1865, 260 butiker, 5 572 volontärer, 1 198 MSEK, 30 procent via lokalföreningarna", datum: "2026-11-27" },
    { namn: "Röda Korset – Second hand", url: "https://www.rodakorset.se/second-hand/", datum: "2026-11-27" },
