const PUBLICERAD = "2026-11-27";
const antal = Object.fromEntries(organisationer(KAT.enheter));
const valg = KAT.enheter.filter((e) => e.valgorenhet).length;
const kedjeSida = new Set(rakna(KAT.enheter, (e) => e.kedja).filter(([, c]) => c >= 5).map(([k]) => k));
const kl = (kedja) => (kedjeSida.has(kedja) ? `/kedja/${slug(kedja)}/` : null);
// Fakta per organisation. "egna" = vad organisationen själv anger om antal butiker.
const RADER = [
  { k: "Röda Korset", kedja: "Röda Korset", form: "Ideell förening (1865), lokala föreningar driver butikerna", egna: "260", folk: "5 572 volontärer i butikerna", pengar: "Hjälpverksamhet i Sverige och utomlands" },
  { k: "Erikshjälpen Second Hand", kedja: "Erikshjälpen Second Hand", form: "Egen juridisk person inom Erikshjälpen (insamlingsstiftelse, stadgar 1967)", egna: "50–51 (Sverige och Norge)", folk: "Anställda, praktikanter och volontärer", pengar: "Barns rättigheter – 28 % av Erikshjälpens finansiering" },
  { k: "Myrorna", kedja: "Myrorna", form: "Del av trossamfundet Frälsningsarmén, sedan 1896", egna: "32 + nätbutik", folk: "Anställd personal", pengar: "Frälsningsarméns sociala arbete – 16 mnkr 2025" },
  { k: "PMU Second Hand", kedja: "PMU Second Hand", form: "Avdelning inom Pingst – fria församlingar i samverkan, sedan 1965", egna: "57–60", folk: "Främst volontärer, ofta med en lokal församling", pengar: "Bistånd och lokala sociala projekt" },
  { k: "Stockholms Stadsmission", kedja: "Stadsmissionen", form: "Idéburen organisation från 1853, fristående från kyrka och stat", egna: "26", folk: "Anställda och 501 volontärer (hela organisationen)", pengar: "Stadsmissionens sociala arbete" },
  { k: "Göteborgs Stadsmission", kedja: "Stadsmissionen", form: "Idéburen organisation", egna: "–", folk: "–", pengar: "Stadsmissionens sociala arbete" },
  { k: "Hela Människan", kedja: "Hela Människan", form: "Kyrkornas gemensamma sociala arbete, tolv kyrkor som huvudmän", egna: "15", folk: "–", pengar: "Lokalt socialt arbete på 45 orter" },
  { k: "Artikel2", kedja: "Emmaus", form: "Ideell förening, tidigare Emmaus Stockholm (namnbyte 2023)", egna: "6", folk: "–", pengar: "Utvecklingsprojekt, främst utomlands" },
  { k: "Björkåfrihet", kedja: "Emmaus", form: "Ideell förening, tidigare Emmaus Björkå (namnbyte 2019)", egna: "3 + kompisbutiker", folk: "–", pengar: "Solidaritetsprojekt, asylrätt, antirasism" },
  { k: "Lindra Second Hand", kedja: "Lindra Second Hand", form: "Ideell förening som stöder Human Bridge", egna: "10–12", folk: "–", pengar: "Human Bridges sjukvårdsbistånd" },
