const fragor = [
  { fraga: "Vart går pengarna när man handlar på Myrorna?", svar: "Hela överskottet går till Frälsningsarméns sociala arbete i Sverige. År 2025 var överskottet 16 miljoner kronor. Myrorna ägs av Frälsningsarmén och har anställd personal." },
  { fraga: "Vart går pengarna från Erikshjälpen Second Hand?", svar: "Till Erikshjälpens arbete för barns rättigheter. Butikerna omsatte 497 miljoner kronor 2025 och stod för 28 procent av Erikshjälpens finansiering." },
  { fraga: "Vem driver Röda Korsets second hand-butiker?", svar: "De lokala Röda Korset-föreningarna, med 5 572 volontärer i butikerna enligt årsberättelsen för 2025. Röda Korset har cirka 260 butiker och överskottet går till hjälpverksamhet i Sverige och utomlands." },
  { fraga: "Vad är skillnaden mellan Myrorna och Erikshjälpen?", svar: "Myrorna är en del av Frälsningsarmén och pengarna går till dess sociala arbete i Sverige. Erikshjälpen är en insamlingsstiftelse som arbetar för barns rättigheter, och butikerna drivs i en egen juridisk person med anställda, praktikanter och volontärer." },
  { fraga: "Betalar välgörenhetsbutiker moms?", svar: "Ja. Sedan 2015 tar de stora ideella second hand-butikerna ut moms, eftersom Skatteverket ansåg att de konkurrerar med vanlig handel." },
];
---
<Guide site={SITE} titel="Röda Korset, Myrorna, Erikshjälpen – vart går pengarna?"
  beskrivning="Vem driver välgörenhetsbutikerna och vart går överskottet? Röda Korset, Myrorna, Erikshjälpen, Stadsmissionen, PMU, Hela Människan och Emmaus jämförda med egna siffror."
  h1="Vem driver second hand-butikerna – och vart går pengarna?"
  svar={`Välgörenhetsbutikerna drivs av ideella organisationer, och överskottet går till deras arbete. <strong>Myrorna</strong> ger hela överskottet till Frälsningsarméns sociala arbete (16 miljoner kronor 2025). <strong>Erikshjälpens</strong> butiker omsatte 497 miljoner kronor och står för 28 procent av organisationens finansiering. <strong>Röda Korsets</strong> cirka 260 butiker drivs av lokala föreningar med volontärer. Alla stora organisationer har 90-konto, och sedan 2015 tar butikerna ut moms.`}
  smulor={[{ namn: "Start", href: "/" }, { namn: "Guider", href: "/guider/" }, { namn: "Vart går pengarna?", href: "/guider/valgorenhet-vart-gar-pengarna/" }]}
  publicerad={PUBLICERAD} uppdaterad={PUBLICERAD} granskad="2026-11-27" avsnitt={[
    { id: "jamforelse", rubrik: "Jämförelse av organisationerna" },
    { id: "pengar", rubrik: "Hur mycket pengar handlar det om?" },
    { id: "organisationerna", rubrik: "Organisationerna en och en" },
    { id: "nittio", rubrik: "90-konto och kontroll" },
    { id: "moms", rubrik: "Moms och skatt" },
    { id: "valja", rubrik: "Hur väljer man butik?" },
  ]}
