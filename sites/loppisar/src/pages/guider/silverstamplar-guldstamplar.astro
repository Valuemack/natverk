// Guide: silver- och guldstämplar. Källor: lag (1999:779) och förordning (1999:780) om handel med ädelmetallarbeten,
// förordning (1987:423) 13–14 §§ (årsbeteckning sedan 1759), SOU 2026:14 Ädelmetallutredningen, Hallmarking Conventions
// landprofil för Sverige, Swedac (STAFS 2025:7), MFA Bostons CAMEO (nysilver) och Nationalmuseum (GAB). Granskad 2026-11-27.
// Årsbokstavstabellen är vår uträkning ur regeln i 1987 års förordning, inte en officiell tabell.
import Guide from "@natverk/core/Guide.astro";
import Faq from "@natverk/core/Faq.astro";
import Annons from "@natverk/core/Annons.astro";
import { SITE } from "../../site.js";

const PUBLICERAD = "2026-11-27";
const BOKST = "ABCDEFGHIKLMNOPQRSTUVXYZ".split("");
const arsbokstav = (ar) => { const i = ar - 1759, omg = Math.floor(i / 24) + 1; return `${BOKST[i % 24]}${omg > 1 ? omg : ""}`; };
const serier = Array.from({ length: 12 }, (_, i) => { const start = 1759 + i * 24; return { omg: i + 1, start, slut: start + 23, forst: arsbokstav(start), sist: arsbokstav(start + 23) }; });
const exempel = [1900, 1925, 1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020, 2026].map((ar) => ({ ar, b: arsbokstav(ar) }));
const fragor = [
  { fraga: "Hur ser man om något är äkta silver?", svar: "Leta efter stämplar: en halt som 925, 830 eller 800, gärna tillsammans med tre kronor och S, en namnstämpel, ett stadsmärke och en årsbokstav. Står det nysilver, alpacka eller EPNS är det inte silver. Ett osäkert föremål kan provas av en guldsmed eller ett kontrollorgan." },
  { fraga: "Vad betyder tre kronor på silver?", svar: "Det är den svenska kontrollstämpeln, lilla riksvapnet i en trepassformad sköld, som har använts sedan 1754. Följt av ett S betyder den att ett kontrollorgan har provat att silverhalten stämmer. Sedan 1986 års lag är kontrollstämplingen frivillig." },
  { fraga: "Vilket år är silvret tillverkat?", svar: "Svenskt silver har ofta en årsbokstav, en bokstav följd av en siffra. Serien började 1759 med A, och siffran anger vilken omgång av alfabetet det är. Till exempel betyder A10 år 1975 och C12 år 2025 enligt vår uträkning." },
  { fraga: "Vad betyder 18K och 14K på guld?", svar: "Karat anger guldhalten i tjugofjärdedelar. 18 karat motsvarar 750 tusendelar och 14 karat ungefär 585 tusendelar. I Sverige får guld säljas som guld från 375 tusendelar, vilket motsvarar 9 karat." },
  { fraga: "Är nysilver äkta silver?", svar: "Nej. Nysilver, alpacka och German silver är en legering av koppar, nickel och oftast zink utan silver. EPNS betyder att nysilver har försilvrats med ett tunt lager silver." },
];
---
