    { namn: "Naturvårdsverket – Krav på separat insamling av textilavfall", url: "https://www.naturvardsverket.se/vagledning-och-stod/avfall/krav-pa-separat-insamling-av-textilavfall/", text: "från 1 januari 2025, undantag från 1 oktober 2025 (granskad 6 november 2025)", datum: HAMTAT },
