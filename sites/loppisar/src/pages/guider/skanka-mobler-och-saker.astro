  { sak: "Glas, porslin och husgeråd", v: ["J", "J", "J", "?", "J", "J", "J", "J"] },
  { sak: "Möbler", v: ["Mindre, fråga först", "J", "Större butiker", "J", "Små i butik", "Alingsås, Alelyckan", "Bara Kista", "Inte stora"] },
  { sak: "Soffor", v: ["?", "?", "?", "?", "N", "N", "?", "?"] },
  { sak: "Madrasser och sängar", v: ["?", "?", "?", "?", "N", "N", "?", "N"] },
  { sak: "Vitvaror", v: ["N", "N", "?", "?", "N", "N", "?", "N"] },
  { sak: "Tjock-tv", v: ["N", "N", "N", "N", "N", "N", "?", "N"] },
  { sak: "Fungerande småelektronik", v: ["J", "J", "J", "J", "?", "?", "J", "?"] },
  { sak: "Bilbarnstolar", v: ["N", "N", "?", "N", "N", "?", "?", "N"] },
  { sak: "Hjälmar och flytvästar", v: ["N", "N", "?", "N", "N", "?", "?", "Nej (flytvästar)"] },
  { sak: "Uppslagsverk", v: ["N", "N", "N", "N", "?", "?", "N", "N"] },
  { sak: "Pianon", v: ["?", "N", "N", "N", "?", "N", "?", "?"] },
  { sak: "Gratis hämtning", v: ["Vissa butiker", "Ja, boka", "Ja, boka", "Vid större mängder", "?", "Större mängder", "?", "Nej"] },
