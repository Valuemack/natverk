const T = { J: "Ja", "J*": "Ja, fråga först", N: "Nej", "?": "–" };
const fragor = [
  { fraga: "Vilka second hand-butiker tar emot möbler?", svar: "Erikshjälpen och PMU tar emot möbler. Myrorna tar emot möbler i de större butikerna, och Röda Korset tar emot mindre möbler – ring först. Stockholms Stadsmission tar emot små möbler i butikerna och större på fyra återvinningscentraler. Göteborgs Stadsmission tar emot möbler i Alingsås och på Alelyckan." },
  { fraga: "Vilka hämtar möbler gratis?", svar: "Erikshjälpen hämtar gratis efter bokning hos den lokala butiken, och Myrornabilen hämtar gratis efter bokning. De flesta PMU-butiker hämtar gratis vid större mängder, till exempel dödsbon. Vissa Röda Korset-butiker hämtar. Björkåfrihet hämtar inte." },
  { fraga: "Var kan man skänka en soffa?", svar: "Stockholms Stadsmission tar inte emot soffor, Göteborgs Stadsmission inte stora soffor, hörn- eller bäddsoffor, och Björkåfrihet inte stora, otympliga möbler. Övriga organisationer anger inget generellt nej, så ring den lokala Erikshjälpen-, PMU- eller Myrornabutiken och fråga. Säljer ingen, lämna soffan på återvinningscentralen – många har en återbruksdel." },
