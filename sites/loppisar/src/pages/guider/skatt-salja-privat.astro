  { id: "hobby", rubrik: "När loppisen blir hobby eller företag" },
  { id: "moms", rubrik: "Moms och F-skatt" },
  { id: "plattformar", rubrik: "Blocket, Tradera och plattformarnas rapportering" },
  { id: "checklista", rubrik: "Checklista för dig som säljer" },
];
const fragor = [
  { fraga: "Måste man betala skatt när man säljer saker på loppis?", svar: "Nej, inte för vanliga personliga saker så länge den sammanlagda vinsten under året är högst 50 000 kronor. Det mesta säljs dessutom med förlust jämfört med vad det kostade, och förlust ger ingen skatt." },
  { fraga: "Gäller 50 000-kronorsgränsen försäljningspriset eller vinsten?", svar: "Vinsten. Du räknar vinsten för varje sak, lägger ihop vinsterna och drar av 50 000 kronor. Det som blir kvar beskattas med 30 procent som inkomst av kapital." },
  { fraga: "Vad gör jag om jag inte vet vad saken kostade?", svar: "Du får räkna med att den kostade 25 procent av försäljningspriset (efter försäljningskostnader). Det är Skatteverkets schablon för personliga tillgångar." },
  { fraga: "Rapporterar Blocket och Tradera mina försäljningar till Skatteverket?", svar: "Plattformar ska sedan 2023 rapportera säljare som under ett år har minst 30 försäljningar eller säljer för mer än 2 000 euro. Rapporteringen ändrar inte skattereglerna – den gör bara att Skatteverket ser försäljningarna." },
  { fraga: "Måste jag ha F-skatt för att sälja på loppis?", svar: "Nej, inte när du säljer dina egna saker. F-skatt blir aktuellt när försäljningen är näringsverksamhet, till exempel när du regelbundet köper in saker för att sälja vidare." },
];
---
