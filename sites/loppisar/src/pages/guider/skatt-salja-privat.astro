const PUBLICERAD = "2026-11-27";
const kr = (n) => `${String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, " ")} kr`;
// Räkneexempel: tre försäljningar under ett år, beräknade enligt Skatteverkets regler för personliga tillgångar.
const exempel = [
  { sak: "Soffa", pris: 5000, inkop: 13000 },
  { sak: "Begagnad båt", pris: 85000, inkop: 40000 },
  { sak: "Tavla (ärvd, okänt inköpspris)", pris: 12000, inkop: null },
].map((x) => {
  const omk = x.inkop ?? x.pris * 0.25;
  return { ...x, omk, vinst: Math.max(0, x.pris - omk) };
});
const summa = exempel.reduce((s, x) => s + x.vinst, 0);
const skattepliktig = Math.max(0, summa - 50000);

const avsnitt = [
  { id: "grundregel", rubrik: "Grundregeln: personliga saker och 50 000 kronor" },
  { id: "rakna", rubrik: "Så räknar du vinsten" },
