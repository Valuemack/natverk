---
// Alla guider, grupperade efter ämne (listan finns i src/guider.js).
import Layout from "@natverk/core/Layout.astro";
import { SITE, UPPDATERAD } from "../../site.js";
import { GUIDEGRUPPER, GUIDER } from "../../guider.js";
---
<Layout site={SITE} titel={`Guider om loppis och second hand – ${GUIDER.length} guider`}
  beskrivning={`${GUIDER.length} guider om loppis och second hand: skatt när du säljer, dina rättigheter, vad butikerna tar emot, vart pengarna går, silverstämplar och miljön.`}
  smulor={[{ namn: "Start", href: "/" }, { namn: "Guider", href: "/guider/" }]} uppdaterad={UPPDATERAD}>
  <h1>Guider om loppis och second hand</h1>
  <p class="svar">{GUIDER.length} guider som bygger på myndigheternas regler, organisationernas egna rapporter och vårt register över alla loppisar och second hand-butiker i Sverige. Varje guide anger sina källor och när de granskades.</p>
  {GUIDEGRUPPER.map((g) => <>
    <h2>{g.rubrik}</h2>
    <div class="kort">{g.guider.map((x) => <a href={`/guider/${x.slug}/`}><strong>{x.namn}</strong><small>{x.text}</small></a>)}</div>
  </>)}
</Layout>
