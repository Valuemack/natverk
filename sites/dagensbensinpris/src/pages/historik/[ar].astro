---
// Bensinpriset ett visst år: månad för månad, högsta och lägsta vecka, jämförelse med året innan.
import Layout from "@natverk/core/Layout.astro";
import Annons from "@natverk/core/Annons.astro";
import Faq from "@natverk/core/Faq.astro";
import { faqLd } from "@natverk/core/seo.js";
import Kurva from "../../components/Kurva.astro";
import { SITE, UPPDATERAD, AR_LISTA, arSammanfattning, kr, pris, procent, datumText, manadText, skattedelar } from "../../site.js";

export function getStaticPaths() {
  return AR_LISTA.map((ar) => ({ params: { ar: String(ar) }, props: { ar } }));
}
const { ar } = Astro.props;
const s = arSammanfattning(ar);
const f = arSammanfattning(ar - 1);
const n = arSammanfattning(ar + 1);
const forandring = f ? s.b95.medel / f.b95.medel - 1 : null;
const sistaVecka = s.veckor.at(-1);
const skattSlut = skattedelar(sistaVecka);
const dyrastMan = [...s.manader].sort((a, b) => b.b95 - a.b95)[0];
const billigastMan = [...s.manader].sort((a, b) => a.b95 - b.b95)[0];
const pagaende = !s.komplett;

const fragor = [
  { fraga: `Vad kostade bensin ${ar}?`, svar: `Bensin 95 kostade i snitt ${kr(s.b95.medel)} per liter ${pagaende ? `hittills under ${ar}` : `under ${ar}`}, enligt det genomsnittliga pumppriset vecka för vecka. Lägst var ${kr(s.b95.lag)} (${datumText(s.b95.lagDatum)}) och högst ${kr(s.b95.hog)} (${datumText(s.b95.hogDatum)}).` },
  s.diesel && { fraga: `Vad kostade diesel ${ar}?`, svar: `Diesel kostade i snitt ${kr(s.diesel.medel)} per liter ${pagaende ? "hittills i år" : `under ${ar}`}. Högst var ${kr(s.diesel.hog)} (${datumText(s.diesel.hogDatum)}).` },
  f && { fraga: `Var bensinen dyrare ${ar} än ${ar - 1}?`, svar: `${forandring > 0 ? "Ja" : "Nej"}. Snittpriset för 95 var ${kr(s.b95.medel)} ${ar} mot ${kr(f.b95.medel)} ${ar - 1}, ${forandring > 0 ? "en ökning" : "en minskning"} med ${procent(Math.abs(forandring) * 100, 1)}.` },
  { fraga: `Vilken månad var bensinen dyrast ${ar}?`, svar: `${manadText(dyrastMan.ym).replace(/^./, (c) => c.toUpperCase())} hade högst snittpris (${kr(dyrastMan.b95)}) och ${manadText(billigastMan.ym)} lägst (${kr(billigastMan.b95)}).` },
].filter(Boolean);
---
<Layout site={SITE} titel={`Bensinpris ${ar} – snittpris ${pris(s.b95.medel)} kr och alla månader`}
  beskrivning={`Bensinpriset ${ar}: 95 kostade i snitt ${kr(s.b95.medel)}/l${s.diesel ? ` och diesel ${kr(s.diesel.medel)}/l` : ""}. Högsta och lägsta veckan, pris månad för månad och jämförelse med ${ar - 1}.`}
  smulor={[{ namn: "Bensinpris idag", href: "/" }, { namn: "Historik", href: "/historik/" }, { namn: String(ar), href: `/historik/${ar}/` }]} jsonld={[faqLd(fragor)]} uppdaterad={UPPDATERAD}>
  <h1>Bensinpriset {ar}</h1>
  <p class="svar">Bensin 95 kostade i snitt <strong>{kr(s.b95.medel)}</strong> per liter {pagaende ? `hittills under ${ar}` : `under ${ar}`}{s.diesel && <> och diesel <strong>{kr(s.diesel.medel)}</strong></>}.{f && <> Det är {procent(Math.abs(forandring) * 100, 1)} {forandring > 0 ? "dyrare" : "billigare"} än {ar - 1}.</>}</p>

  <Kurva titel={`Pumppris vecka för vecka ${ar}`} linjer={[
    { namn: "Bensin 95", farg: "#d97706", punkter: s.veckor.map((x) => ({ x: x.datum, y: x.b95 })) },
    ...(s.diesel ? [{ namn: "Diesel", farg: "#334155", punkter: s.veckor.map((x) => ({ x: x.datum, y: x.diesel })) }] : []),
  ]} />

  <h2>Pris månad för månad {ar}</h2>
  <div class="tabell"><table>
    <thead><tr><th>Månad</th><th class="num">Bensin 95</th><th class="num">Diesel</th></tr></thead>
    <tbody>{s.manader.map((m) => <tr><td>{manadText(m.ym)}</td><td class="num">{pris(m.b95)}</td><td class="num">{m.diesel ? pris(m.diesel) : "–"}</td></tr>)}</tbody>
  </table></div>
  <p class="kalla">Snitt av veckornas genomsnittliga pumppris (kr per liter inkl. skatt). Källa: EU-kommissionen, Weekly Oil Bulletin.</p>

  <Annons plats="ar-1" />

  <h2>Högsta och lägsta pris {ar}</h2>
  <div class="tabell"><table>
    <thead><tr><th></th><th class="num">Bensin 95</th><th class="num">Diesel</th></tr></thead>
    <tbody>
      <tr><td>Snitt</td><td class="num">{pris(s.b95.medel)}</td><td class="num">{s.diesel ? pris(s.diesel.medel) : "–"}</td></tr>
      <tr><td>Lägsta vecka</td><td class="num">{pris(s.b95.lag)} <small>({datumText(s.b95.lagDatum)})</small></td><td class="num">{s.diesel ? <>{pris(s.diesel.lag)} <small>({datumText(s.diesel.lagDatum)})</small></> : "–"}</td></tr>
      <tr><td>Högsta vecka</td><td class="num">{pris(s.b95.hog)} <small>({datumText(s.b95.hogDatum)})</small></td><td class="num">{s.diesel ? <>{pris(s.diesel.hog)} <small>({datumText(s.diesel.hogDatum)})</small></> : "–"}</td></tr>
    </tbody>
  </table></div>

  {skattSlut && <p>I {pagaende ? "den senaste veckan" : `slutet av ${ar}`} var {procent(skattSlut.andelSkatt * 100)} av priset för 95 skatt: {kr(skattSlut.punkt)} i energi- och koldioxidskatt och {kr(skattSlut.moms)} i moms per liter.</p>}

  <nav class="blad" aria-label="Andra år">
    {f && <a href={`/historik/${ar - 1}/`}>← Bensinpriset {ar - 1}</a>}
    {n && <a href={`/historik/${ar + 1}/`}>Bensinpriset {ar + 1} →</a>}
  </nav>
  <p><a href="/historik/">Alla år sedan {AR_LISTA[0]}</a> · <a href="/">Bensinpris idag</a></p>

  <Faq fragor={fragor} />
</Layout>
