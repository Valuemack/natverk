---
// Ett drivmedel: dagens pris per kedja, utveckling, fakta och var det går att tanka.
import Layout from "@natverk/core/Layout.astro";
import Annons from "@natverk/core/Annons.astro";
import Faq from "@natverk/core/Faq.astro";
import { faqLd } from "@natverk/core/seo.js";
import Kurva from "../../components/Kurva.astro";
import Prisrutor from "../../components/Prisrutor.astro";
import { OM_DRIVMEDEL } from "../../lib/texter.js";
import {
  SITE, UPPDATERAD, AKTUELL, LP_DATUM, DRIVMEDEL, LISTKEDJOR, DAGAR, idagPris, dagsAndring, kedjePris, kr, pris, andring, riktning, procent,
  datumText, VECKOR, SENASTE_VECKA, FORRA_VECKAN, skattedelar, STATIONER, BENSINSTATIONER_URL, arSammanfattning, AR,
} from "../../site.js";

export function getStaticPaths() {
  return DRIVMEDEL.filter((d) => idagPris(d.nyckel) != null).map((d) => ({ params: { drivmedel: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const k = d.nyckel;
const datum = datumText(LP_DATUM);
const p = idagPris(k);
const a = dagsAndring(k);
const kedjor = LISTKEDJOR.map((c) => ({ c, p: kedjePris(c, k) })).filter((x) => x.p != null).sort((x, y) => x.p - y.p);
const text = OM_DRIVMEDEL[k];
const enhetOrd = d.enhet === "kr/kg" ? "kilo" : "liter";
const p95 = idagPris("bensin95");
const euKol = d.eu; // "b95" | "diesel" | null
const v = SENASTE_VECKA, fv = FORRA_VECKAN;
const skatt = euKol ? skattedelar(v, euKol) : null;
const ifjol = euKol ? arSammanfattning(AR - 1)?.[euKol] : null;
const dagSerie = DAGAR.filter((x) => x.snitt[k] != null).map((x) => ({ x: x.datum, y: x.snitt[k] }));
const stationer = STATIONER.filter((s) => s.drivmedel?.[k] === true);
const perLan = Object.entries(stationer.reduce((m, s) => ((m[s.lan ?? "Okänt län"] = (m[s.lan ?? "Okänt län"] ?? 0) + 1), m), {})).sort((x, y) => y[1] - x[1]);
const drivmedelSlugBensinstationer = { e85: "e85", hvo100: "hvo100", biogas: "fordonsgas" }[k];
const GUIDER = { bensin95: { href: "/guider/95-eller-98/", namn: "Bensin 95 eller 98 – vad är skillnaden?" }, bensin98: { href: "/guider/95-eller-98/", namn: "Bensin 95 eller 98 – vad är skillnaden?" }, diesel: { href: "/guider/reduktionsplikt/", namn: "Reduktionsplikten – så fungerar den" }, e85: { href: "/guider/hvo100-e85-fordonsgas/", namn: "HVO100, E85 och fordonsgas – priser och skillnader" }, hvo100: { href: "/guider/hvo100-e85-fordonsgas/", namn: "HVO100, E85 och fordonsgas – priser och skillnader" }, biogas: { href: "/guider/hvo100-e85-fordonsgas/", namn: "HVO100, E85 och fordonsgas – priser och skillnader" } };
const guide = GUIDER[k];
const ovriga = DRIVMEDEL.filter((x) => x.nyckel !== k && idagPris(x.nyckel) != null);

// Jämförelser som är meningsfulla för respektive drivmedel.
const jamfor = [];
if (k === "bensin98" && p95) jamfor.push(`98 kostar idag ${kr(p - p95)} mer per liter än 95. För en tank på 50 liter blir skillnaden ${kr((p - p95) * 50, 0)}.`);
if (k === "diesel" && p95) jamfor.push(`Diesel kostar idag ${p > p95 ? `${kr(p - p95)} mer` : `${kr(p95 - p)} mindre`} per liter än bensin 95.`);
if (k === "e85" && p95) {
  const brytpunkt = p95 / 1.3;
  jamfor.push(`E85 kostar ${procent((1 - p / p95) * 100)} mindre per liter än 95 idag. Med en merförbrukning på 30 procent motsvarar E85 ${kr(p * 1.3)} per liter bensin, alltså ${p * 1.3 < p95 ? "billigare" : "dyrare"} än 95 (${kr(p95)}).`);
  jamfor.push(`E85 lönar sig när literpriset är under ungefär ${kr(brytpunkt)} vid dagens bensinpris (räknat med 30 procents merförbrukning).`);
}
if (k === "hvo100") { const ds = idagPris("diesel"); if (ds) jamfor.push(`HVO100 kostar idag ${kr(p - ds)} mer per liter än vanlig diesel, ${procent((p / ds - 1) * 100)} dyrare.`); }
if (k === "biogas" && p95) jamfor.push(`Ett kilo fordonsgas motsvarar ungefär 1,5 liter bensin. Dagens pris på ${kr(p)} per kilo motsvarar alltså ${kr(p / 1.5)} per liter bensin, att jämföra med ${kr(p95)} för 95.`);

const fragor = [
  { fraga: `Vad kostar ${d.liten} idag?`, svar: `${d.namn} kostar i snitt ${kr(p)} per ${enhetOrd} den ${datum} enligt kedjornas listpriser${kedjor.length > 1 ? ` (${kr(kedjor[0].p)}–${kr(kedjor.at(-1).p)})` : ""}.` },
  kedjor.length > 1 && { fraga: `Var är ${d.liten} billigast idag?`, svar: `Lägst listpris har ${kedjor.filter((x) => x.p === kedjor[0].p).map((x) => x.c).join(" och ")} med ${kr(kedjor[0].p)} per ${enhetOrd}. Obemannade stationer och lågpriskedjor kan ligga lägre men publicerar inga priser.` },
  euKol && { fraga: `Har ${d.liten} blivit dyrare?`, svar: `Genomsnittspriset vid pump var ${kr(v[euKol])} veckan som började ${datumText(v.datum)}, ${andring(v[euKol] - fv[euKol])} mot veckan innan.${ifjol ? ` Snittet för hela ${AR - 1} var ${kr(ifjol.medel)}.` : ""}` },
  skatt && { fraga: `Hur mycket skatt är det på ${d.liten}?`, svar: `Ungefär ${procent(skatt.andelSkatt * 100)} av priset är skatt: ${kr(skatt.punkt)} i energi- och koldioxidskatt och ${kr(skatt.moms)} i moms per liter (senaste veckan).` },
  { fraga: `Hur många stationer säljer ${d.liten}?`, svar: `${stationer.length.toLocaleString("sv-SE")} stationer i vårt register anger att de säljer ${d.liten}${perLan[0] ? `, flest i ${perLan[0][0]} (${perLan[0][1]})` : ""}.` },
].filter(Boolean);
---
<Layout site={SITE} titel={`${d.namn === "Diesel" ? "Dieselpris" : `${d.namn}`} idag ${datum} – ${pris(p)} ${d.enhet}${d.nyckel === "diesel" ? ", alla kedjor" : ""}`}
  beskrivning={`${d.namn} kostar ${kr(p)} per ${enhetOrd} idag (${datum}). ✓ Pris per kedja ✓ Utveckling ✓ Skatter ✓ ${stationer.length.toLocaleString("sv-SE")} stationer som säljer ${d.kort}.`}
  smulor={[{ namn: "Bensinpris idag", href: "/" }, { namn: d.namn, href: `/${d.slug}/` }]} jsonld={[faqLd(fragor)]} uppdaterad={UPPDATERAD}>
  <h1>{d.nyckel === "diesel" ? "Dieselpris idag" : `${d.namn} – pris idag`}</h1>
  <p class="svar">{d.namn} kostar i snitt <strong>{kr(p)}</strong> per {enhetOrd} {AKTUELL ? "idag" : "enligt senaste listpriserna"}, {datum}.{a && Math.abs(a.varde) > 0.004 && <> Det är <span class={riktning(a.varde)}>{andring(a.varde)}</span> jämfört med {datumText(a.mot)}.</>}{kedjor.length > 1 && <> Billigast är {kedjor[0].c} med {kr(kedjor[0].p)}.</>}</p>

  <h2>{d.namn} per kedja</h2>
  <div class="tabell"><table>
    <thead><tr><th>Kedja</th><th class="num">Pris ({d.enhet})</th><th class="num">Mot snittet</th></tr></thead>
    <tbody>{kedjor.map((x) => <tr><td><a href={`/kedja/${x.c.toLowerCase().replace(/\s+/g, "-")}/`}>{x.c}</a></td><td class="num">{pris(x.p)}</td><td class="num">{andring(x.p - p)}</td></tr>)}</tbody>
  </table></div>
  <p class="kalla">Kedjornas listpriser inkl. moms den {LP_DATUM}. Priset vid pumpen sätts lokalt och kan avvika.</p>

  {jamfor.length > 0 && <><h2>Jämförelse</h2>{jamfor.map((t) => <p>{t}</p>)}</>}

  <Annons plats="drivmedel-1" />

  {euKol && <>
    <h2>Pumppriset vecka för vecka</h2>
    <p>Genomsnittligt pumppris för {d.liten} i Sverige enligt EU-kommissionens veckostatistik. Senaste veckan: <strong>{kr(v[euKol])}</strong> ({andring(v[euKol] - fv[euKol])} mot veckan innan).</p>
    <Kurva titel={`${d.namn} i Sverige, senaste tre åren`} linjer={[{ namn: d.namn, farg: euKol === "b95" ? "#d97706" : "#334155", punkter: VECKOR.slice(-157).map((x) => ({ x: x.datum, y: x[euKol] })) }]} />
    <p><a href="/historik/">Hela historiken sedan 2005</a></p>
  </>}
  {!euKol && dagSerie.length >= 14 && <>
    <h2>Utvecklingen dag för dag</h2>
    <Kurva titel={`${d.namn}, snitt av kedjornas listpriser`} enhet={d.enhet} linjer={[{ namn: d.namn, farg: "#d97706", punkter: dagSerie }]} />
  </>}

  <h2>Om {d.liten}</h2>
  <p><strong>{text.ingress}</strong></p>
  {text.stycken.map((s) => <p>{s}</p>)}
  {guide && <p>Läs mer: <a href={guide.href}>{guide.namn}</a>.</p>}

  {skatt && <>
    <h2>Skatten på {d.liten}</h2>
    <div class="tabell"><table>
      <thead><tr><th>Del av priset</th><th class="num">Kr per liter</th><th class="num">Andel</th></tr></thead>
      <tbody>
        <tr><td>Produkt, frakt och marginal</td><td class="num">{pris(skatt.produkt)}</td><td class="num">{procent(skatt.produkt / skatt.pris * 100)}</td></tr>
        <tr><td>Energi- och koldioxidskatt</td><td class="num">{pris(skatt.punkt)}</td><td class="num">{procent(skatt.punkt / skatt.pris * 100)}</td></tr>
        <tr><td>Moms</td><td class="num">{pris(skatt.moms)}</td><td class="num">{procent(skatt.moms / skatt.pris * 100)}</td></tr>
      </tbody>
    </table></div>
    <p class="kalla">Veckan som började {datumText(v.datum)}. <a href="/guider/vad-bestar-bensinpriset-av/">Så består priset</a>.</p>
  </>}

  <Annons plats="drivmedel-2" />

  <h2>Var kan man tanka {d.kort}?</h2>
  <p>{stationer.length.toLocaleString("sv-SE")} stationer i Sverige anger att de säljer {d.liten}. Flest finns i:</p>
  <div class="tabell"><table>
    <thead><tr><th>Län</th><th class="num">Stationer</th></tr></thead>
    <tbody>{perLan.slice(0, 10).map(([lan, n]) => <tr><td>{lan}</td><td class="num">{n}</td></tr>)}</tbody>
  </table></div>
  <p>Hitta en station nära dig på <a href={drivmedelSlugBensinstationer ? `${BENSINSTATIONER_URL}/drivmedel/${drivmedelSlugBensinstationer}/` : `${BENSINSTATIONER_URL}/`}>bensinstationer.nu</a>.</p>

  <h2>Andra drivmedel idag</h2>
  <Prisrutor />
  <ul>{ovriga.map((x) => <li><a href={`/${x.slug}/`}>{x.namn}</a>: {kr(idagPris(x.nyckel))} per {x.enhet === "kr/kg" ? "kilo" : "liter"}</li>)}</ul>

  <Faq fragor={fragor} />
</Layout>
