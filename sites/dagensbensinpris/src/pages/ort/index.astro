---
// Alla kommuner, grupperade per län.
import Layout from "@natverk/core/Layout.astro";
import { SITE, UPPDATERAD, KOMMUNER, idagPris, kr, LP_DATUM, datumText } from "../../site.js";

const perLan = new Map();
for (const k of KOMMUNER) {
  const lan = k.stationer.find((s) => s.lan)?.lan ?? "Övriga";
  if (!perLan.has(lan)) perLan.set(lan, []);
  perLan.get(lan).push(k);
}
const lanLista = [...perLan.entries()].sort((a, b) => a[0].localeCompare(b[0], "sv"));
---
<Layout site={SITE} titel={`Bensinpris per kommun – alla ${KOMMUNER.length} kommuner`}
  beskrivning={`Bensinpris idag i din kommun: kedjorna som finns där, deras listpris och obemannade stationer. Snittet för 95 är ${kr(idagPris("bensin95"))}/l (${datumText(LP_DATUM)}).`}
  smulor={[{ namn: "Bensinpris idag", href: "/" }, { namn: "Per ort", href: "/ort/" }]} uppdaterad={UPPDATERAD}>
  <h1>Bensinpris per kommun</h1>
  <p class="svar">Välj din kommun för att se vilka kedjor som finns där och vad de tar för 95, diesel och E85 idag. Snittet i landet är <strong>{kr(idagPris("bensin95"))}</strong> per liter 95.</p>
  {lanLista.map(([lan, lista]) => <>
    <h2>{lan}</h2>
    <ul class="kolumner">{lista.map((k) => <li><a href={`/ort/${k.slug}/`}>{k.namn}</a> <small>({k.stationer.length})</small></li>)}</ul>
  </>)}
</Layout>
