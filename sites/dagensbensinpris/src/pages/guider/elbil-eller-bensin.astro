---
// Elbil eller bensin/diesel: kostnad per mil och år med dagens drivmedelspris, och brytpunkten för elpriset.
// Elpriset varierar per hushåll och laddare, så det fylls i av besökaren; tabellerna visar räkneexempel.
import Layout from "@natverk/core/Layout.astro";
import Annons from "@natverk/core/Annons.astro";
import Faq from "@natverk/core/Faq.astro";
import { faqLd } from "@natverk/core/seo.js";
import { SITE, UPPDATERAD, LP_DATUM, idagPris, kr, pris, datumText } from "../../site.js";

const datum = datumText(LP_DATUM);
const p95 = idagPris("bensin95"), pd = idagPris("diesel");
// Räkneexempel (kan ändras i kalkylatorn): förbrukning för en mellanstor bil.
const B = 0.6, D = 0.5, E = 2.0; // l/mil, l/mil, kWh/mil inklusive laddförluster
const perMilB = B * p95, perMilD = D * pd;
const brytB = perMilB / E, brytD = perMilD / E;
const elpriser = [1, 1.5, 2, 2.5, 3, 4, 5, 6];
const MIL_AR = 1500;
const fragor = [
  { fraga: "Är det billigare att köra elbil än bensinbil?", svar: `Med dagens bensinpris (${kr(p95)} per liter) kostar en bensinbil som drar ${B.toLocaleString("sv-SE")} liter per mil ${kr(perMilB)} per mil. En elbil som drar ${E.toLocaleString("sv-SE")} kWh per mil är billigare så länge elen kostar under ${kr(brytB)} per kWh, allt inräknat.` },
  { fraga: "Vad kostar det att köra elbil per mil?", svar: `Multiplicera förbrukningen i kWh per mil med vad elen kostar per kWh, inklusive nätavgift, skatt och moms. Med ${E.toLocaleString("sv-SE")} kWh per mil och ett totalt elpris på 2 kronor per kWh blir det ${kr(E * 2)} per mil.` },
  { fraga: "Hur mycket sparar man per år med elbil?", svar: `Vid ${MIL_AR.toLocaleString("sv-SE")} mil om året kostar bensinen ${kr(perMilB * MIL_AR, 0)} med dagens pris. Laddar du hemma för 2 kronor per kWh kostar elen ${kr(E * 2 * MIL_AR, 0)}, alltså ${kr((perMilB - E * 2) * MIL_AR, 0)} mindre. Skatt, försäkring, service och värdeminskning skiljer sig också mellan bilarna.` },
  { fraga: "Lönar det sig att snabbladda?", svar: `Snabbladdning kostar oftast betydligt mer per kWh än att ladda hemma. Kostar laddningen mer än ${kr(brytB)} per kWh blir milen dyrare än med en bensinbil som drar ${B.toLocaleString("sv-SE")} liter per mil.` },
];
---
<Layout site={SITE} titel={`Elbil eller bensin – vad kostar milen? (priser ${datum})`}
  beskrivning={`Elbil, bensin eller diesel? Med dagens pris kostar bensinen ${kr(perMilB)} per mil. Elbilen är billigare så länge elen kostar under ${kr(brytB)}/kWh. Räkna med din förbrukning och ditt elpris.`}
  smulor={[{ namn: "Bensinpris idag", href: "/" }, { namn: "Guider", href: "/guider/" }, { namn: "Elbil eller bensin", href: "/guider/elbil-eller-bensin/" }]} jsonld={[faqLd(fragor)]} uppdaterad={UPPDATERAD}>
  <h1>Elbil eller bensin – vad kostar milen?</h1>
  <p class="svar">Med dagens bensinpris ({kr(p95)} per liter) kostar en bensinbil som drar {B.toLocaleString("sv-SE")} liter per mil <strong>{kr(perMilB)} per mil</strong>. En elbil som drar {E.toLocaleString("sv-SE")} kWh per mil är billigare i drift så länge elen kostar under <strong>{kr(brytB)} per kWh</strong> – nätavgift, skatt och moms inräknat. Mot en dieselbil går gränsen vid {kr(brytD)} per kWh.</p>

  <form class="berakning" id="elkalk" onsubmit="return false">
    <label>Elpris (kr per kWh, allt inräknat)<input name="el" type="number" inputmode="decimal" min="0" step="0.05" value="2" /></label>
    <label>Elbilens förbrukning (kWh per mil)<input name="kwh" type="number" inputmode="decimal" min="0" step="0.1" value={E} /></label>
    <label>Bensinbilens förbrukning (l per mil)<input name="liter" type="number" inputmode="decimal" min="0" step="0.05" value={B} /></label>
    <label>Bensinpris (kr per liter)<input name="pris" type="number" inputmode="decimal" min="0" step="0.01" value={p95.toFixed(2)} /></label>
    <label>Mil per år<input name="mil" type="number" inputmode="numeric" min="0" step="100" value={MIL_AR} /></label>
    <output name="ut" aria-live="polite"></output>
  </form>
  <script is:inline>
    (() => {
      const f = document.getElementById("elkalk");
      const kr = (v, d = 2) => v.toLocaleString("sv-SE", { minimumFractionDigits: d, maximumFractionDigits: d }) + " kr";
      const tal = (n) => parseFloat(String(f[n].value).replace(",", ".")) || 0;
      const rakna = () => {
        const el = tal("kwh") * tal("el"), be = tal("liter") * tal("pris"), mil = tal("mil");
        const skillnad = (be - el) * mil;
        f.ut.value = `Elbil ${kr(el)} per mil · bensinbil ${kr(be)} per mil · ${skillnad >= 0 ? "elbilen sparar" : "bensinbilen sparar"} ${kr(Math.abs(skillnad), 0)} per år · brytpunkt ${kr(tal("kwh") ? be / tal("kwh") : 0)} per kWh`;
      };
      f.addEventListener("input", rakna); rakna();
    })();
  </script>
  <p class="kalla">Ändra värdena efter din bil och ditt elavtal. Elpriset ska vara det totala priset per kWh: elhandel, nätavgift, energiskatt och moms.</p>

  <h2>Kostnad per mil vid olika elpriser</h2>
  <div class="tabell"><table>
    <thead><tr><th>Elpris per kWh</th><th class="num">Elbil ({E.toLocaleString("sv-SE")} kWh/mil)</th><th class="num">Mot bensin ({pris(perMilB)} kr/mil)</th><th class="num">Mot diesel ({pris(perMilD)} kr/mil)</th></tr></thead>
    <tbody>{elpriser.map((e) => (
      <tr><td>{pris(e)} kr</td><td class="num">{pris(e * E)}</td><td class="num">{e * E < perMilB ? `${pris(perMilB - e * E)} billigare` : `${pris(e * E - perMilB)} dyrare`}</td><td class="num">{e * E < perMilD ? `${pris(perMilD - e * E)} billigare` : `${pris(e * E - perMilD)} dyrare`}</td></tr>
    ))}</tbody>
  </table></div>
  <p class="kalla">Bensinbil {B.toLocaleString("sv-SE")} l/mil med 95 för {kr(p95)}, dieselbil {D.toLocaleString("sv-SE")} l/mil med diesel för {kr(pd)} (kedjornas snittpris {LP_DATUM}). Elbil {E.toLocaleString("sv-SE")} kWh/mil inklusive laddförluster. De högre elpriserna i tabellen motsvarar publik snabbladdning.</p>

  <Annons plats="elbil-1" />

  <h2>Per år: {MIL_AR.toLocaleString("sv-SE")} mil</h2>
  <div class="tabell"><table>
    <thead><tr><th>Bil</th><th class="num">Drivmedel per år</th></tr></thead>
    <tbody>
      <tr><td>Bensinbil, {B.toLocaleString("sv-SE")} l/mil</td><td class="num">{kr(perMilB * MIL_AR, 0)}</td></tr>
      <tr><td>Dieselbil, {D.toLocaleString("sv-SE")} l/mil</td><td class="num">{kr(perMilD * MIL_AR, 0)}</td></tr>
      {[1.5, 2, 3].map((e) => <tr><td>Elbil, el för {pris(e)} kr/kWh</td><td class="num">{kr(E * e * MIL_AR, 0)}</td></tr>)}
    </tbody>
  </table></div>

  <h2>Det här påverkar kalkylen</h2>
  <ul>
    <li><strong>Var du laddar.</strong> Hemma eller på jobbet blir det oftast billigast. Publik snabbladdning kostar ofta flera gånger mer per kWh.</li>
    <li><strong>Elavtalet.</strong> Med timpris blir det billigare att ladda på natten när elen oftast kostar minst.</li>
    <li><strong>Vintern.</strong> Elbilar drar mer i kyla, ofta 20–30 procent mer, när batteri och kupé ska värmas.</li>
    <li><strong>Mer än drivmedlet.</strong> Fordonsskatt, försäkring, service och värdeminskning skiljer sig också mellan bilarna och påverkar totalkostnaden mer än drivmedlet för många.</li>
  </ul>
  <p>Se även <a href="/guider/bensin-eller-diesel/">bensin eller diesel</a>, <a href="/guider/lonar-sig-e85/">lönar sig E85</a> och <a href="/rakna/">bränslekalkylatorn</a>.</p>

  <Faq fragor={fragor} />
</Layout>
