---
import Layout from "@natverk/core/Layout.astro";
import { SITE, UPPDATERAD } from "../../site.js";
const guider = [
  { href: "/guider/vad-bestar-bensinpriset-av/", namn: "Bensinskatt – vad består bensinpriset av?", text: "Priset uppdelat i produkt, energi- och koldioxidskatt och moms, skattesatserna 2026 och nästa skatteändring." },
  { href: "/guider/hvo100-e85-fordonsgas/", namn: "HVO100, E85 och fordonsgas", text: "Dagens priser, pris per kWh och per mil, och vilka bilar som kan tanka vad." },
  { href: "/guider/95-eller-98/", namn: "Bensin 95 eller 98?", text: "Oktantal, E10 och E5 och vad 98 kostar extra per tank och år." },
  { href: "/guider/reduktionsplikt/", namn: "Reduktionsplikten", text: "Nivåerna sedan 2018, vilka bränslen som omfattas och hur plikten påverkar priset." },
  { href: "/guider/vad-paverkar-bensinpriset/", namn: "Vad påverkar bensinpriset?", text: "Världsmarknaden, dollarkursen, skatterna och konkurrensen." },
  { href: "/guider/billigaste-bensinen/", namn: "Så hittar du billigaste bensinen", text: "Obemannade stationer, lågpriskedjor och dagens billigaste kedja." },
  { href: "/guider/bensin-eller-diesel/", namn: "Bensin eller diesel?", text: "Kostnad per mil och år med dagens priser." },
  { href: "/guider/elbil-eller-bensin/", namn: "Elbil eller bensin?", text: "Kostnad per mil och år, och vid vilket elpris elbilen blir billigare." },
  { href: "/guider/lonar-sig-e85/", namn: "Lönar sig E85?", text: "Brytpunkten mellan E85 och 95 med dagens priser." },
  { href: "/rakna/", namn: "Bränsleförbrukning och kostnad per mil", text: "Kalkylator för resan, per mil och per år, med körsträcka per län." },
  { href: "/europa/", namn: "Bensinpris i Europa", text: "Alla EU-länder i kronor, skatt per land och Sveriges placering sedan 2005." },
  { href: "/historik/", namn: "Bensinprisets historik", text: "Veckopriser sedan 2005, rekord och priset för 10 och 20 år sedan." },
];
---
<Layout site={SITE} titel="Guider om bensinpriset – skatter, diesel, E85 och spartips"
  beskrivning="Guider om bensin- och dieselpriset: bensinskatt, reduktionsplikt, 95 eller 98, HVO100 och E85, hur du hittar billigaste bensinen och om diesel lönar sig."
  smulor={[{ namn: "Bensinpris idag", href: "/" }, { namn: "Guider", href: "/guider/" }]} uppdaterad={UPPDATERAD}>
  <h1>Guider om bensinpriset</h1>
  <p class="svar">Alla guider räknar med dagens och veckans faktiska priser och uppdateras automatiskt.</p>
  <ul>{guider.map((g) => <li><a href={g.href}><strong>{g.namn}</strong></a> – {g.text}</li>)}</ul>
</Layout>
