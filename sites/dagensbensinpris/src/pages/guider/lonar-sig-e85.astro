---
// Guide: lönar sig E85? Brytpunkten räknad med dagens priser och olika merförbrukning.
import Layout from "@natverk/core/Layout.astro";
import Annons from "@natverk/core/Annons.astro";
import Faq from "@natverk/core/Faq.astro";
import { faqLd } from "@natverk/core/seo.js";
import { SITE, UPPDATERAD, LP_DATUM, idagPris, kr, pris, procent, datumText } from "../../site.js";

const p95 = idagPris("bensin95"), pe = idagPris("e85");
const datum = datumText(LP_DATUM);
const merforbrukning = [0.25, 0.3, 0.35];
const lonar = pe * 1.3 < p95;
const fragor = [
  { fraga: "Lönar det sig att tanka E85?", svar: `Med dagens priser (E85 ${kr(pe)}, 95 ${kr(p95)}) och 30 procents merförbrukning motsvarar E85 ${kr(pe * 1.3)} per liter bensin – ${lonar ? "alltså billigare" : "alltså dyrare"} än 95. E85 lönar sig när literpriset är under ungefär ${kr(p95 / 1.3)}.` },
  { fraga: "Hur mycket mer drar en bil på E85?", svar: "Ungefär 25–35 procent mer än på bensin, eftersom etanol innehåller mindre energi per liter. Vinterkvaliteten har lägre etanolhalt och ger något mindre merförbrukning." },
  { fraga: "Kan alla bilar köra på E85?", svar: "Nej. Bara flexifuelbilar (FFV) som är byggda för E85. I en vanlig bensinbil kan E85 skada motorn." },
];
---
<Layout site={SITE} titel={`Lönar sig E85? Räkna med dagens pris ${pris(pe)} kr (${datum})`}
  beskrivning={`E85 kostar ${kr(pe)}/l och 95 ${kr(p95)}/l idag. Med 30 % merförbrukning ${lonar ? "lönar sig E85" : "lönar sig inte E85"} just nu. Se brytpunkten och räkna på din bil.`}
  smulor={[{ namn: "Bensinpris idag", href: "/" }, { namn: "Guider", href: "/guider/" }, { namn: "Lönar sig E85?", href: "/guider/lonar-sig-e85/" }]} jsonld={[faqLd(fragor)]} uppdaterad={UPPDATERAD}>
  <h1>Lönar sig E85?</h1>
  <p class="svar">{lonar ? "Ja" : "Nej"}, inte med dagens priser om din bil drar 30 procent mer på E85: en liter E85 för <strong>{kr(pe)}</strong> motsvarar <strong>{kr(pe * 1.3)}</strong> per liter bensin, mot <strong>{kr(p95)}</strong> för 95. Brytpunkten är ungefär <strong>{kr(p95 / 1.3)}</strong> per liter E85.</p>

  <h2>Vad E85 motsvarar i bensinpris</h2>
  <div class="tabell"><table>
    <thead><tr><th>Merförbrukning på E85</th><th class="num">E85 motsvarar (kr/l bensin)</th><th class="num">Brytpunkt för E85</th><th>Billigast idag</th></tr></thead>
    <tbody>{merforbrukning.map((m) => <tr><td>{procent(m * 100)}</td><td class="num">{pris(pe * (1 + m))}</td><td class="num">{pris(p95 / (1 + m))}</td><td>{pe * (1 + m) < p95 ? "E85" : "Bensin 95"}</td></tr>)}</tbody>
  </table></div>
  <p class="kalla">Snittpriser från kedjornas listpriser {LP_DATUM}. Brytpunkt = det E85-pris där kostnaden per mil blir lika med 95.</p>

  <Annons plats="guide-1" />

  <h2>Så räknar du själv</h2>
  <p>Ta reda på hur mycket mer din bil drar på E85 genom att köra en tank på varje bränsle och jämföra. Multiplicera sedan E85-priset med 1 + merförbrukningen. Är resultatet lägre än priset på 95 lönar sig E85.</p>
  <p>Exempel: drar bilen 0,7 liter bensin per mil och 0,91 liter E85 per mil (30 procent mer) kostar en mil {kr(0.7 * p95)} på 95 och {kr(0.91 * pe)} på E85.</p>

  <h2>Annat att tänka på</h2>
  <ul>
    <li>E85 ger lägre koldioxidutsläpp från fossila källor, eftersom etanolen är förnybar.</li>
    <li>Kallstarter kan vara svårare på E85 vintertid; därför säljs en vinterkvalitet med lägre etanolhalt.</li>
    <li>Alla stationer säljer inte E85. Se <a href="/e85/">E85-pris idag</a> och var det finns.</li>
  </ul>

  <Faq fragor={fragor} />
  <p><a href="/guider/">Fler guider</a></p>
</Layout>
