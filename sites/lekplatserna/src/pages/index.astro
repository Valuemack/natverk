---
import Layout from "@natverk/core/Layout.astro";
import Annons from "@natverk/core/Annons.astro";
import Faq from "@natverk/core/Faq.astro";
import Sokverktyg from "@natverk/core/katalog/Sokverktyg.astro";
import { VERKTYG } from "../verktyg.js";
import { faqLd, websiteLd } from "@natverk/core/seo.js";
import { SITE, KAT, ORD, UPPDATERAD, KALLA, utrustning } from "../site.js";
import { URVAL } from "../urval.js";

const Plur = ORD.plur[0].toUpperCase() + ORD.plur.slice(1);
const n = KAT.enheter.length;
const tema = KAT.enheter.filter(URVAL.temalekplatser.filter).length;
const medRedskap = KAT.enheter.filter((e) => utrustning(e).length).length;
const urval = Object.entries(URVAL).map(([s, u]) => [s, u, KAT.enheter.filter(u.filter).length]).filter(([, , c]) => c >= 5);
const storst = [...KAT.kommuner].sort((a, b) => b.enheter.length - a.enheter.length).slice(0, 12);
const fragor = [
  { fraga: `Hur många ${ORD.plur} finns det i Sverige?`, svar: `Vi känner till ${n.toLocaleString("sv-SE")} ${ORD.plur} i ${KAT.kommuner.length} kommuner, från kommunernas öppna data och OpenStreetMap. Det verkliga antalet är troligen högre, eftersom alla lekplatser inte är registrerade.` },
  storst[0] && { fraga: `Vilken kommun har flest ${ORD.plur}?`, svar: `${storst[0].namn} har flest med ${storst[0].enheter.length} st, följt av ${storst.slice(1, 3).map((k) => `${k.namn} (${k.enheter.length})`).join(" och ")}.` },
].filter(Boolean);
---
<Layout site={SITE} titel="Lekplatser nära dig – temalekplatser och utrustning"
  beskrivning={`Hitta lekplatser nära dig – ${n.toLocaleString("sv-SE")} i hela Sverige. ✓ ${tema} temalekplatser ✓ Linbana, vattenlek och kompisgunga ✓ Närmaste lekplats.`}
  jsonld={[websiteLd(SITE), faqLd(fragor)]} uppdaterad={UPPDATERAD}>
  <h1>Hitta en lekplats nära dig</h1>
  <p class="svar">Här finns <strong>{n.toLocaleString("sv-SE")} {ORD.plur}</strong> i {KAT.kommuner.length} kommuner. För {medRedskap.toLocaleString("sv-SE")} av dem vet vi vilka redskap som finns, och <strong>{tema}</strong> är tema- eller naturlekplatser.</p>
  <Sokverktyg ord={ORD} kat={KAT} {...VERKTYG} />

  <h2>Hitta rätt sorts lekplats</h2>
  <div class="kort">{urval.map(([s, u, c]) => <a href={`/${s}/`}><strong>{u.namn}</strong><small>{c} st</small></a>)}</div>

  <h2>Flest {ORD.plur}</h2>
  <div class="kort">{storst.map((k) => <a href={k.href}><strong>{Plur} i {k.namn}</strong><small>{k.enheter.length} st</small></a>)}</div>

  <Annons plats="start-1" />

  <h2 id="lan">{Plur} per län och kommun</h2>
  {KAT.lan.map((l) => (
    <>
      <h3><a href={l.href}>{l.namn}</a> <small>({l.antal})</small></h3>
      <ul class="kolumner">{l.kommuner.map((k) => <li><a href={k.href}>{k.namn}</a> ({k.enheter.length})</li>)}</ul>
    </>
  ))}

  <Annons plats="start-2" />
  <Faq fragor={fragor} />
  <p class="kalla">{KALLA}</p>
</Layout>
