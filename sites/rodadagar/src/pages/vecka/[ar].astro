  <script is:inline slot="skript">
    (function () {
      var p = document.getElementById("kal-skriv");
      if (p) p.addEventListener("click", function () { window.print(); });
      var b = document.getElementById("kal-ics");
      if (!b) return;
      b.addEventListener("click", function () {
        var dagar = JSON.parse(b.dataset.dagar), ar = b.dataset.ar, nu = new Date().toISOString().replace(/[-:]/g, "").slice(0, 15) + "Z";
        var rader = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//rodadagar.nu//Roda dagar " + ar + "//SV", "CALSCALE:GREGORIAN", "X-WR-CALNAME:Röda dagar " + ar];
        dagar.forEach(function (d) {
          rader.push("BEGIN:VEVENT", "UID:" + d[0] + "-" + d[2].replace(/[^a-zA-Z0-9]/g, "") + "@rodadagar.nu", "DTSTAMP:" + nu,
            "DTSTART;VALUE=DATE:" + d[0], "DTEND;VALUE=DATE:" + d[1], "SUMMARY:" + d[2], "TRANSP:TRANSPARENT", "END:VEVENT");
        });
        rader.push("END:VCALENDAR");
        var url = URL.createObjectURL(new Blob([rader.join("\r\n")], { type: "text/calendar;charset=utf-8" }));
        var a = document.createElement("a"); a.href = url; a.download = "roda-dagar-" + ar + ".ics";
        document.body.appendChild(a); a.click(); a.remove(); setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      });
    })();
  </script>
