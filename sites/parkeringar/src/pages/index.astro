---
// Startsidan (navet): sökverktyg, svar med riksdata, storstädernas priser jämförda (gatutaxa från kommunerna + anläggningarnas
// timpriser), urval, guider, län och kommuner, metod och frågor. Ingen FAQ-schema (ägarens beslut).
import Layout from "@natverk/core/Layout.astro";
import Annons from "@natverk/core/Annons.astro";
import Faq from "@natverk/core/Faq.astro";
import Sokverktyg from "@natverk/core/katalog/Sokverktyg.astro";
import Metod from "../components/Metod.astro";
import { VERKTYG } from "../verktyg.js";
import { websiteLd } from "@natverk/core/seo.js";
import { talText } from "@natverk/core/katalog.js";
import { SITE, KAT, ORD, UPPDATERAD, MED_SIDA, KOMMUNTAXOR } from "../site.js";
import { GUIDEGRUPPER } from "../guider.js";
import { nyckeltal, krTim, timprisAv, tal } from "../fakta.js";

const s = nyckeltal(KAT.enheter);
const sidor = KAT.enheter.filter((e) => e.egenSida).length;
const storst = [...MED_SIDA].sort((a, b) => b.enheter.length - a.enheter.length).slice(0, 12);
const stader = MED_SIDA.filter((k) => k.taxa).map((k) => {
  const z = k.taxa.zoner.filter((x) => x.timpris).map((x) => x.timpris);
  return { k, min: Math.min(...z), max: Math.max(...z), n: nyckeltal(k.enheter) };
}).sort((a, b) => b.max - a.max);
const billigaStader = MED_SIDA.map((k) => ({ k, n: nyckeltal(k.enheter) })).filter((x) => x.n.medPris.length >= 10).sort((a, b) => a.n.medianTim - b.n.medianTim);
const fragor = [
  { fraga: "Hur många parkeringar finns det i Sverige?", svar: `Vi listar ${talText(s.n)} parkeringar i ${KAT.kommuner.length} kommuner, med minst ${talText(s.platser)} platser. Det är parkeringar som finns i OpenStreetMap, kommunernas öppna data eller hos de stora operatörerna – inte alla privata gårdar.` },
  stader[0] && { fraga: "Var är det dyrast att parkera på gatan?", svar: `Av städerna där vi har kontrollerat kommunens taxa har ${stader[0].k.namn} högst timpris på gatan, ${tal(stader[0].max)} kr i den dyraste zonen. ${stader.slice(1, 3).map((x) => `${x.k.namn} har som mest ${tal(x.max)} kr`).join(" och ")}.` },
  billigaStader[0] && { fraga: "Var är det billigast att parkera?", svar: `Bland kommunerna med minst tio prissatta parkeringar har ${billigaStader[0].k.namn} lägst mittenvärde, ${krTim(billigaStader[0].n.medianTim)}, följt av ${billigaStader.slice(1, 3).map((x) => `${x.k.namn} (${krTim(x.n.medianTim)})`).join(" och ")}.` },
  { fraga: "Hur hittar jag gratis parkering?", svar: `${talText(s.gratis.length)} parkeringar i vår lista är avgiftsfria. Se sidan Gratis parkering eller din kommuns sida. Många har tidsgräns och kräver p-skiva.` },
  { fraga: "Varför har inte alla parkeringar en egen sida?", svar: `En parkering får egen sida bara när vi har tillräckligt med uppgifter för att sidan ska vara till nytta: pris, storlek, öppettider eller laddplatser. Nu har ${talText(sidor)} parkeringar det. Övriga visas som rader på kommun- eller länssidan.` },
].filter(Boolean);
---
<Layout site={SITE} titel="Parkering i Sverige – pris, gratis parkering och p-hus"
  beskrivning={`Parkering i Sverige: ${talText(s.n)} parkeringar med timpris, gratis parkering, p-hus och laddplatser. ✓ Kommunernas gatutaxa ✓ Billigast nära dig ✓ Guider.`}
  jsonld={[websiteLd(SITE)]} uppdaterad={UPPDATERAD}>
  <h1>Parkering i Sverige – hitta pris och plats</h1>
  <p class="svar">Parkering i Sverige: vi listar <strong>{talText(s.n)} parkeringar</strong> i {KAT.kommuner.length} kommuner med minst {talText(s.platser)} platser. {talText(s.medPris.length)} har ett känt timpris med mittenvärdet <strong>{krTim(s.medianTim)}</strong>{s.medianDygn && <>, och ett dygn kostar i mitten {tal(s.medianDygn)} kr</>}. <strong>{talText(s.gratis.length)}</strong> är avgiftsfria och {talText(s.ladd.length)} har laddplatser för elbil.</p>
  <Sokverktyg ord={ORD} kat={KAT} {...VERKTYG} />

  {stader.length > 0 && <>
    <h2>Vad kostar parkering i storstäderna?</h2>
    <p>Gatuparkeringens taxa sätts av kommunen och skiljer sig mycket mellan städerna. Anläggningarnas timpris är mittenvärdet för parkeringshus och ytor i vår lista.</p>
    <div class="tabell"><table>
      <thead><tr><th>Stad</th><th class="num">Gatan, kr/tim</th><th class="num">Anläggningar, mittenvärde</th><th class="num">Gratis</th></tr></thead>
      <tbody>{stader.map((x) => <tr><td><a href={x.k.href}>{x.k.namn}</a></td><td class="num">{x.min === x.max ? tal(x.min) : `${tal(x.min)}–${tal(x.max)}`}</td><td class="num">{x.n.medianTim ? krTim(x.n.medianTim) : "–"}</td><td class="num">{x.n.gratis.length}</td></tr>)}</tbody>
    </table></div>
    <p class="kalla">Gatutaxa från respektive kommuns webbplats, kontrollerad {Object.values(KOMMUNTAXOR)[0]?.kallor?.[0]?.hamtad}. Källorna står på varje stads sida.</p>
  </>}

  {billigaStader.length > 3 && <>
    <h2>Billigast att parkera – kommuner med lägst mittenpris</h2>
    <div class="kort">{billigaStader.slice(0, 8).map((x) => <a href={x.k.href}><strong>Parkering i {x.k.namn}</strong><small>mitten {krTim(x.n.medianTim)} · {x.n.medPris.length} prissatta · {x.n.gratis.length} gratis</small></a>)}</div>
  </>}

  <h2>Hitta rätt sorts parkering</h2>
  <div class="kort">
    <a href="/gratis-parkering/"><strong>Gratis parkering</strong><small>{talText(s.gratis.length)} avgiftsfria, med tidsgränser</small></a>
    <a href="/parkeringshus/"><strong>Parkeringshus och garage</strong><small>{talText(s.hus.length)} st med pris och höjd</small></a>
    <a href="/pendlarparkering/"><strong>Pendlarparkering</strong><small>{talText(s.pendlar.length)} infartsparkeringar</small></a>
    <a href="/laddning/"><strong>Parkering med laddning</strong><small>{talText(s.laddPlatser)} laddplatser</small></a>
    <a href="/flygplatsparkering/"><strong>Flygplatsparkering</strong><small>Arlanda, Landvetter, Bromma med flera</small></a>
  </div>

  <Annons plats="start-1" />

  <h2>Guider om parkering</h2>
  {GUIDEGRUPPER.map((g) => <>
    <h3>{g.rubrik}</h3>
    <div class="kort">{g.guider.map((x) => <a href={`/guider/${x.slug}/`}><strong>{x.namn}</strong><small>{x.text}</small></a>)}</div>
  </>)}

  <h2>Flest parkeringar</h2>
  <div class="kort">{storst.map((k) => <a href={k.href}><strong>Parkering i {k.namn}</strong><small>{k.enheter.length} st</small></a>)}</div>

  <h2 id="lan">Parkering per län och kommun</h2>
  {KAT.lan.map((l) => (
    <>
      <h3><a href={l.href}>{l.namn}</a> <small>({l.antal})</small></h3>
      <ul class="kolumner">{l.kommuner.filter((k) => k.harSida).map((k) => <li><a href={k.href}>{k.namn}</a> ({k.enheter.length})</li>)}{l.kommuner.some((k) => !k.harSida) && <li><a href={`${l.href}#ovriga-kommuner`}>Övriga kommuner</a> ({l.kommuner.filter((k) => !k.harSida).length})</li>}</ul>
    </>
  ))}

  <Annons plats="start-2" />
  <Metod />
  <Faq fragor={fragor} />
</Layout>
