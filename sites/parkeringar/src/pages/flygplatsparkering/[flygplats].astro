---
// Parkering vid en flygplats: alla parkeringar nära terminalen (radie i flygplatser.js), med det vi vet om pris och platser.
import Layout from "@natverk/core/Layout.astro";
import Faq from "@natverk/core/Faq.astro";
import EnhetLista from "@natverk/core/katalog/EnhetLista.astro";
import { faqLd, besk, valjTitel } from "@natverk/core/seo.js";
import { SITE, UPPDATERAD, KALLA, krTim } from "../../site.js";
import { FLYG } from "../../flyg.js";

export const getStaticPaths = () => FLYG.map((f) => ({ params: { flygplats: f.slug }, props: { f } }));
const { f } = Astro.props;
const n = f.enheter.length;
const lang = f.enheter.filter((e) => /långtid/i.test(e.namn));
const kort = f.enheter.filter((e) => /korttid|express|hämta/i.test(e.namn));
const hus = f.enheter.filter((e) => e.extra?.parking === "multi-storey" || e.typ === "parkeringshus");
const medPris = f.enheter.filter((e) => e.extra?.taxa_per_timme > 0).sort((a, b) => a.extra.taxa_per_timme - b.extra.taxa_per_timme);
const platser = f.enheter.reduce((s, e) => s + (Number(e.extra?.kapacitet) || 0), 0);
const ladd = f.enheter.filter((e) => e.extra?.laddplatser);
const operator = f.swedavia ? "Swedavia" : "flygplatsen";
const andra = FLYG.filter((x) => x !== f);
const ordning = [...lang, ...kort.filter((e) => !lang.includes(e)), ...f.enheter.filter((e) => !lang.includes(e) && !kort.includes(e))];
const fragor = [
  { fraga: `Var parkerar man vid ${f.namn}?`, svar: `Vi listar ${n} parkeringar vid ${f.namn}${lang.length ? `, varav ${lang.length} långtidsparkering${lang.length > 1 ? "ar" : ""}` : ""}${hus.length ? ` och ${hus.length} parkeringshus` : ""}. Korttidsparkeringen ligger närmast terminalen. Långtidsparkeringar ligger oftast längre bort, ibland med bussförbindelse till terminalen.` },
  { fraga: `Vad kostar parkering vid ${f.namn}?`, svar: `Priserna på flygplatsens egna parkeringar sätts av ${operator} och varierar med säsong, hur långt i förväg du bokar och hur länge du står.${medPris.length ? ` I vår data har ${medPris.length} parkeringar ett känt timpris, från ${krTim(medPris[0].extra.taxa_per_timme)} (${medPris[0].namn}).` : ""} För resor över ett par dagar är långtidsparkering med förbokning nästan alltid billigast – kontrollera aktuellt pris på ${f.swedavia ? "swedavia.se" : "flygplatsens webbplats"}.` },
  { fraga: "Ska jag välja korttid eller långtid?", svar: "Korttidsparkering passar när du hämtar eller lämnar någon eller reser över dagen. Reser du längre än en dag blir långtidsparkering oftast billigare, särskilt om du förbokar." },
  ladd.length > 0 && { fraga: `Kan man ladda elbilen vid ${f.namn}?`, svar: `Ja, ${ladd.length} parkeringar i vår lista har laddplatser: ${ladd.slice(0, 3).map((e) => e.namn).join(", ")}.` },
].filter(Boolean);
---
<Layout site={SITE} titel={valjTitel(lang.length ? [`Parkering ${f.namn} – ${n} parkeringar, korttid och långtid`, `Parkering ${f.namn} – korttid och långtid`] : [`Parkering ${f.namn} – ${n} parkeringar nära terminalen`, `Parkering ${f.namn} – karta och priser`], `Parkering ${f.namn}`)}
  beskrivning={besk(`Alla ${n} parkeringar vid ${f.namn}${lang.length ? `, varav ${lang.length} långtid` : ""}, med karta och det vi vet om pris och platser.`, lang.length > 0 && "✓ Korttid och långtid", hus.length > 0 && "✓ Parkeringshus", ladd.length > 0 && "✓ Laddplatser")}
  smulor={[{ namn: "Start", href: "/" }, { namn: "Flygplatsparkering", href: "/flygplatsparkering/" }, { namn: f.namn, href: f.href }]} jsonld={[faqLd(fragor)]} uppdaterad={UPPDATERAD}>
  <h1>Parkering vid {f.namn}</h1>
  <p class="svar">Vid {f.namn} finns <strong>{n} parkeringar</strong> nära terminalen{lang.length > 0 && <>, varav <strong>{lang.length} långtidsparkering{lang.length > 1 ? "ar" : ""}</strong></>}{hus.length > 0 && <> och {hus.length} parkeringshus</>}{platser > 0 && <>. Kända platser: minst {platser.toLocaleString("sv-SE")}</>}. Reser du längre än en dag är långtid med förbokning oftast billigast.</p>
  <h2>Alla parkeringar vid {f.namn}</h2>
  <p>Långtidsparkeringar först, sedan korttid och övriga.</p>
  <EnhetLista enheter={ordning} />
  <h2>Tips inför resan</h2>
  <ul>
    <li><strong>Förboka</strong> långtidsparkeringen – priset på nätet är ofta lägre än att betala på plats.</li>
    <li><strong>Hämta och lämna:</strong> använd korttidsparkeringen eller flygplatsens avgiftsfria hämtzon om den finns, och kontrollera hur länge du får stå.</li>
    <li><strong>Elbil:</strong> boka plats med laddning i förväg om du behöver ladda.</li>
  </ul>
  {andra.length > 0 && <><h2>Parkering vid andra flygplatser</h2>
    <div class="kort">{andra.map((x) => <a href={x.href}><strong>Parkering {x.namn}</strong><small>{x.enheter.length} parkeringar</small></a>)}</div></>}
  <Faq fragor={fragor} />
  <p class="kalla">{KALLA} Flygplatsens egna parkeringar drivs av {operator}; några i listan drivs av andra. Priser och regler ändras – kontrollera hos {operator} innan du reser. Sajten är oberoende.</p>
</Layout>
