// Lång guide: tanka längs E6 från Trelleborg till Svinesund. Stationerna väljs ur sajtens eget register vid byggtid:
// alla stationer som ligger högst MAX_KM fågelvägen från vägens linje (haversine + avstånd punkt–linjesegment).
// Vägens linje är E6 enligt OpenStreetMap (vägar med ref "E 6", hämtade 2026-11-27 via Overpass API, kortaste väg längs
// E6-vägarna från Trelleborgs hamn till Svinesundsbron, förenklad med Douglas–Peucker 250 m). © OpenStreetMap-bidragsgivare, ODbL.
// Granskad 2026-11-27.
import Guide from "@natverk/core/Guide.astro";
import Annons from "@natverk/core/Annons.astro";
import { SITE, LP_DATUM, LISTKEDJOR, STATIONER, kedjePris, kedjaHref, kr, pris, datumText } from "../../pris.js";
import { KAT } from "../../site.js";

const PUBLICERAD = "2026-11-27";
const uppdaterad = [PUBLICERAD, LP_DATUM].sort().at(-1);
const datum = datumText(LP_DATUM);

// E6 söderut till norrut, [lat, lon]. Brytpunkter längs vägen ur OpenStreetMap (se kommentaren överst).
const LINJE = [
  [55.3727, 13.1488], [55.3799, 13.0896], [55.4032, 13.0642], [55.4204, 13.0614], [55.4672, 13.0087], [55.4906, 13.0211], [55.5425, 13.0048], [55.5473, 13.0119],
  [55.5534, 13.0672], [55.5752, 13.1058], [55.5909, 13.1165], [55.6249, 13.1115], [55.6523, 13.0984], [55.7028, 13.0977], [55.7221, 13.0903], [55.7332, 13.0753],
  [55.7545, 13.0008], [55.7759, 12.9728], [55.7998, 12.9613], [55.8357, 12.9255], [55.8623, 12.8828], [55.9047, 12.863], [55.9339, 12.8227], [55.9906, 12.7805],
  [56.0372, 12.7864], [56.0871, 12.7806], [56.1402, 12.8415], [56.1879, 12.8529], [56.2229, 12.8974], [56.2712, 12.8942], [56.3404, 12.9159], [56.3571, 12.9356],
  [56.3786, 12.9348], [56.4409, 12.9544], [56.4699, 12.9418], [56.5392, 12.9702], [56.5834, 12.9469], [56.6081, 12.92], [56.6392, 12.9039], [56.663, 12.9065],
  [56.721, 12.8849], [56.7501, 12.8575], [56.7674, 12.8154], [56.7925, 12.7866], [56.8145, 12.7174], [56.8433, 12.6986], [56.8646, 12.6589], [56.8838, 12.6084],
  [56.9181, 12.5502], [56.9463, 12.4781], [56.9823, 12.424], [57.0536, 12.3623], [57.1117, 12.3317], [57.1903, 12.2566], [57.2375, 12.2224], [57.3302, 12.2065],
  [57.3564, 12.2095], [57.398, 12.1877], [57.4306, 12.1569], [57.4455, 12.1078], [57.4786, 12.0443], [57.5035, 12.0528], [57.562, 12.0529], [57.5888, 12.0639],
  [57.622, 12.0368], [57.6977, 11.9957], [57.7114, 11.9971], [57.7264, 11.9812], [57.8008, 12.0077], [57.8438, 12.0048], [57.8761, 11.9626], [57.9173, 11.885],
  [57.9473, 11.8544], [57.9714, 11.8399], [58.0398, 11.8465], [58.0685, 11.8906], [58.112, 11.8793], [58.1617, 11.888], [58.182, 11.9075], [58.219, 11.9172],
  [58.2438, 11.9091], [58.2721, 11.8902], [58.2969, 11.8624], [58.3191, 11.8555], [58.3328, 11.8318], [58.3576, 11.8132], [58.404, 11.7402], [58.4418, 11.7019],
  [58.449, 11.6719], [58.4883, 11.6246], [58.4874, 11.5903], [58.4906, 11.5786], [58.541, 11.525], [58.5719, 11.458], [58.5814, 11.4512], [58.6157, 11.4545],
  [58.6368, 11.4364], [58.6517, 11.4329], [58.6663, 11.4135], [58.6875, 11.4075], [58.7052, 11.3825], [58.7114, 11.3577], [58.7267, 11.3452], [58.7364, 11.3067],
  [58.7575, 11.2803], [58.7752, 11.2731], [58.8066, 11.2831], [58.8353, 11.2759], [58.8477, 11.2832], [58.8889, 11.268], [58.9053, 11.2709], [58.9239, 11.2566],
  [58.9461, 11.2557], [58.9612, 11.2356], [58.9711, 11.2321], [59.0052, 11.2325], [59.0253, 11.2401], [59.0435, 11.2578], [59.0669, 11.2456], [59.0896, 11.252],
];
// Längden längs den fullständiga OSM-geometrin (före förenklingen), uppmätt 2026-11-27. Kilometertalen nedan skalas till den.
const LANGD_OSM = 477.6;
// Ett stationsläge räknas som "längs E6" om det ligger högst så här många km fågelvägen från vägens linje.
const MAX_KM = 2;
// Orter som delar vägen i sträckor (ungefärligt centrum). De projiceras på linjen; start och slut är linjens ändar.
const ORTER = [
  { namn: "Trelleborg", p: [55.3727, 13.1488] },
  { namn: "Malmö", p: [55.605, 13.0] },
  { namn: "Helsingborg", p: [56.046, 12.694] },
  { namn: "Halmstad", p: [56.674, 12.857] },
  { namn: "Falkenberg", p: [56.905, 12.491] },
  { namn: "Varberg", p: [57.106, 12.25] },
  { namn: "Kungsbacka", p: [57.487, 12.076] },
  { namn: "Göteborg", p: [57.708, 11.974] },
  { namn: "Uddevalla", p: [58.349, 11.938] },
  { namn: "Tanumshede", p: [58.723, 11.325] },
  { namn: "Svinesund", p: [59.0896, 11.252] },
];

// ---------- Geometri: haversine och avstånd från punkt till linjesegment ----------
const R = 6371.0088, rad = (d) => (d * Math.PI) / 180;
const hav = (a, b) => { const h = Math.sin(rad(b[0] - a[0]) / 2) ** 2 + Math.cos(rad(a[0])) * Math.cos(rad(b[0])) * Math.sin(rad(b[1] - a[1]) / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
const KM0 = [0]; for (let i = 1; i < LINJE.length; i++) KM0.push(KM0[i - 1] + hav(LINJE[i - 1], LINJE[i]));
const skala = LANGD_OSM / KM0.at(-1);
const KM = KM0.map((k) => k * skala);
const LANGD = LANGD_OSM;
/** Närmaste punkt på linjen: avstånd i km (d) och position längs vägen i km från start (km). */
function projicera(p) {
  let bast = { d: Infinity, km: 0 };
  for (let i = 1; i < LINJE.length; i++) {
    const a = LINJE[i - 1], b = LINJE[i], c = Math.cos(rad((a[0] + b[0]) / 2));
    const dx = (b[1] - a[1]) * c, dy = b[0] - a[0], L = dx * dx + dy * dy;
    const t = L ? Math.max(0, Math.min(1, (((p[1] - a[1]) * c) * dx + (p[0] - a[0]) * dy) / L)) : 0;
    const d = hav(p, [a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])]);
    if (d < bast.d) bast = { d, km: KM[i - 1] + t * (KM[i] - KM[i - 1]) };
  }
  return bast;
}

// ---------- Stationerna längs vägen ----------
const FLYTANDE = ["bensin95", "bensin98", "diesel", "hvo100", "e85"];
const baraGasEl = (s) => !FLYTANDE.some((k) => s.drivmedel?.[k] === true) && ["biogas", "lng", "lpg", "vatgas", "el"].some((k) => s.drivmedel?.[k] === true);
const EXTRA = new Map(KAT.enheter.map((e) => [e.href, e.extra ?? {}]));
const ALLA = STATIONER.filter((s) => s.lat != null && s.lon != null)
  .map((s) => ({ ...s, ...projicera([s.lat, s.lon]), maxLangd: Number(EXTRA.get(s.href)?.max_fordonslangd_m) || null }))
  .filter((s) => s.d <= MAX_KM).sort((a, b) => a.km - b.km);
/** Stationer med bensin eller diesel, eller där utbudet saknas i datan (inte rena gas-, el- eller vätgasstationer). */
const TANK = ALLA.filter((s) => !baraGasEl(s));
const EGENSKAP = {
  dygnet: (s) => s.dygnet && !baraGasEl(s),
  e85: (s) => s.drivmedel?.e85 === true,
  hvo100: (s) => s.drivmedel?.hvo100 === true,
  biogas: (s) => s.drivmedel?.biogas === true,
  el: (s) => s.drivmedel?.el === true || s.tjanster?.laddning === true,
  adblue: (s) => s.drivmedel?.adblue === true || s.tjanster?.adblue === true,
  truck: (s) => s.tjanster?.truckdiesel === true,
  butik: (s) => s.tjanster?.butik === true,
  toalett: (s) => s.tjanster?.toalett === true,
};
const ort = ORTER.map((o, i) => ({ ...o, km: i === 0 ? 0 : i === ORTER.length - 1 ? LANGD : projicera(o.p).km }));
const ETAPPER = ort.slice(1).map((o, i) => {
  const a = ort[i].km, b = o.km, sist = i === ort.length - 2;
  const st = ALLA.filter((s) => s.km >= a && (s.km < b || (sist && s.km <= b)));
  const tank = st.filter((s) => !baraGasEl(s));
  const n = Object.fromEntries(Object.entries(EGENSKAP).map(([k, f]) => [k, st.filter(f).length]));
  return { namn: `${ort[i].namn}–${o.namn}`, fran: ort[i].namn, till: o.namn, a, b, km: b - a, st, tank, n };
});
/** Avstånden mellan stationerna i listan, längs vägen, från start till slut. Störst först. */
function luckor(lista) {
  const pos = [{ km: 0, namn: `start (${ORTER[0].namn})` }, ...lista, { km: LANGD, namn: `slut (${ORTER.at(-1).namn})` }];
  return pos.slice(1).map((s, i) => ({ fran: pos[i], till: s, km: s.km - pos[i].km })).sort((x, y) => y.km - x.km);
}
const LUCKA = {
  alla: luckor(TANK), dygnet: luckor(ALLA.filter(EGENSKAP.dygnet)), hvo100: luckor(ALLA.filter(EGENSKAP.hvo100)),
  e85: luckor(ALLA.filter(EGENSKAP.e85)), biogas: luckor(ALLA.filter(EGENSKAP.biogas)), truck: luckor(ALLA.filter(EGENSKAP.truck)),
};
const ANTAL = Object.fromEntries(Object.entries(EGENSKAP).map(([k, f]) => [k, ALLA.filter(f).length]));
const kedjor = Object.entries(TANK.reduce((m, s) => ((m[s.kedja || "Utan kedja"] = (m[s.kedja || "Utan kedja"] ?? 0) + 1), m), {})).sort((a, b) => b[1] - a[1]);
const listkedjor = LISTKEDJOR.map((c) => ({ c, n: TANK.filter((s) => s.kedja === c).length, b95: kedjePris(c, "bensin95"), diesel: kedjePris(c, "diesel") }));
const sistaSverige = TANK.filter((s) => s.km >= LANGD - 30).reverse();
const forstaSoder = TANK.filter((s) => s.km <= 15);
const langaFordon = ALLA.filter((s) => s.maxLangd != null && s.maxLangd >= 24);

// Hur nära vägen: stationerna fördelade på avstånd och typ, och luckorna om man bara räknar stationer inom 500 m.
const ZONER = [[0, 0.5, "Högst 500 m"], [0.5, 1, "0,5–1 km"], [1, MAX_KM + 1e-9, `1–${MAX_KM} km`]].map(([a, b, t]) => {
  const z = TANK.filter((s) => s.d >= a && s.d < b);
  return { t, n: z.length, dygnet: z.filter((s) => s.dygnet).length, truck: z.filter((s) => s.tjanster?.truckdiesel === true).length };
});
const TYPER = [["obemannad", "Obemannad"], ["bemannad", "Bemannad"], ["truckstation", "Truckstation"], [null, "Uppgift saknas"]]
  .map(([k, t]) => ({ t, n: TANK.filter((s) => (s.typ ?? null) === k).length, dygnet: TANK.filter((s) => (s.typ ?? null) === k && s.dygnet).length }));
const NARA = TANK.filter((s) => s.d <= 0.5);
const luckaNara = luckor(NARA);
const luckaNaraDygnet = luckor(NARA.filter((s) => s.dygnet));

// Förslag på tankstopp: var STEG km väljs den station inom 500 m från vägen som går att tanka på dygnet runt och ligger närmast målpunkten (högst 25 km före eller efter).
const STEG = 150;
const STOPP = [];
for (let mal = STEG; mal < LANGD - 30; mal += STEG) {
  const kand = NARA.filter((s) => s.dygnet && Math.abs(s.km - mal) <= 25).sort((a, b) => Math.abs(a.km - mal) - Math.abs(b.km - mal));
  STOPP.push({ mal, s: kand[0] ?? null });
}

// ---------- Formatering ----------
const n0 = (x) => Math.round(x).toLocaleString("sv-SE");
const km1 = (x) => x.toLocaleString("sv-SE", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const ja = (v) => (v ? "ja" : "");
const utbud = (s) => [EGENSKAP.e85(s) && "E85", EGENSKAP.hvo100(s) && "HVO100", EGENSKAP.biogas(s) && "fordonsgas", EGENSKAP.el(s) && "laddning", EGENSKAP.adblue(s) && "AdBlue", EGENSKAP.truck(s) && "truckdiesel"].filter(Boolean).join(", ");
const per10mil = (n, km) => (km > 0 ? (n / (km / 100)).toLocaleString("sv-SE", { maximumFractionDigits: 1 }) : "–");
const glesast = [...ETAPPER].sort((a, b) => a.tank.length / a.km - b.tank.length / b.km)[0];
const tatast = [...ETAPPER].sort((a, b) => b.tank.length / b.km - a.tank.length / a.km)[0];
const literB = (LANGD / 10) * 0.6, literD = (LANGD / 10) * 0.5;
const billB = listkedjor.filter((x) => x.b95 != null).sort((a, b) => a.b95 - b.b95);
const billD = listkedjor.filter((x) => x.diesel != null).sort((a, b) => a.diesel - b.diesel);

const avsnitt = [
  { id: "snabbfakta", rubrik: "E6 i siffror" },
  { id: "strackor", rubrik: "Stationer per sträcka" },
  { id: "luckor", rubrik: "Längsta avstånden utan station" },
  { id: "nara", rubrik: "Hur nära vägen ligger stationerna?" },
  { id: "stopp", rubrik: "Förslag på tankstopp var 15:e mil" },
  { id: "alternativa", rubrik: "E85, HVO100, fordonsgas och laddning" },
  { id: "lastbil", rubrik: "Lastbil, husbil och släp" },
  { id: "pris", rubrik: "Vad kostar det att tanka längs E6?" },
  { id: "norge", rubrik: "Sista stationerna före Norge" },
  { id: "lista", rubrik: "Alla stationer längs E6" },
  { id: "metod", rubrik: "Så har vi räknat" },
];

const fragor = [
  { fraga: "Hur många bensinstationer finns längs E6?", svar: `I vårt register ligger ${n0(TANK.length)} stationer med bensin eller diesel högst ${MAX_KM} km fågelvägen från E6 mellan Trelleborg och Svinesund. Räknas rena gas- och laddstationer med blir det ${n0(ALLA.length)}.` },
  { fraga: "Var är det längst mellan bensinstationerna på E6?", svar: `Den längsta sträckan utan station inom ${MAX_KM} km från vägen är ${n0(LUCKA.alla[0].km)} km, mellan ${LUCKA.alla[0].fran.namn} och ${LUCKA.alla[0].till.namn}. Avståndet är mätt längs vägen.` },
  { fraga: "Kan man tanka dygnet runt längs E6?", svar: `Ja. ${n0(ANTAL.dygnet)} av stationerna längs E6 går enligt vår data att tanka på dygnet runt, oftast med kort i automat. Det längsta avståndet mellan två sådana stationer är ${n0(LUCKA.dygnet[0].km)} km (${LUCKA.dygnet[0].fran.namn} till ${LUCKA.dygnet[0].till.namn}).` },
  { fraga: "Finns det HVO100 längs E6?", svar: `Ja, ${n0(ANTAL.hvo100)} stationer längs E6 anger att de säljer HVO100. Längst mellan två av dem är det ${n0(LUCKA.hvo100[0].km)} km, mellan ${LUCKA.hvo100[0].fran.namn} och ${LUCKA.hvo100[0].till.namn}.` },
  { fraga: "Var tankar man fordonsgas längs E6?", svar: `${n0(ANTAL.biogas)} stationer längs E6 har fordonsgas enligt vår data. Gasen är glesare än andra drivmedel: den längsta luckan är ${n0(LUCKA.biogas[0].km)} km, mellan ${LUCKA.biogas[0].fran.namn} och ${LUCKA.biogas[0].till.namn}.` },
  { fraga: "Var är sista bensinstationen före Svinesund?", svar: sistaSverige.length ? `Den station i vårt register som ligger närmast Svinesundsbron längs E6 är ${sistaSverige[0].namn}, ungefär ${n0(LANGD - sistaSverige[0].km)} km före bron.` : "Vi har ingen station i registret inom 30 km före Svinesundsbron." },
];
---
<Guide site={SITE} titel={`Tanka längs E6 – ${n0(TANK.length)} stationer Trelleborg–Svinesund`}
  beskrivning={`${n0(TANK.length)} stationer inom ${MAX_KM} km från E6 mellan Trelleborg och Svinesund. Per sträcka: dygnet runt, E85, HVO100, fordonsgas, laddning, AdBlue och längsta luckorna.`}
  h1="Tanka längs E6 – stationer från Trelleborg till Svinesund"
  svar={`Längs E6 mellan Trelleborg och Svinesund, cirka ${n0(LANGD)} km, ligger <strong>${n0(TANK.length)} bensinstationer</strong> högst ${MAX_KM} km från vägen. ${n0(ANTAL.dygnet)} går att tanka på dygnet runt, ${n0(ANTAL.hvo100)} har HVO100 och ${n0(ANTAL.biogas)} fordonsgas. Längst utan station är det ${n0(LUCKA.alla[0].km)} km, mellan ${LUCKA.alla[0].fran.namn} och ${LUCKA.alla[0].till.namn}.`}
  smulor={[{ namn: "Start", href: "/" }, { namn: "Guider", href: "/guider/" }, { namn: "Tanka längs E6", href: "/guider/tanka-langs-e6/" }]}
  publicerad={PUBLICERAD} uppdaterad={uppdaterad} granskad="2026-11-27" avsnitt={avsnitt} fragor={fragor}
  relaterat={[
    { namn: "Tanka i Norge", href: "/guider/tanka-i-norge/", text: "Priser, betalning och tullregler" },
    { namn: "Tanka längs E20", href: "/guider/tanka-langs-e20/", text: "Malmö–Göteborg–Stockholm" },
    { namn: "Tanka längs E4", href: "/guider/tanka-langs-e4/", text: "Helsingborg–Haparanda" },
    { namn: "Truckdiesel och lastbil", href: "/guider/truckdiesel-lastbil/", text: "Stationer för tunga fordon" },
    { namn: "Dieselpris idag", href: "/dieselpris/", text: "Listpris per kedja" },
  ]}
  kallor={[
    { namn: "OpenStreetMap – E6 i Sverige", url: "https://www.openstreetmap.org/", text: "vägens sträckning (vägar märkta E 6), hämtad via Overpass API. © OpenStreetMap-bidragsgivare, ODbL", datum: "2026-11-27" },
    { namn: "Stationsregister: bensinstationer.nu", url: "/", text: "stationernas läge, drivmedel, tjänster och öppettider från kedjornas stationssök och OpenStreetMap" },
