  kallor={[
    { namn: "OpenStreetMap – E20 i Sverige", url: "https://www.openstreetmap.org/", text: "vägens sträckning (vägar märkta E 20), hämtad via Overpass API. © OpenStreetMap-bidragsgivare, ODbL", datum: "2026-11-27" },
    { namn: "Trafikverket – E20 mötesfri väg Västra Götaland", url: "https://www.trafikverket.se/e20vastragotaland", text: "ombyggnaden till mötesfri väg, färdiga och planerade etapper (sidan uppdaterad 5 mars 2025)", datum: "2026-11-27" },
    { namn: "Stationsregister: bensinstationer.nu", url: "/", text: "stationernas läge, drivmedel, tjänster och öppettider från kedjornas stationssök och OpenStreetMap" },
