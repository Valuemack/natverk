  [55.9346, 12.8217], [55.9915, 12.7801], [56.0372, 12.7861], [56.0871, 12.7804], [56.1402, 12.8413], [56.1879, 12.8527], [56.2229, 12.8972], [56.2712, 12.894],
  [56.3404, 12.9156], [56.3571, 12.9354], [56.3776, 12.9344], [56.4409, 12.9542], [56.47, 12.9416], [56.5137, 12.9638], [56.543, 12.9694], [56.5668, 12.9507],
  [56.5846, 12.9458], [56.6103, 12.9183], [56.6403, 12.9033], [56.6629, 12.9063], [56.7165, 12.8868], [56.744, 12.8652], [56.758, 12.8435], [56.7674, 12.8151],
  [56.7954, 12.7807], [56.8132, 12.7193], [56.8394, 12.7039], [56.8636, 12.6605], [56.8828, 12.6102], [56.9132, 12.5602], [56.9415, 12.4878], [56.9621, 12.4503],
  [56.9914, 12.4143], [57.0469, 12.3672], [57.1117, 12.3315], [57.1908, 12.2559], [57.2375, 12.2221], [57.3302, 12.2061], [57.3564, 12.2092], [57.398, 12.1875],
  [57.4304, 12.1569], [57.4455, 12.1076], [57.4786, 12.0441], [57.5035, 12.0526], [57.562, 12.0527], [57.5882, 12.0638], [57.6488, 12.0215], [57.6979, 11.9954],
  [57.7154, 11.9944], [57.7235, 12.0086], [57.7388, 12.11], [57.7441, 12.1577], [57.7404, 12.1752], [57.7427, 12.2168], [57.7526, 12.246], [57.7677, 12.2685],
  [57.8073, 12.3811], [57.8131, 12.4121], [57.8353, 12.439], [57.8469, 12.4681], [57.8728, 12.4925], [57.897, 12.4896], [57.9219, 12.5248], [57.9315, 12.567],
  [57.9477, 12.6077], [57.9506, 12.632], [57.963, 12.6531], [57.9735, 12.701], [58.0176, 12.7775], [58.0369, 12.7898], [58.0569, 12.8188], [58.0759, 12.8136],
  [58.0963, 12.8188], [58.1153, 12.844], [58.1504, 12.8674], [58.1663, 12.8861], [58.2076, 12.9007], [58.2446, 12.9457], [58.272, 13.0119], [58.2894, 13.0348],
  [58.2978, 13.077], [58.309, 13.0906], [58.3193, 13.1228], [58.3343, 13.1423], [58.3436, 13.1656], [58.3514, 13.3113], [58.3564, 13.3351], [58.3692, 13.3621],
