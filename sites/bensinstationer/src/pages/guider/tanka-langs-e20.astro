// Lång guide: tanka längs E20 från Öresundsbron via Göteborg och Örebro till Stockholm. Stationerna väljs ur sajtens eget
// register vid byggtid: alla stationer högst MAX_KM fågelvägen från vägens linje (haversine + avstånd punkt–linjesegment).
// Vägens linje är E20 enligt OpenStreetMap (vägar med ref "E 20", hämtade 2026-11-27 via Overpass API, kortaste väg längs
// E20-vägarna från Öresundsbrons svenska landfäste till Värtahamnen i Stockholm, förenklad med Douglas–Peucker 250 m).
// © OpenStreetMap-bidragsgivare, ODbL. Ombyggnaden i Västra Götaland: Trafikverkets projektsida (uppdaterad 2025-03-05).
// Granskad 2026-11-27.
import Guide from "@natverk/core/Guide.astro";
import Annons from "@natverk/core/Annons.astro";
import { SITE, LP_DATUM, LISTKEDJOR, STATIONER, kedjePris, kedjaHref, kr, pris, datumText } from "../../pris.js";
import { KAT } from "../../site.js";

const PUBLICERAD = "2026-11-27";
const uppdaterad = [PUBLICERAD, LP_DATUM].sort().at(-1);
const datum = datumText(LP_DATUM);

// E20 från söder till Stockholm, [lat, lon]. Brytpunkter längs vägen ur OpenStreetMap (se kommentaren överst).
const LINJE = [
