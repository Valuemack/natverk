  [58.9428, 14.4421], [58.9609, 14.53], [58.9731, 14.5452], [58.9798, 14.6163], [59.0058, 14.7112], [59.0216, 14.8028], [59.0317, 14.8299], [59.0383, 14.9131],
  [59.0723, 15.0147], [59.103, 15.0624], [59.1328, 15.0777], [59.1757, 15.1183], [59.2463, 15.1474], [59.2626, 15.1708], [59.2925, 15.1945], [59.2964, 15.2397],
  [59.3074, 15.2736], [59.3066, 15.3748], [59.3177, 15.467], [59.3338, 15.5303], [59.3725, 15.5904], [59.3789, 15.6464], [59.3986, 15.7132], [59.4043, 15.7526],
  [59.4223, 15.7881], [59.4262, 15.8742], [59.4235, 15.8882], [59.3973, 15.8909], [59.41, 16.0054], [59.41, 16.0326], [59.4187, 16.057], [59.4077, 16.0998],
  [59.4182, 16.1675], [59.4045, 16.2617], [59.4033, 16.3308], [59.4084, 16.3575], [59.4063, 16.4138], [59.3899, 16.4822], [59.3762, 16.6031], [59.3771, 16.6299],
  [59.3689, 16.6797], [59.3692, 16.7166], [59.3807, 16.7763], [59.3749, 16.805], [59.374, 16.8357], [59.3571, 16.9021], [59.3587, 16.917], [59.3678, 16.9365],
  [59.3681, 16.9526], [59.356, 17.0012], [59.3305, 17.0172], [59.2987, 17.0905], [59.2523, 17.1537], [59.2315, 17.1996], [59.2207, 17.2883], [59.202, 17.3658],
  [59.1973, 17.4218], [59.1878, 17.4751], [59.185, 17.536], [59.1874, 17.563], [59.1763, 17.6319], [59.1769, 17.6391], [59.1873, 17.6444], [59.201, 17.6663],
  [59.2108, 17.7218], [59.214, 17.7736], [59.2282, 17.7915], [59.2402, 17.8342], [59.2542, 17.8617], [59.2559, 17.8842], [59.2821, 17.9249], [59.289, 17.9553],
  [59.2893, 17.988], [59.3009, 18.0185], [59.3205, 17.9965], [59.3301, 18.0097], [59.3453, 18.0113], [59.3444, 18.0259], [59.3537, 18.0585], [59.351, 18.119],
];
// Längden längs den fullständiga OSM-geometrin (före förenklingen), uppmätt 2026-11-27. Kilometertalen nedan skalas till den.
const LANGD_OSM = 765.0;
// Ett stationsläge räknas som "längs E20" om det ligger högst så här många km fågelvägen från vägens linje.
const MAX_KM = 2;
// Orter som delar vägen i sträckor (ungefärligt centrum). De projiceras på linjen; start och slut är linjens ändar.
const ORTER = [
  { namn: "Malmö", p: [55.57, 12.9] },
  { namn: "Helsingborg", p: [56.046, 12.694] },
  { namn: "Halmstad", p: [56.674, 12.857] },
  { namn: "Göteborg", p: [57.708, 11.974] },
  { namn: "Alingsås", p: [57.93, 12.533] },
  { namn: "Skara", p: [58.386, 13.438] },
  { namn: "Mariestad", p: [58.709, 13.823] },
  { namn: "Örebro", p: [59.274, 15.207] },
  { namn: "Arboga", p: [59.394, 15.838] },
  { namn: "Eskilstuna", p: [59.371, 16.51] },
  { namn: "Södertälje", p: [59.196, 17.626] },
  { namn: "Stockholm", p: [59.351, 18.119] },
];
// E20 delar väg med E6 från Malmö till Göteborg (se guiden om E6). Här listas stationerna från Göteborg och norrut.
const DELAD_TILL = "Göteborg";

// ---------- Geometri: haversine och avstånd från punkt till linjesegment ----------
const R = 6371.0088, rad = (d) => (d * Math.PI) / 180;
const hav = (a, b) => { const h = Math.sin(rad(b[0] - a[0]) / 2) ** 2 + Math.cos(rad(a[0])) * Math.cos(rad(b[0])) * Math.sin(rad(b[1] - a[1]) / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
const KM0 = [0]; for (let i = 1; i < LINJE.length; i++) KM0.push(KM0[i - 1] + hav(LINJE[i - 1], LINJE[i]));
const skala = LANGD_OSM / KM0.at(-1);
const KM = KM0.map((k) => k * skala);
const LANGD = LANGD_OSM;
/** Närmaste punkt på linjen: avstånd i km (d) och position längs vägen i km från start (km). */
function projicera(p) {
  let bast = { d: Infinity, km: 0 };
  for (let i = 1; i < LINJE.length; i++) {
    const a = LINJE[i - 1], b = LINJE[i], c = Math.cos(rad((a[0] + b[0]) / 2));
    const dx = (b[1] - a[1]) * c, dy = b[0] - a[0], L = dx * dx + dy * dy;
    const t = L ? Math.max(0, Math.min(1, (((p[1] - a[1]) * c) * dx + (p[0] - a[0]) * dy) / L)) : 0;
    const d = hav(p, [a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])]);
    if (d < bast.d) bast = { d, km: KM[i - 1] + t * (KM[i] - KM[i - 1]) };
  }
  return bast;
}

// ---------- Stationerna längs vägen ----------
const FLYTANDE = ["bensin95", "bensin98", "diesel", "hvo100", "e85"];
const baraGasEl = (s) => !FLYTANDE.some((k) => s.drivmedel?.[k] === true) && ["biogas", "lng", "lpg", "vatgas", "el"].some((k) => s.drivmedel?.[k] === true);
const EXTRA = new Map(KAT.enheter.map((e) => [e.href, e.extra ?? {}]));
const ALLA = STATIONER.filter((s) => s.lat != null && s.lon != null)
  .map((s) => ({ ...s, ...projicera([s.lat, s.lon]), maxLangd: Number(EXTRA.get(s.href)?.max_fordonslangd_m) || null }))
  .filter((s) => s.d <= MAX_KM).sort((a, b) => a.km - b.km);
/** Stationer med bensin eller diesel, eller där utbudet saknas i datan (inte rena gas-, el- eller vätgasstationer). */
const TANK = ALLA.filter((s) => !baraGasEl(s));
const EGENSKAP = {
  dygnet: (s) => s.dygnet && !baraGasEl(s),
  e85: (s) => s.drivmedel?.e85 === true,
  hvo100: (s) => s.drivmedel?.hvo100 === true,
  biogas: (s) => s.drivmedel?.biogas === true,
  el: (s) => s.drivmedel?.el === true || s.tjanster?.laddning === true,
  adblue: (s) => s.drivmedel?.adblue === true || s.tjanster?.adblue === true,
  truck: (s) => s.tjanster?.truckdiesel === true,
  butik: (s) => s.tjanster?.butik === true,
  toalett: (s) => s.tjanster?.toalett === true,
};
const ort = ORTER.map((o, i) => ({ ...o, km: i === 0 ? 0 : i === ORTER.length - 1 ? LANGD : projicera(o.p).km }));
const ETAPPER = ort.slice(1).map((o, i) => {
  const a = ort[i].km, b = o.km, sist = i === ort.length - 2;
  const st = ALLA.filter((s) => s.km >= a && (s.km < b || (sist && s.km <= b)));
  const tank = st.filter((s) => !baraGasEl(s));
  const n = Object.fromEntries(Object.entries(EGENSKAP).map(([k, f]) => [k, st.filter(f).length]));
  return { namn: `${ort[i].namn}–${o.namn}`, fran: ort[i].namn, till: o.namn, a, b, km: b - a, st, tank, n };
});
/** Avstånden mellan stationerna i listan, längs vägen, från start till slut. Störst först. */
function luckor(lista) {
  const pos = [{ km: 0, namn: `start (${ORTER[0].namn})` }, ...lista, { km: LANGD, namn: `slut (${ORTER.at(-1).namn})` }];
  return pos.slice(1).map((s, i) => ({ fran: pos[i], till: s, km: s.km - pos[i].km })).sort((x, y) => y.km - x.km);
}
const LUCKA = {
  alla: luckor(TANK), dygnet: luckor(ALLA.filter(EGENSKAP.dygnet)), hvo100: luckor(ALLA.filter(EGENSKAP.hvo100)),
  e85: luckor(ALLA.filter(EGENSKAP.e85)), biogas: luckor(ALLA.filter(EGENSKAP.biogas)), truck: luckor(ALLA.filter(EGENSKAP.truck)),
};
const ANTAL = Object.fromEntries(Object.entries(EGENSKAP).map(([k, f]) => [k, ALLA.filter(f).length]));
const kedjor = Object.entries(TANK.reduce((m, s) => ((m[s.kedja || "Utan kedja"] = (m[s.kedja || "Utan kedja"] ?? 0) + 1), m), {})).sort((a, b) => b[1] - a[1]);
const listkedjor = LISTKEDJOR.map((c) => ({ c, n: TANK.filter((s) => s.kedja === c).length, b95: kedjePris(c, "bensin95"), diesel: kedjePris(c, "diesel") }));
const langaFordon = ALLA.filter((s) => s.maxLangd != null && s.maxLangd >= 24);

// Den egna delen: Göteborg–Stockholm.
const delKm = ort.find((o) => o.namn === DELAD_TILL).km;
const EGNA = ETAPPER.filter((e) => e.a >= delKm);
const egenTank = TANK.filter((s) => s.km >= delKm);
const egenLangd = LANGD - delKm;
const egenAntal = Object.fromEntries(Object.entries(EGENSKAP).map(([k, f]) => [k, ALLA.filter((s) => s.km >= delKm && f(s)).length]));
const egenLucka = Object.fromEntries(Object.entries(LUCKA).map(([k, v]) => [k, v.filter((l) => l.fran.km >= delKm)]));
const vg = ETAPPER.filter((e) => ["Göteborg–Alingsås", "Alingsås–Skara", "Skara–Mariestad"].includes(e.namn));
const vgKm = vg.reduce((s, e) => s + e.km, 0), vgN = vg.reduce((s, e) => s + e.tank.length, 0);

// Hur nära vägen: stationerna fördelade på avstånd och typ, och luckorna om man bara räknar stationer inom 500 m.
const ZONER = [[0, 0.5, "Högst 500 m"], [0.5, 1, "0,5–1 km"], [1, MAX_KM + 1e-9, `1–${MAX_KM} km`]].map(([a, b, t]) => {
  const z = TANK.filter((s) => s.d >= a && s.d < b);
  return { t, n: z.length, dygnet: z.filter((s) => s.dygnet).length, truck: z.filter((s) => s.tjanster?.truckdiesel === true).length };
});
const TYPER = [["obemannad", "Obemannad"], ["bemannad", "Bemannad"], ["truckstation", "Truckstation"], [null, "Uppgift saknas"]]
  .map(([k, t]) => ({ t, n: TANK.filter((s) => (s.typ ?? null) === k).length, dygnet: TANK.filter((s) => (s.typ ?? null) === k && s.dygnet).length }));
const NARA = TANK.filter((s) => s.d <= 0.5);
const luckaNara = luckor(NARA);
const luckaNaraDygnet = luckor(NARA.filter((s) => s.dygnet));

// Förslag på tankstopp: var STEG km väljs den station inom 500 m från vägen som går att tanka på dygnet runt och ligger närmast målpunkten (högst 25 km före eller efter).
const STEG = 150;
const STOPP = [];
for (let mal = STEG; mal < LANGD - 30; mal += STEG) {
  const kand = NARA.filter((s) => s.dygnet && Math.abs(s.km - mal) <= 25).sort((a, b) => Math.abs(a.km - mal) - Math.abs(b.km - mal));
  STOPP.push({ mal, s: kand[0] ?? null });
}

// ---------- Formatering ----------
const n0 = (x) => Math.round(x).toLocaleString("sv-SE");
const km1 = (x) => x.toLocaleString("sv-SE", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const ja = (v) => (v ? "ja" : "");
const utbud = (s) => [EGENSKAP.e85(s) && "E85", EGENSKAP.hvo100(s) && "HVO100", EGENSKAP.biogas(s) && "fordonsgas", EGENSKAP.el(s) && "laddning", EGENSKAP.adblue(s) && "AdBlue", EGENSKAP.truck(s) && "truckdiesel"].filter(Boolean).join(", ");
const per10mil = (n, km) => (km > 0 ? (n / (km / 100)).toLocaleString("sv-SE", { maximumFractionDigits: 1 }) : "–");
const glesast = [...EGNA].sort((a, b) => a.tank.length / a.km - b.tank.length / b.km)[0];
const tatast = [...EGNA].sort((a, b) => b.tank.length / b.km - a.tank.length / a.km)[0];
const literB = (LANGD / 10) * 0.6, literD = (LANGD / 10) * 0.5;
const billB = listkedjor.filter((x) => x.b95 != null).sort((a, b) => a.b95 - b.b95);
const billD = listkedjor.filter((x) => x.diesel != null).sort((a, b) => a.diesel - b.diesel);

const avsnitt = [
  { id: "snabbfakta", rubrik: "E20 i siffror" },
  { id: "strackor", rubrik: "Stationer per sträcka" },
  { id: "luckor", rubrik: "Längsta avstånden utan station" },
  { id: "vastra-gotaland", rubrik: "Göteborg–Mariestad: en väg under ombyggnad" },
  { id: "nara", rubrik: "Hur nära vägen ligger stationerna?" },
  { id: "stopp", rubrik: "Förslag på tankstopp var 15:e mil" },
  { id: "alternativa", rubrik: "E85, HVO100, fordonsgas och laddning" },
  { id: "lastbil", rubrik: "Lastbil, husbil och släp" },
  { id: "pris", rubrik: "Vad kostar det att tanka längs E20?" },
  { id: "lista", rubrik: "Stationer längs E20 från Göteborg till Stockholm" },
  { id: "metod", rubrik: "Så har vi räknat" },
];

const fragor = [
  { fraga: "Hur många bensinstationer finns längs E20?", svar: `I vårt register ligger ${n0(TANK.length)} stationer med bensin eller diesel högst ${MAX_KM} km fågelvägen från E20 mellan Öresundsbron och Stockholm. På den del som inte delas med E6, Göteborg–Stockholm, är de ${n0(egenTank.length)}.` },
  { fraga: "Var är det längst mellan bensinstationerna på E20?", svar: `Den längsta sträckan utan station inom ${MAX_KM} km från vägen är ${n0(LUCKA.alla[0].km)} km, mellan ${LUCKA.alla[0].fran.namn} och ${LUCKA.alla[0].till.namn}.` },
  { fraga: "Kan man tanka dygnet runt längs E20?", svar: `Ja, ${n0(ANTAL.dygnet)} stationer längs E20 går att tanka på dygnet runt enligt vår data. Längst mellan två sådana är det ${n0(LUCKA.dygnet[0].km)} km, mellan ${LUCKA.dygnet[0].fran.namn} och ${LUCKA.dygnet[0].till.namn}.` },
  { fraga: "Var finns fordonsgas längs E20?", svar: `${n0(ANTAL.biogas)} stationer längs E20 har fordonsgas enligt vår data. Den längsta luckan är ${n0(LUCKA.biogas[0].km)} km, mellan ${LUCKA.biogas[0].fran.namn} och ${LUCKA.biogas[0].till.namn}.` },
  { fraga: "Hur lång är E20 i Sverige?", svar: `Längs den linje vi har hämtat ur OpenStreetMap är E20 cirka ${n0(LANGD)} km från Öresundsbron till Värtahamnen i Stockholm. Ungefär ${n0(delKm)} km av dem, Malmö–Göteborg, delar E20 med E6.` },
  { fraga: "Finns det HVO100 mellan Göteborg och Stockholm?", svar: `Ja, ${n0(egenAntal.hvo100)} stationer längs E20 mellan Göteborg och Stockholm anger att de säljer HVO100.${egenLucka.hvo100[0] ? ` Den längsta luckan på den delen är ${n0(egenLucka.hvo100[0].km)} km.` : ""}` },
];
