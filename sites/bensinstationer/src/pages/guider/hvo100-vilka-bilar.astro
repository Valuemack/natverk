const fragor = [
  { fraga: "Kan jag tanka HVO100 i min dieselbil?", svar: "Bara om tillverkaren har godkänt bilen för HVO100, alltså för paraffinisk diesel enligt standarden EN 15940. Titta efter märkningen XTL i tanklocket eller i instruktionsboken. Hittar du den inte, fråga en märkesverkstad eller återförsäljaren." },
