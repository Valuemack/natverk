const lanHref = new Map(KATALOG.lan.map((l) => [l.namn, l.href]));
const perLan = Object.values(STATIONER.filter((s) => s.lan).reduce((m, s) => {
  const x = (m[s.lan] ??= { lan: s.lan, d: 0, h: 0 });
  if (harD(s)) x.d++;
  if (harH(s)) x.h++;
