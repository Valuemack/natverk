}, {})).sort((a, b) => b.h - a.h);
const kedjeTopp = Object.entries(STATIONER.filter(harH).reduce((m, s) => ((m[s.kedja ?? "Övriga"] = (m[s.kedja ?? "Övriga"] ?? 0) + 1), m), {})).sort((a, b) => b[1] - a[1]).slice(0, 5);

