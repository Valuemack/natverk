  alla: luckor(TANK), dygnet: luckor(ALLA.filter(EGENSKAP.dygnet)), hvo100: luckor(ALLA.filter(EGENSKAP.hvo100)),
  e85: luckor(ALLA.filter(EGENSKAP.e85)), biogas: luckor(ALLA.filter(EGENSKAP.biogas)), truck: luckor(ALLA.filter(EGENSKAP.truck)),
};
const ANTAL = Object.fromEntries(Object.entries(EGENSKAP).map(([k, f]) => [k, ALLA.filter(f).length]));
const kedjor = Object.entries(TANK.reduce((m, s) => ((m[s.kedja || "Utan kedja"] = (m[s.kedja || "Utan kedja"] ?? 0) + 1), m), {})).sort((a, b) => b[1] - a[1]);
const listkedjor = LISTKEDJOR.map((c) => ({ c, n: TANK.filter((s) => s.kedja === c).length, b95: kedjePris(c, "bensin95"), diesel: kedjePris(c, "diesel") }));
const langaFordon = ALLA.filter((s) => s.maxLangd != null && s.maxLangd >= 24);

// Söder och norr om Gävle: där motorvägen slutar enligt Trafikverket.
const gavleKm = ort.find((o) => o.namn === "Gävle").km;
const soder = TANK.filter((s) => s.km < gavleKm), norr = TANK.filter((s) => s.km >= gavleKm);
const luckorNorr = LUCKA.alla.filter((l) => l.fran.km >= gavleKm);
const luckorNorrDygnet = LUCKA.dygnet.filter((l) => l.fran.km >= gavleKm);
const elNorr = ALLA.filter((s) => s.km >= gavleKm && EGENSKAP.el(s)).length;
const over50 = LUCKA.dygnet.filter((l) => l.km >= 50);

// Finland: EU:s veckopriser, samma vecka för båda länderna.
const FI = LANDER.find((l) => l.kod === "FI");
const fiPris = FI ? landPris("FI") : null;
const sistaSverige = TANK.filter((s) => s.km >= LANGD - 40).reverse();

// Hur nära vägen: stationerna fördelade på avstånd och typ, och luckorna om man bara räknar stationer inom 500 m.
const ZONER = [[0, 0.5, "Högst 500 m"], [0.5, 1, "0,5–1 km"], [1, MAX_KM + 1e-9, `1–${MAX_KM} km`]].map(([a, b, t]) => {
  const z = TANK.filter((s) => s.d >= a && s.d < b);
  return { t, n: z.length, dygnet: z.filter((s) => s.dygnet).length, truck: z.filter((s) => s.tjanster?.truckdiesel === true).length };
});
const TYPER = [["obemannad", "Obemannad"], ["bemannad", "Bemannad"], ["truckstation", "Truckstation"], [null, "Uppgift saknas"]]
  .map(([k, t]) => ({ t, n: TANK.filter((s) => (s.typ ?? null) === k).length, dygnet: TANK.filter((s) => (s.typ ?? null) === k && s.dygnet).length }));
const NARA = TANK.filter((s) => s.d <= 0.5);
const luckaNara = luckor(NARA);
const luckaNaraDygnet = luckor(NARA.filter((s) => s.dygnet));

// Förslag på tankstopp: var STEG km väljs den station inom 500 m från vägen som går att tanka på dygnet runt och ligger närmast målpunkten (högst 25 km före eller efter).
const STEG = 150;
const STOPP = [];
for (let mal = STEG; mal < LANGD - 30; mal += STEG) {
  const kand = NARA.filter((s) => s.dygnet && Math.abs(s.km - mal) <= 25).sort((a, b) => Math.abs(a.km - mal) - Math.abs(b.km - mal));
  STOPP.push({ mal, s: kand[0] ?? null });
}

// ---------- Formatering ----------
const n0 = (x) => Math.round(x).toLocaleString("sv-SE");
const km1 = (x) => x.toLocaleString("sv-SE", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const ja = (v) => (v ? "ja" : "");
const utbud = (s) => [EGENSKAP.e85(s) && "E85", EGENSKAP.hvo100(s) && "HVO100", EGENSKAP.biogas(s) && "fordonsgas", EGENSKAP.el(s) && "laddning", EGENSKAP.adblue(s) && "AdBlue", EGENSKAP.truck(s) && "truckdiesel"].filter(Boolean).join(", ");
const per10mil = (n, km) => (km > 0 ? (n / (km / 100)).toLocaleString("sv-SE", { maximumFractionDigits: 1 }) : "–");
const glesast = [...ETAPPER].sort((a, b) => a.tank.length / a.km - b.tank.length / b.km)[0];
const tatast = [...ETAPPER].sort((a, b) => b.tank.length / b.km - a.tank.length / a.km)[0];
const literB = (LANGD / 10) * 0.6, literD = (LANGD / 10) * 0.5;
const billB = listkedjor.filter((x) => x.b95 != null).sort((a, b) => a.b95 - b.b95);
const billD = listkedjor.filter((x) => x.diesel != null).sort((a, b) => a.diesel - b.diesel);

const avsnitt = [
  { id: "snabbfakta", rubrik: "E4 i siffror" },
  { id: "strackor", rubrik: "Stationer per sträcka" },
  { id: "luckor", rubrik: "Längsta avstånden utan station" },
  { id: "norrland", rubrik: "Norr om Gävle: planera tankningen" },
  { id: "nara", rubrik: "Hur nära vägen ligger stationerna?" },
  { id: "stopp", rubrik: "Förslag på tankstopp var 15:e mil" },
  { id: "alternativa", rubrik: "E85, HVO100, fordonsgas och laddning" },
  { id: "lastbil", rubrik: "Lastbil, husbil och släp" },
  { id: "pris", rubrik: "Vad kostar det att tanka längs E4?" },
  { id: "finland", rubrik: "Sista stationerna före Finland" },
  { id: "lista", rubrik: "Alla stationer längs E4" },
  { id: "metod", rubrik: "Så har vi räknat" },
];

const fragor = [
  { fraga: "Hur många bensinstationer finns längs E4?", svar: `I vårt register ligger ${n0(TANK.length)} stationer med bensin eller diesel högst ${MAX_KM} km fågelvägen från E4 mellan Helsingborg och Haparanda. ${n0(soder.length)} av dem ligger söder om Gävle och ${n0(norr.length)} norr om Gävle.` },
  { fraga: "Var är det längst mellan bensinstationerna på E4?", svar: `Den längsta sträckan utan station inom ${MAX_KM} km från vägen är ${n0(LUCKA.alla[0].km)} km, mellan ${LUCKA.alla[0].fran.namn} och ${LUCKA.alla[0].till.namn}, mätt längs vägen.` },
  { fraga: "Kan man tanka dygnet runt längs hela E4?", svar: `${n0(ANTAL.dygnet)} stationer längs E4 går att tanka på dygnet runt enligt vår data. Längst mellan två sådana är det ${n0(LUCKA.dygnet[0].km)} km, mellan ${LUCKA.dygnet[0].fran.namn} och ${LUCKA.dygnet[0].till.namn}.` },
  { fraga: "Finns det HVO100 längs E4 i Norrland?", svar: `Ja. Längs hela E4 anger ${n0(ANTAL.hvo100)} stationer att de säljer HVO100. Den längsta luckan mellan två av dem är ${n0(LUCKA.hvo100[0].km)} km, mellan ${LUCKA.hvo100[0].fran.namn} och ${LUCKA.hvo100[0].till.namn}.` },
  { fraga: "Hur lång är E4 genom Sverige?", svar: `Längs den linje vi har hämtat ur OpenStreetMap är E4 cirka ${n0(LANGD)} km från färjeläget i Helsingborg till gränsen vid Haparanda. Enligt Trafikverket är vägen motorväg hela vägen från Helsingborg till Gävle sedan sommaren 2025.` },
  fiPris && { fraga: "Är det billigare att tanka i Sverige än i Finland?", svar: `Veckan som började ${datumText(fiPris.datum)} kostade bensin 95 i snitt ${kr(fiPris.b95)} per liter i Finland mot ${kr(SENASTE_VECKA.b95)} i Sverige, enligt EU-kommissionens Weekly Oil Bulletin omräknat till kronor.` },
].filter(Boolean);
---
<Guide site={SITE} titel={`Tanka längs E4 – ${n0(TANK.length)} stationer Helsingborg–Haparanda`}
  beskrivning={`${n0(TANK.length)} stationer inom ${MAX_KM} km från E4. Per sträcka: dygnet runt, E85, HVO100, fordonsgas, laddning och AdBlue – och längsta luckorna norr om Gävle.`}
  h1="Tanka längs E4 – stationer från Helsingborg till Haparanda"
  svar={`Längs E4 mellan Helsingborg och Haparanda, cirka ${n0(LANGD)} km, ligger <strong>${n0(TANK.length)} bensinstationer</strong> högst ${MAX_KM} km från vägen: ${n0(soder.length)} söder om Gävle och ${n0(norr.length)} norr om. ${n0(ANTAL.dygnet)} går att tanka på dygnet runt. Längst utan station är det ${n0(LUCKA.alla[0].km)} km, mellan ${LUCKA.alla[0].fran.namn} och ${LUCKA.alla[0].till.namn}.`}
  smulor={[{ namn: "Start", href: "/" }, { namn: "Guider", href: "/guider/" }, { namn: "Tanka längs E4", href: "/guider/tanka-langs-e4/" }]}
