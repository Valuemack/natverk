// ---------- Geometri: haversine och avstånd från punkt till linjesegment ----------
const R = 6371.0088, rad = (d) => (d * Math.PI) / 180;
const hav = (a, b) => { const h = Math.sin(rad(b[0] - a[0]) / 2) ** 2 + Math.cos(rad(a[0])) * Math.cos(rad(b[0])) * Math.sin(rad(b[1] - a[1]) / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
const KM0 = [0]; for (let i = 1; i < LINJE.length; i++) KM0.push(KM0[i - 1] + hav(LINJE[i - 1], LINJE[i]));
const skala = LANGD_OSM / KM0.at(-1);
const KM = KM0.map((k) => k * skala);
const LANGD = LANGD_OSM;
/** Närmaste punkt på linjen: avstånd i km (d) och position längs vägen i km från start (km). */
function projicera(p) {
  let bast = { d: Infinity, km: 0 };
  for (let i = 1; i < LINJE.length; i++) {
    const a = LINJE[i - 1], b = LINJE[i], c = Math.cos(rad((a[0] + b[0]) / 2));
    const dx = (b[1] - a[1]) * c, dy = b[0] - a[0], L = dx * dx + dy * dy;
    const t = L ? Math.max(0, Math.min(1, (((p[1] - a[1]) * c) * dx + (p[0] - a[0]) * dy) / L)) : 0;
    const d = hav(p, [a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])]);
    if (d < bast.d) bast = { d, km: KM[i - 1] + t * (KM[i] - KM[i - 1]) };
  }
  return bast;
}

// ---------- Stationerna längs vägen ----------
const FLYTANDE = ["bensin95", "bensin98", "diesel", "hvo100", "e85"];
const baraGasEl = (s) => !FLYTANDE.some((k) => s.drivmedel?.[k] === true) && ["biogas", "lng", "lpg", "vatgas", "el"].some((k) => s.drivmedel?.[k] === true);
const EXTRA = new Map(KAT.enheter.map((e) => [e.href, e.extra ?? {}]));
const ALLA = STATIONER.filter((s) => s.lat != null && s.lon != null)
  .map((s) => ({ ...s, ...projicera([s.lat, s.lon]), maxLangd: Number(EXTRA.get(s.href)?.max_fordonslangd_m) || null }))
  .filter((s) => s.d <= MAX_KM).sort((a, b) => a.km - b.km);
/** Stationer med bensin eller diesel, eller där utbudet saknas i datan (inte rena gas-, el- eller vätgasstationer). */
const TANK = ALLA.filter((s) => !baraGasEl(s));
const EGENSKAP = {
  dygnet: (s) => s.dygnet && !baraGasEl(s),
  e85: (s) => s.drivmedel?.e85 === true,
  hvo100: (s) => s.drivmedel?.hvo100 === true,
  biogas: (s) => s.drivmedel?.biogas === true,
  el: (s) => s.drivmedel?.el === true || s.tjanster?.laddning === true,
  adblue: (s) => s.drivmedel?.adblue === true || s.tjanster?.adblue === true,
  truck: (s) => s.tjanster?.truckdiesel === true,
  butik: (s) => s.tjanster?.butik === true,
  toalett: (s) => s.tjanster?.toalett === true,
};
const ort = ORTER.map((o, i) => ({ ...o, km: i === 0 ? 0 : i === ORTER.length - 1 ? LANGD : projicera(o.p).km }));
const ETAPPER = ort.slice(1).map((o, i) => {
  const a = ort[i].km, b = o.km, sist = i === ort.length - 2;
  const st = ALLA.filter((s) => s.km >= a && (s.km < b || (sist && s.km <= b)));
  const tank = st.filter((s) => !baraGasEl(s));
  const n = Object.fromEntries(Object.entries(EGENSKAP).map(([k, f]) => [k, st.filter(f).length]));
  return { namn: `${ort[i].namn}–${o.namn}`, fran: ort[i].namn, till: o.namn, a, b, km: b - a, st, tank, n };
});
/** Avstånden mellan stationerna i listan, längs vägen, från start till slut. Störst först. */
function luckor(lista) {
  const pos = [{ km: 0, namn: `start (${ORTER[0].namn})` }, ...lista, { km: LANGD, namn: `slut (${ORTER.at(-1).namn})` }];
  return pos.slice(1).map((s, i) => ({ fran: pos[i], till: s, km: s.km - pos[i].km })).sort((x, y) => y.km - x.km);
}
