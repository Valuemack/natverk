    { namn: "Trafikverket – Motorvägen är klar: E4 förbi Ljungby är invigd", url: "https://www.trafikverket.se/om-oss/nyheter/nationella-nyheter/2025/juni/motorvagen-ar-klar--e4-forbi-ljungby-ar-invigd/", text: "motorväg från Helsingborg till Gävle, nyhet 24 juni 2025", datum: "2026-11-27" },
