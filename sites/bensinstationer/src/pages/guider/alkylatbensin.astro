  h1="Alkylatbensin – vad är det och var finns den?"
  svar={`Alkylatbensin är en renare specialbensin för små motorer utan avgasrening, som motorsågar, gräsklippare, snöskotrar och utombordare. <strong>Den får innehålla högst 1 procent aromater och 0,08 procent bensen</strong>, mot 35 och 1 procent i bensin 95. Alkylat säljs i 2-taktsversion med olja och i 4-taktsversion utan. Bara ${stationer.length} stationer i vårt register säljer den vid pump, så de flesta köper den i dunk.`}
  smulor={[{ namn: "Start", href: "/" }, { namn: "Guider", href: "/guider/" }, { namn: "Alkylatbensin", href: "/guider/alkylatbensin/" }]}
  publicerad={PUBLICERAD} uppdaterad={uppdaterad} granskad="2026-11-27" avsnitt={avsnitt} fragor={fragor}
  relaterat={[
    { namn: "Bensindunk – regler", href: "/guider/bensindunk-regler/", text: "Så får du förvara och transportera bensin" },
    { namn: "Bensin 95 eller 98?", href: "/guider/95-eller-98/", text: "Oktantal och E10" },
    { namn: "Bensinpris idag", href: "/bensinpris/", text: "Pris per kedja" },
    { namn: "Feltankning", href: "/guider/feltankning/", text: "Om fel bränsle hamnar i tanken" },
    { namn: "Alla drivmedel", href: "/drivmedel/", text: "Priser och stationer per drivmedel" },
  ]}
  kallor={[
    { namn: "Drivkraft Sverige – Utdrag ur svensk standard för drivmedel 2026", url: "https://drivkraftsverige.se/wp-content/uploads/2026/03/Standarder_2026_v2.pdf", text: "SS-EN 17867:2023+A1:2025 (alkylatbensin), tabell 7–8 med vinterperioder, och SS-EN 228:2025 (bensin 95 E10)", datum: "2026-11-27" },
    { namn: "Transportstyrelsen – Miljöklassade bränslen", url: "https://www.transportstyrelsen.se/sv/vagtrafik/miljo/Luftkvaliet-i-tatorter/Miljoklassade-branslen/", text: "vilka motorer alkylat är avsett för, tvåtaktsmotorers oförbrända bränsle, gränser för aromater och bensen", datum: "2026-11-27" },
    { namn: "Regeringens proposition 1995/96:202", url: "https://lagen.nu/prop/1995/96:202", text: "alkylatbensinens bakgrund vid Arbetsmiljöinstitutet i Umeå, tillverkning och egenskaper", datum: "2026-11-27" },
    { namn: "Regeringen – Lagrådsremiss Alkylatbensin för vinterbruk (4 maj 2016)", url: "https://www.regeringen.se/contentassets/33462c09e4fb41c4a9d632112fbf7b0f/lagradsremiss-alkylatbensin-for-vinterbruk.pdf", text: "alkylatets historia, SS 155461, alkaner, problemen med kallstart av snöskotrar", datum: "2026-11-27" },
    { namn: "Drivmedelslag (2011:319), 5 §", url: "https://data.riksdagen.se/dokument/sfs-2011-319.text", text: "krav för alkylatbensin i miljöklass 1, ångtryck 50–95 kPa, högst 65 kPa sommartid, bensen högst 0,1 %", datum: "2026-11-27" },
    { namn: "Arbetsmiljöverket – AFS 2023:14 Gränsvärden för luftvägsexponering (konsoliderad)", url: "https://www.av.se/globalassets/filer/publikationer/foreskrifter/konsoliderade-foreskrifter/gransvarden-luftvagsexponering-arbetsmiljon-afs2023-14-konsoliderad.pdf", text: "nivå- och korttidsgränsvärde för bensen, ikraftträdande 5 april 2026", datum: "2026-11-27" },
    { namn: "OKQ8 – Företagspriser", url: "https://www.okq8.se/foretag/priser/", text: `listpris för alkylatbensin 2T och 4T, hämtat ${datum}` },
