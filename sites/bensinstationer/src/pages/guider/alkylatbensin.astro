// bensengränsvärdet i AFS 2023:14 (Arbetsmiljöverket). OKQ8:s listpris och stationerna med alkylat ur sajtens data. Granskad 2026-11-27.
import Guide from "@natverk/core/Guide.astro";
import Annons from "@natverk/core/Annons.astro";
import { SITE, LP, LP_DATUM, STATIONER, idagPris, kedjePris, kedjaHref, kr, pris, procent, datumText } from "../../pris.js";
import { KAT } from "../../site.js";

const PUBLICERAD = "2026-11-27";
const uppdaterad = [PUBLICERAD, LP_DATUM].sort().at(-1);
const datum = datumText(LP_DATUM);
const tal = (n) => n.toLocaleString("sv-SE");
const p95 = idagPris("bensin95");
const okq8 = LP.kedjor.find((c) => c.kedja === "OKQ8")?.priser ?? {};
const a2 = okq8.alkylat_2t ?? null, a4 = okq8.alkylat_4t ?? null;
const okq8Href = kedjaHref("OKQ8");
const dunk = 5;

const stationer = STATIONER.filter((s) => s.drivmedel?.alkylat === true).sort((a, b) => (a.lan ?? "").localeCompare(b.lan ?? "", "sv") || (a.ort ?? "").localeCompare(b.ort ?? "", "sv"));
const nAlla = STATIONER.length;
const lanHref = new Map(KAT.lan.map((l) => [l.namn, l.href]));
const lanMed = [...new Set(stationer.map((s) => s.lan).filter(Boolean))];
const lanUtan = KAT.lan.map((l) => l.namn).filter((n) => !lanMed.includes(n));
const perKedja = Object.entries(stationer.reduce((m, s) => ((m[s.kedja ?? "Övriga"] = (m[s.kedja ?? "Övriga"] ?? 0) + 1), m), {})).sort((a, b) => b[1] - a[1]);

const avsnitt = [
  { id: "vad", rubrik: "Vad är alkylatbensin?" },
  { id: "motorer", rubrik: "Vilka motorer ska ha alkylat?" },
  { id: "jamforelse", rubrik: "Alkylat jämfört med vanlig bensin" },
  { id: "halsa", rubrik: "Hälsa och arbetsmiljö" },
  { id: "vinter", rubrik: "Vinteralkylat" },
  { id: "var", rubrik: "Var säljs alkylatbensin?" },
  { id: "pris", rubrik: "Vad kostar alkylat?" },
];

const fragor = [
  { fraga: "Vad är alkylatbensin?", svar: "En specialbensin för små motorer som nästan saknar aromater, bensen och olefiner. Den svenska standarden SS-EN 17867 tillåter högst 1,0 procent aromater och 0,08 procent bensen, mot 35 respektive 1,0 procent i vanlig bensin 95." },
  { fraga: "Vilka motorer ska man använda alkylat i?", svar: "Enligt Transportstyrelsen är alkylat avsett för motorer utan avgasrening, till exempel utombordsmotorer, snöskotrar, gräsklippare och motorsågar, och det är särskilt viktigt i tvåtaktsmotorer. Alkylat ska inte användas i bilar." },
  { fraga: "Vad är skillnaden mellan alkylat 2-takt och 4-takt?", svar: "Tvåtaktsalkylat är färdigblandat med 1,5–2,0 procent tvåtaktsolja enligt standarden. Alkylat för fyrtaktsmotorer innehåller ingen olja. Tanka aldrig 4-taktsalkylat i en tvåtaktsmotor som saknar separat smörjning." },
  { fraga: "Var kan man tanka alkylatbensin?", svar: `Det är ovanligt vid pump. I vårt register anger ${stationer.length} av ${tal(nAlla)} stationer att de säljer alkylat, de flesta OKQ8-stationer. De flesta köper därför alkylat i dunk.` },
  a2 && { fraga: "Vad kostar alkylatbensin?", svar: `OKQ8:s listpris för alkylat är ${kr(a2.pris)} per liter för 2-takt och ${a4 ? kr(a4.pris) : "–"} för 4-takt (gäller från ${datumText(a2.galler_fran)}). Bensin 95 kostar ${p95 ? kr(p95) : "–"} per liter i snitt idag.` },
  { fraga: "Kan man tanka alkylatbensin i bilen?", svar: "Nej. Transportstyrelsen skriver att alkylat inte ska användas i bilar, och enligt regeringens lagrådsremiss från 2016 uppfyller alkylat inte specifikationen för bilbensin. Miljönyttan i en modern bilmotor med avgasrening är nästan obefintlig, och eventuella fordonsgarantier gäller inte." },
  { fraga: "Varför är bensen farligt?", svar: "Bensen är cancerframkallande och tas också upp genom huden. Arbetsmiljöverkets nivågränsvärde för bensen i luften är sedan den 5 april 2026 0,2 ppm, mot 0,5 ppm tidigare." },
].filter(Boolean);
