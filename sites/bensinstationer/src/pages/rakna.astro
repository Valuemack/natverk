---
// Lång guide + kalkylator: bränsleförbrukning och kostnad per mil, för en resa och per år, med dagens priser ifyllda.
// Körsträckor från Trafikanalys (Körsträckor 2025), energiinnehåll från Energimyndigheten. Tabellerna fungerar utan JavaScript.
// Granskad 2026-11-25.
import Guide from "@natverk/core/Guide.astro";
import Annons from "@natverk/core/Annons.astro";
import { SITE, LP_DATUM, idagPris, kr, pris, datumText } from "../pris.js";
import { KORSTRACKOR, VARMEVARDEN } from "../lib/fakta.js";

const PUBLICERAD = "2026-11-25";
const uppdaterad = [PUBLICERAD, LP_DATUM].sort().at(-1);
const datum = datumText(LP_DATUM);
const p95 = idagPris("bensin95"), pd = idagPris("diesel"), pe = idagPris("e85"), ph = idagPris("hvo100"), pg = idagPris("biogas");
const forbrukningar = [0.4, 0.5, 0.6, 0.7, 0.8, 1.0];
const strackor = [10, 50, 100, 250, 500];
const per100 = [4, 5, 6, 7, 8, 10];
const mil = KORSTRACKOR.snitt;
// Exempelbilar: samma energibehov per mil som en bensinbil på 0,6 l/mil, omräknat med Energimyndighetens värmevärden.
const kwhMil = 0.6 * VARMEVARDEN.bensin95;
const exempel = [
  { namn: "Bensin 95", enhet: "l", forb: 0.6, p: p95, mil: KORSTRACKOR.perDrivmedel.find((x) => x.namn === "Bensin").mil },
  { namn: "Diesel", enhet: "l", forb: 0.5, p: pd, mil: KORSTRACKOR.perDrivmedel.find((x) => x.namn === "Diesel").mil },
  pe && { namn: "E85", enhet: "l", forb: kwhMil / VARMEVARDEN.e85, p: pe, mil: KORSTRACKOR.perDrivmedel.find((x) => x.namn.startsWith("Etanol")).mil },
  pg && { namn: "Fordonsgas", enhet: "kg", forb: kwhMil / VARMEVARDEN.biogas, p: pg, mil: KORSTRACKOR.perDrivmedel.find((x) => x.namn === "Gas").mil },
].filter(Boolean);
const lan = [...KORSTRACKOR.perLan].sort((a, b) => b[1] - a[1]);
const fartTillagg = [0.05, 0.1]; // Transportstyrelsen: 0,5–1,0 dl per mil per 10 km/h över 70–75 km/h

const avsnitt = [
  { id: "kalkylator", rubrik: "Räkna ut bränslekostnaden" },
  { id: "per-mil", rubrik: "Kostnad per mil med dagens bensinpris" },
  { id: "omrakna", rubrik: "Liter per mil eller liter per 100 km?" },
  { id: "per-ar", rubrik: "Vad kostar bränslet per år?" },
  { id: "per-lan", rubrik: "Körsträcka och bränslekostnad per län" },
  { id: "resa", rubrik: "Vad kostar resan och en full tank?" },
  { id: "pendla", rubrik: "Vad kostar det att pendla med bil?" },
  { id: "forbrukning", rubrik: "Vad påverkar bränsleförbrukningen?" },
];

const fragor = [
  { fraga: "Hur räknar man ut bränslekostnaden per mil?", svar: `Multiplicera bilens förbrukning i liter per mil med literpriset. En bil som drar 0,6 liter per mil kostar med dagens pris för 95 (${kr(p95)}) ${kr(0.6 * p95)} per mil.` },
  { fraga: "Vad kostar det att köra 100 mil?", svar: `Med en förbrukning på 0,6 liter per mil går det åt 60 liter på 100 mil. Med bensin 95 för ${kr(p95)} blir det ${kr(60 * p95, 0)}, med diesel (${kr(pd)}) och en förbrukning på 0,5 liter per mil ${kr(50 * pd, 0)}.` },
  { fraga: "Vad kostar det att tanka fullt?", svar: `En tank på 50 liter bensin 95 kostar ${kr(50 * p95, 0)} med dagens snittpris. 60 liter diesel kostar ${kr(60 * pd, 0)}.` },
  { fraga: "Hur räknar man om liter per 100 km till liter per mil?", svar: "Dela med tio. En bil som drar 6 liter per 100 kilometer drar 0,6 liter per mil, eftersom en mil är tio kilometer." },
  { fraga: "Hur långt kör en vanlig bil per år?", svar: `En personbil i Sverige körde i genomsnitt ${KORSTRACKOR.snitt.toLocaleString("sv-SE")} mil under ${KORSTRACKOR.ar} enligt Trafikanalys. Bilar som ägs av privatpersoner körde ${KORSTRACKOR.privat.toLocaleString("sv-SE")} mil och bensinbilar ${exempel[0].mil} mil.` },
  { fraga: "Vad kostar bensinen per år?", svar: `Med ${mil.toLocaleString("sv-SE")} mil om året, 0,6 liter per mil och dagens pris för 95 blir det ungefär ${kr(mil * 0.6 * p95, 0)} per år, eller ${kr(mil * 0.6 * p95 / 12, 0)} i månaden.` },
  { fraga: "Vad kostar det att pendla 5 mil om dagen?", svar: `Med 5 mil tur och retur, 0,6 liter per mil och dagens pris för 95 blir det ${kr(5 * 0.6 * p95, 0)} per dag, eller ${kr(5 * 0.6 * p95 * 21, 0)} för en månad med 21 arbetsdagar.` },
  { fraga: "Hur mycket ökar förbrukningen med farten?", svar: "Enligt Transportstyrelsen ökar förbrukningen med 0,5–1,0 deciliter per mil för varje 10 km/h du kör över 70–75 km/h." },
];
---
<Guide site={SITE} titel="Bränsleförbrukning och kostnad per mil – kalkylator"
  beskrivning={`Räkna ut kostnad per mil, per resa och per år med dagens bensinpris (95: ${kr(p95)}/l). Omräkning från l/100 km, körsträcka per län och pendling.`}
  h1="Bränsleförbrukning och kostnad per mil"
  svar={`Med dagens pris för bensin 95 (${kr(p95)} per liter) kostar en bil som drar 0,6 liter per mil <strong>${kr(0.6 * p95)} per mil</strong>. Med en genomsnittlig körsträcka på ${mil.toLocaleString("sv-SE")} mil om året blir det ungefär <strong>${kr(mil * 0.6 * p95, 0)} per år</strong>. Fyll i din bils förbrukning och sträcka i kalkylatorn för att räkna på din egen bil.`}
  smulor={[{ namn: "Start", href: "/" }, { namn: "Bensinpris idag", href: "/bensinpris/" }, { namn: "Räkna", href: "/rakna/" }]}
  publicerad={PUBLICERAD} uppdaterad={uppdaterad} granskad="2026-11-25" avsnitt={avsnitt} fragor={fragor}
  relaterat={[
    { namn: "Bensin eller diesel?", href: "/guider/bensin-eller-diesel/", text: "Kostnad per mil och år med dagens priser" },
    { namn: "Elbil eller bensin?", href: "/guider/elbil-eller-bensin/", text: "Vid vilket elpris elbilen blir billigare" },
    { namn: "Lönar sig E85?", href: "/guider/lonar-sig-e85/", text: "Brytpunkten mot bensin 95" },
    { namn: "Så hittar du billigaste bensinen", href: "/guider/billigaste-bensinen/", text: "Kedjor och obemannade stationer" },
    { namn: "Bensinpris idag", href: "/bensinpris/", text: "Listpriser per kedja" },
  ]}
  kallor={[
    { namn: "Trafikanalys – Körsträckor 2025", url: KORSTRACKOR.kalla, text: "genomsnittlig körsträcka per personbil, per drivmedel och per län (Statistik 2026:10, publicerad 21 september 2026)", datum: "2026-11-25" },
    { namn: "Transportstyrelsen – Sparsam körning", url: "https://www.transportstyrelsen.se/sv/vagtrafik/miljo/klimat-och-energi/sparsam-korning/", text: "förbrukningen ökar 0,5–1,0 dl per mil per 10 km/h över 70–75 km/h", datum: "2026-11-25" },
    { namn: "Energimyndigheten – Värmevärden och densiteter", url: VARMEVARDEN.kalla, text: "energiinnehåll i bensin, E85 och biogas", datum: "2026-11-25" },
    { namn: "Kedjornas listpriser", text: `OKQ8, Circle K och Preem, hämtade ${datum}` },
  ]}>

  <h2 id="kalkylator">Räkna ut bränslekostnaden</h2>
  <p>Fyll i sträckan och bilens förbrukning. Dagens snittpris är ifyllt, men du kan skriva in priset på din station. Förbrukningen kan anges antingen i liter per mil eller i liter per 100 kilometer, så räknas den andra om automatiskt.</p>
  <form class="berakning" id="kalk" onsubmit="return false">
    <label>Sträcka (mil)<input name="mil" type="number" inputmode="decimal" min="0" step="0.1" value="10" /></label>
    <label>Förbrukning (liter per mil)<input name="forb" type="number" inputmode="decimal" min="0" step="0.01" value="0.6" /></label>
    <label>eller liter per 100 km<input name="forb100" type="number" inputmode="decimal" min="0" step="0.1" value="6" /></label>
    <label>Drivmedel
      <select name="typ">
        <option value={p95}>Bensin 95 ({pris(p95)} kr)</option>
        <option value={pd}>Diesel ({pris(pd)} kr)</option>
        {pe && <option value={pe}>E85 ({pris(pe)} kr)</option>}
        {ph && <option value={ph}>HVO100 ({pris(ph)} kr)</option>}
      </select>
    </label>
    <label>Literpris (kr)<input name="pris" type="number" inputmode="decimal" min="0" step="0.01" value={p95.toFixed(2)} /></label>
    <label>Antal som delar<input name="dela" type="number" inputmode="numeric" min="1" step="1" value="1" /></label>
    <label>Körsträcka per år (mil)<input name="ar" type="number" inputmode="numeric" min="0" step="10" value={mil} /></label>
    <output name="ut" aria-live="polite"></output>
    <output name="utar" aria-live="polite"></output>
  </form>
  <p class="kalla">Körsträckan per år är förifylld med genomsnittet för alla personbilar {KORSTRACKOR.ar} enligt Trafikanalys.</p>

  <h2 id="per-mil">Kostnad per mil med dagens bensinpris</h2>
  <div class="tabell"><table>
    <thead><tr><th>Förbrukning</th><th class="num">95 ({pris(p95)} kr)</th><th class="num">Diesel ({pris(pd)} kr)</th>{pe && <th class="num">E85 ({pris(pe)} kr)</th>}</tr></thead>
    <tbody>{forbrukningar.map((f) => <tr><td>{f.toLocaleString("sv-SE")} l/mil</td><td class="num">{pris(f * p95)}</td><td class="num">{pris(f * pd)}</td>{pe && <td class="num">{pris(f * pe)}</td>}</tr>)}</tbody>
  </table></div>
  <p class="kalla">Kronor per mil med kedjornas snittpris {LP_DATUM}. E85 kräver flexifuelbil och ger högre förbrukning, eftersom etanol innehåller mindre energi per liter.</p>

  <Annons plats="rakna-1" />

  <h2 id="omrakna">Liter per mil eller liter per 100 km?</h2>
  <p>I Sverige räknar de flesta förare i liter per mil, medan många tillverkare anger förbrukningen i liter per 100 kilometer. Eftersom en mil är tio kilometer är omräkningen enkel: dela liter per 100 km med tio. Tabellen visar vanliga värden och vad milen kostar med dagens pris för 95.</p>
  <div class="tabell"><table>
    <thead><tr><th class="num">Liter per 100 km</th><th class="num">Liter per mil</th><th class="num">Kr per mil (95)</th><th class="num">Mil per tank (50 l)</th></tr></thead>
    <tbody>{per100.map((l) => <tr><td class="num">{l.toLocaleString("sv-SE")}</td><td class="num">{(l / 10).toLocaleString("sv-SE")}</td><td class="num">{pris((l / 10) * p95)}</td><td class="num">{Math.round(50 / (l / 10))}</td></tr>)}</tbody>
  </table></div>
  <p>Den förbrukning som anges för en ny bil är uppmätt under standardiserade förhållanden. Din egen förbrukning får du fram säkrast genom att tanka fullt, nollställa trippmätaren och dela antalet tankade liter med antalet körda mil nästa gång du tankar fullt.</p>

  <h2 id="per-ar">Vad kostar bränslet per år?</h2>
  <p>Trafikanalys mäter hur långt svenska bilar faktiskt kör, utifrån mätarställningarna vid besiktningen. Under {KORSTRACKOR.ar} körde en personbil i genomsnitt {KORSTRACKOR.snitt.toLocaleString("sv-SE")} mil. Bilar som ägs av privatpersoner körde {KORSTRACKOR.privat.toLocaleString("sv-SE")} mil, medan företagsbilar körde längre. Körsträckan skiljer sig också mellan drivmedlen. Tabellen räknar fram årskostnaden med respektive drivmedels genomsnittliga körsträcka och dagens pris.</p>
  <div class="tabell"><table>
    <thead><tr><th>Drivmedel</th><th class="num">Mil per år</th><th class="num">Exempel på förbrukning</th><th class="num">Kr per mil</th><th class="num">Kr per år</th></tr></thead>
    <tbody>{exempel.map((x) => <tr><td>{x.namn}</td><td class="num">{x.mil.toLocaleString("sv-SE")}</td><td class="num">{x.forb.toLocaleString("sv-SE", { maximumFractionDigits: 2 })} {x.enhet}/mil</td><td class="num">{pris(x.forb * x.p)}</td><td class="num">{kr(x.forb * x.p * x.mil, 0)}</td></tr>)}</tbody>
  </table></div>
  <p class="kalla">Körsträcka: Trafikanalys, Körsträckor {KORSTRACKOR.ar}. Förbrukningen för E85 och fordonsgas är räknad så att bilen behöver lika mycket energi per mil som en bensinbil på 0,6 l/mil, med Energimyndighetens värmevärden ({VARMEVARDEN.bensin95.toLocaleString("sv-SE")} kWh per liter bensin, {VARMEVARDEN.e85.toLocaleString("sv-SE")} kWh per liter E85 och {VARMEVARDEN.biogas.toLocaleString("sv-SE")} kWh per kilo biogas).</p>
  <p>Dieselbilar kör i snitt längre än bensinbilar, och det är en av anledningarna till att diesel ofta väljs av den som kör mycket. Läs mer i <a href="/guider/bensin-eller-diesel/">bensin eller diesel</a>.</p>

  <h2 id="per-lan">Körsträcka och bränslekostnad per län</h2>
  <p>Hur långt man kör beror mycket på var man bor. Tabellen visar Trafikanalys genomsnittliga körsträcka för privatägda personbilar per registreringslän och vad det skulle kosta i bensin med 0,6 liter per mil och dagens pris för 95.</p>
  <div class="tabell"><table>
    <thead><tr><th>Län</th><th class="num">Mil per år</th><th class="num">Liter per år</th><th class="num">Kr per år (95)</th></tr></thead>
    <tbody>{lan.map(([n, m]) => <tr><td>{n}</td><td class="num">{m.toLocaleString("sv-SE")}</td><td class="num">{Math.round(m * 0.6).toLocaleString("sv-SE")}</td><td class="num">{kr(m * 0.6 * p95, 0)}</td></tr>)}</tbody>
  </table></div>
  <p class="kalla">Personbilar ägda av fysiska personer, efter län där bilen är registrerad. Trafikanalys, tabell RS1, {KORSTRACKOR.ar}.</p>
  <p>Skillnaden mellan länet med längst och kortast körsträcka är {(lan[0][1] - lan.at(-1)[1]).toLocaleString("sv-SE")} mil om året, vilket motsvarar {kr((lan[0][1] - lan.at(-1)[1]) * 0.6 * p95, 0)} i bensin med dagens pris.</p>

  <h2 id="resa">Vad kostar resan och en full tank?</h2>
  <h3>Resan (bensin 95, 0,6 l/mil)</h3>
  <div class="tabell"><table>
    <thead><tr><th>Sträcka</th><th class="num">Liter</th><th class="num">Kostnad</th></tr></thead>
    <tbody>{strackor.map((m) => <tr><td>{m} mil</td><td class="num">{(m * 0.6).toLocaleString("sv-SE")}</td><td class="num">{kr(m * 0.6 * p95, 0)}</td></tr>)}</tbody>
  </table></div>
  <p>Ska ni vara flera i bilen kan kalkylatorn dela kostnaden per person. Kom ihåg att räkna med hemresan om du delar på en tur och retur.</p>

  <h3 id="tanka">Tanka fullt</h3>
  <div class="tabell"><table>
    <thead><tr><th>Tankvolym</th><th class="num">Bensin 95</th><th class="num">Diesel</th></tr></thead>
    <tbody>{[40, 50, 60, 70].map((l) => <tr><td>{l} liter</td><td class="num">{kr(l * p95, 0)}</td><td class="num">{kr(l * pd, 0)}</td></tr>)}</tbody>
  </table></div>

  <h2 id="pendla">Vad kostar det att pendla med bil?</h2>
  <p>För den som pendlar är det enklast att räkna per arbetsdag och sedan per månad. Tabellen visar bränslekostnaden för vanliga avstånd tur och retur med 0,6 liter per mil och dagens pris för bensin 95. Månaden räknas här som 21 arbetsdagar.</p>
  <div class="tabell"><table>
    <thead><tr><th class="num">Mil tur och retur</th><th class="num">Per dag</th><th class="num">Per månad (21 dagar)</th><th class="num">Diesel, 0,5 l/mil, per månad</th></tr></thead>
    <tbody>{[2, 4, 6, 8, 10].map((m) => <tr><td class="num">{m}</td><td class="num">{kr(m * 0.6 * p95, 0)}</td><td class="num">{kr(m * 0.6 * p95 * 21, 0)}</td><td class="num">{kr(m * 0.5 * pd * 21, 0)}</td></tr>)}</tbody>
  </table></div>
  <p>Bränslet är bara en del av vad bilen kostar. Däck, service, försäkring och värdeminskning tillkommer, men de följer inte bensinpriset.</p>


  <h2 id="forbrukning">Vad påverkar bränsleförbrukningen?</h2>
  <p>Farten har störst betydelse. Enligt Transportstyrelsen ökar förbrukningen med 0,5–1,0 deciliter per mil för varje 10 km/h som du kör över 70–75 km/h. Kör du 110 i stället för 90 km/h kan det alltså betyda {fartTillagg.map((x) => (2 * x).toLocaleString("sv-SE")).join("–")} liter mer per mil. Med dagens bensinpris är det {fartTillagg.map((x) => pris(2 * x * p95)).join("–")} kronor extra per mil, eller {fartTillagg.map((x) => kr(2 * x * p95 * 100, 0).replace(" kr", "")).join("–")} kronor på 100 mil.</p>
  <h3>Andra saker som påverkar</h3>
  <ul>
    <li><strong>Last och luftmotstånd</strong> – takbox, cykelhållare och tung last ökar förbrukningen.</li>
    <li><strong>Däcktrycket</strong> – för lågt tryck ökar rullmotståndet.</li>
    <li><strong>Kyla och korta resor</strong> – en kall motor drar mer, så många korta turer vintertid ger högre snittförbrukning.</li>
    <li><strong>Körstilen</strong> – jämn fart och mjuka inbromsningar gör att mindre energi går förlorad.</li>
  </ul>

  <h3 id="sanka">Så sänker du bränslekostnaden</h3>
  <ul>
    <li>Kör jämnt och i rätt fart – förbrukningen ökar snabbt över 90 km/h.</li>
    <li>Håll rätt däcktryck. För lågt tryck ökar rullmotståndet.</li>
    <li>Ta bort takbox och tung last som inte behövs.</li>
    <li>Tanka på obemannade stationer eller hos lågpriskedjor. Se <a href="/guider/billigaste-bensinen/">så hittar du billigaste bensinen</a>.</li>
  </ul>
  <p>Funderar du på elbil? Se <a href="/guider/elbil-eller-bensin/">elbil eller bensin – vad kostar milen</a>.</p>
<script is:inline slot="skript">
  (() => {
    const f = document.getElementById("kalk");
    if (!f) return;
    const kr = (v, d = 2) => v.toLocaleString("sv-SE", { minimumFractionDigits: d, maximumFractionDigits: d }) + " kr";
    const tal = (n) => parseFloat(String(f[n].value).replace(",", ".")) || 0;
    const rakna = () => {
      const liter = tal("mil") * tal("forb"), total = liter * tal("pris"), dela = Math.max(1, tal("dela"));
      f.ut.value = `${liter.toLocaleString("sv-SE", { maximumFractionDigits: 1 })} liter · ${kr(total)} totalt · ${kr(tal("forb") * tal("pris"))} per mil` + (dela > 1 ? ` · ${kr(total / dela)} per person` : "");
      const ar = tal("ar") * tal("forb") * tal("pris");
      f.utar.value = ar > 0 ? `Per år: ${kr(ar, 0)} (${kr(ar / 12, 0)} i månaden)` : "";
    };
    f.typ.addEventListener("change", () => { f.pris.value = Number(f.typ.value).toFixed(2); rakna(); });
    f.forb.addEventListener("input", () => { f.forb100.value = +(tal("forb") * 10).toFixed(2); });
    f.forb100.addEventListener("input", () => { f.forb.value = +(tal("forb100") / 10).toFixed(3); });
    f.addEventListener("input", rakna); rakna();
  })();
</script>
</Guide>
