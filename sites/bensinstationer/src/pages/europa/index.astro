---
// Lång guide: bensinpriset i alla EU-länder senaste veckan, omräknat till kronor, med Sveriges placering sedan 2005,
// skatteandelar per land och grannländerna. All data: EU-kommissionens Weekly Oil Bulletin (data/eu.json). Granskad 2026-11-25.
import Guide from "@natverk/core/Guide.astro";
import Annons from "@natverk/core/Annons.astro";
import Kurva from "../../components/Kurva.astro";
import { SITE, LANDER, EU, landPris, landSerie, SENASTE_VECKA, VECKOR, kr, pris, procent, datumText } from "../../pris.js";
import { MOMS, summa, periodFor, nastaPeriod } from "../../lib/fakta.js";

const PUBLICERAD = "2026-11-25";
const v = SENASTE_VECKA;
const uppdaterad = [PUBLICERAD, v.datum].sort().at(-1);
const rader = [{ kod: "SE", namn: "Sverige", slug: null, b95: v.b95, diesel: v.diesel, b95utan: v.b95utan, dieselutan: v.dieselutan, valuta: "SEK", b95lokal: v.b95 }, ...LANDER.map((l) => ({ ...l, ...landPris(l.kod) }))].filter((x) => x.b95);
const efter95 = [...rader].sort((a, b) => a.b95 - b.b95);
const efterD = [...rader].filter((x) => x.diesel).sort((a, b) => a.diesel - b.diesel);
const max95 = efter95.at(-1).b95;
const plats = efter95.findIndex((x) => x.kod === "SE") + 1;
const platsD = efterD.findIndex((x) => x.kod === "SE") + 1;
const grannar = ["DK", "FI", "DE", "PL"].map((k) => rader.find((x) => x.kod === k)).filter(Boolean);
const snitt95 = rader.reduce((s, x) => s + x.b95, 0) / rader.length;
const tank = 50;
const se = rader.find((x) => x.kod === "SE");

// Skatt per land: andel av pumppriset som är skatt (pris med skatt minus pris utan skatt).
const skatt = rader.filter((x) => x.b95utan).map((x) => ({ ...x, skatt: x.b95 - x.b95utan, andel: 1 - x.b95utan / x.b95 })).sort((a, b) => b.andel - a.andel);
const produktMin = skatt.reduce((a, x) => (x.b95utan < a.b95utan ? x : a)), produktMax = skatt.reduce((a, x) => (x.b95utan > a.b95utan ? x : a));
const platsSkatt = skatt.findIndex((x) => x.kod === "SE") + 1;

// Sveriges placering per år: årsmedel av veckopriserna i kronor för alla länder med data.
const kurs = new Map(EU.lander.SE.serie.map((r) => [r[0], r[5]]));
const perAr = {};
for (const [kod, l] of Object.entries(EU.lander)) for (const r of l.serie) {
  if (!r[1] || !kurs.get(r[0])) continue;
  const y = r[0].slice(0, 4);
  ((perAr[y] ??= {})[kod] ??= []).push(r[1] / kurs.get(r[0]));
}
const placering = Object.keys(perAr).sort().map((y) => {
  const m = Object.entries(perAr[y]).map(([kod, a]) => ({ kod, p: a.reduce((s, x) => s + x, 0) / a.length })).sort((a, b) => a.p - b.p);
  const i = m.findIndex((x) => x.kod === "SE");
  return { ar: y, plats: i + 1, antal: m.length, se: m[i].p, billigast: m[0], dyrast: m.at(-1) };
});
const namn = (kod) => (kod === "SE" ? "Sverige" : EU.lander[kod]?.namn ?? kod);
const dyrastSe = placering.reduce((a, x) => (x.plats / x.antal > a.plats / a.antal ? x : a));

// Nästa svenska skatteändring: var hamnar Sverige om bara skatten ändras?
const per = periodFor(v.datum), nasta = nastaPeriod(v.datum);
const hojning = per && nasta ? (summa(nasta.bensin) - summa(per.bensin)) * (1 + MOMS) : null;
const nyPlats = hojning ? [...rader.filter((x) => x.kod !== "SE").map((x) => x.b95), v.b95 + hojning].sort((a, b) => a - b).indexOf(v.b95 + hojning) + 1 : null;

const skattAr = (y) => { const w = VECKOR.filter((x) => x.datum.startsWith(`${y}-`) && x.b95utan); return w.reduce((s, x) => s + (x.b95 - x.b95utan), 0) / w.length; };
const ettAr = VECKOR.at(-53)?.datum ?? VECKOR[0].datum;
const kurvLander = [["SE", "Sverige", "#d97706"], ["DK", "Danmark", "#b42318"], ["FI", "Finland", "#2563eb"], ["DE", "Tyskland", "#334155"], ["PL", "Polen", "#15803d"]];
const lokal = (x) => (x.valuta === "EUR" ? `${pris(x.b95lokal)} euro` : `${pris(x.b95lokal)} ${x.valuta}`);

const avsnitt = [
  { id: "bensin", rubrik: "Bensin 95 i EU-länderna" },
  { id: "diesel", rubrik: "Diesel i EU-länderna" },
  { id: "sverige", rubrik: "Är bensinen dyr i Sverige? Placeringen sedan 2005" },
  { id: "skatt", rubrik: "Varför skiljer sig priserna så mycket?" },
  { id: "grannar", rubrik: "Grannländerna: Danmark, Finland, Tyskland, Polen och Norge" },
  { id: "tanka", rubrik: "Lönar det sig att tanka utomlands?" },
  { id: "utveckling", rubrik: "Utvecklingen det senaste året" },
  { id: "metod", rubrik: "Så räknar vi" },
];

const fragor = [
  { fraga: "Var i Europa är bensinen billigast?", svar: `Senaste veckan var 95 billigast i ${efter95[0].namn} (${kr(efter95[0].b95)} per liter omräknat till kronor) och dyrast i ${efter95.at(-1).namn} (${kr(efter95.at(-1).b95)}).` },
  { fraga: "Är bensinen dyrare i Sverige än i resten av Europa?", svar: `Sverige har plats ${plats} av ${rader.length} räknat från billigast. Ett liter 95 kostade i snitt ${kr(v.b95)} i Sverige veckan som började ${datumText(v.datum)}, mot ${kr(snitt95)} i snitt för EU-länderna.` },
  { fraga: "Är det billigare att tanka i Danmark eller Tyskland?", svar: grannar.map((g) => `${g.namn}: ${kr(g.b95)}`).join(", ") + ` per liter 95, jämfört med ${kr(v.b95)} i Sverige.` },
  { fraga: "Vilket land har högst skatt på bensin?", svar: `Störst andel skatt hade ${skatt[0].namn}, där ${procent(skatt[0].andel * 100)} av priset var skatt senaste veckan. Lägst andel hade ${skatt.at(-1).namn} (${procent(skatt.at(-1).andel * 100)}). I Sverige var andelen ${procent((1 - v.b95utan / v.b95) * 100)}.` },
  { fraga: "Vad kostar bensin i Norge?", svar: "Norge är inte med i EU och ingår därför inte i EU-kommissionens veckostatistik, som är den källa vi använder. Vi visar därför inga norska priser." },
  { fraga: "Hur ofta uppdateras priserna?", svar: `En gång i veckan. Länderna rapporterar sina genomsnittliga pumppriser till EU-kommissionen, och vi hämtar den nya veckan så fort den publiceras. Senaste veckan i datan är den som började ${datumText(v.datum)}.` },
];
---
<Guide site={SITE} titel={`Bensinpris i Europa ${v.datum.slice(0, 4)} – alla EU-länder i kronor`}
  beskrivning={`Bensinpriset i alla EU-länder i kronor: billigast är ${efter95[0].namn} (${kr(efter95[0].b95)}/l), dyrast ${efter95.at(-1).namn}. Sverige har plats ${plats} av ${rader.length}. Skatt per land, uppdateras varje vecka.`}
  h1="Bensinpris i Europa"
  svar={`Veckan som började ${datumText(v.datum)} var bensin 95 billigast i <strong>${efter95[0].namn}</strong> (${kr(efter95[0].b95)} per liter) och dyrast i <strong>${efter95.at(-1).namn}</strong> (${kr(efter95.at(-1).b95)}). Sverige har plats <strong>${plats} av ${rader.length}</strong> med ${kr(v.b95)}, ${v.b95 < snitt95 ? `${kr(snitt95 - v.b95)} under` : `${kr(v.b95 - snitt95)} över`} EU-snittet. Skillnaderna beror främst på skatterna.`}
  smulor={[{ namn: "Start", href: "/" }, { namn: "Bensinpris idag", href: "/bensinpris/" }, { namn: "Europa", href: "/europa/" }]}
  publicerad={PUBLICERAD} uppdaterad={uppdaterad} granskad="2026-11-25" avsnitt={avsnitt} fragor={fragor}
  relaterat={[
    { namn: "Bensinskatt", href: "/guider/vad-bestar-bensinpriset-av/", text: "Så stor del av det svenska priset är skatt" },
    { namn: "Bensinprisets historik", href: "/historik/", text: "Svenska veckopriser sedan 2005" },
    { namn: "Bensinpris idag", href: "/bensinpris/", text: "Kedjornas listpriser i Sverige" },
    ...grannar.filter((g) => g.slug).slice(0, 2).map((g) => ({ namn: `Bensinpris i ${g.namn}`, href: `/europa/${g.slug}/`, text: "Pris, diesel och utveckling" })),
  ]}
  kallor={[
    { namn: "EU-kommissionen – Weekly Oil Bulletin", url: EU.kalla_url, text: "genomsnittliga pumppriser med och utan skatt per land och vecka sedan 2005, växelkurser (CC BY 4.0)", datum: "2026-11-25" },
    { namn: "Skatteverket – Skattesatser och vissa belopp", url: "https://www.skatteverket.se/foretag/skatterochavdrag/punktskatter/energiskatter/skattesatserochvissabelopp.4.15532c7b1442f256bae5e56.html", text: "svenska skattesatser för bensin och diesel", datum: "2026-11-25" },
  ]}>

  <h2 id="bensin">Bensin 95 i EU-länderna</h2>
  <p>Tabellen visar genomsnittspriset för en liter bensin 95 i varje EU-land veckan som började {datumText(v.datum)}, omräknat till kronor med samma veckas växelkurs. Kolumnen längst till höger visar skillnaden mot Sverige. Klicka på ett land för priset i landets egen valuta och utvecklingen över tid.</p>
  <div class="tabell"><table>
    <thead><tr><th>#</th><th>Land</th><th class="num">Kr per liter</th><th style="width:35%"></th><th class="num">Mot Sverige</th></tr></thead>
    <tbody>{efter95.map((x, i) => (
      <tr><td>{i + 1}</td><td>{x.slug ? <a href={`/europa/${x.slug}/`}>{x.namn}</a> : <strong>{x.namn}</strong>}</td><td class="num">{pris(x.b95)}</td><td><span class:list={["stapel", { "stapel-se": x.kod === "SE" }]} style={`width:${(x.b95 / max95 * 100).toFixed(1)}%`}></span></td><td class="num">{x.kod === "SE" ? "" : `${x.b95 >= v.b95 ? "+" : "−"}${pris(Math.abs(x.b95 - v.b95))}`}</td></tr>
    ))}</tbody>
  </table></div>
  <p class="kalla">Genomsnittligt pumppris inkl. skatt veckan som började {datumText(v.datum)}, omräknat till kronor med samma veckas växelkurs. Källa: EU-kommissionen, Weekly Oil Bulletin (CC BY 4.0). Norge ingår inte i EU:s statistik.</p>
  <p>Skillnaden mellan billigaste och dyraste land är {kr(efter95.at(-1).b95 - efter95[0].b95)} per liter, eller {kr((efter95.at(-1).b95 - efter95[0].b95) * tank, 0)} för en tank på {tank} liter.</p>

  <Annons plats="europa-1" />

  <h2 id="diesel">Diesel i EU-länderna</h2>
  <p>För diesel har Sverige plats {platsD} av {efterD.length} räknat från billigast. Ordningen skiljer sig från bensinen, eftersom länderna beskattar diesel och bensin olika och eftersom dieselns produktpris följer en egen världsmarknad.</p>
  <div class="tabell"><table>
    <thead><tr><th>#</th><th>Land</th><th class="num">Kr per liter</th><th class="num">Mot Sverige</th></tr></thead>
    <tbody>{efterD.map((x, i) => <tr><td>{i + 1}</td><td>{x.slug ? <a href={`/europa/${x.slug}/`}>{x.namn}</a> : <strong>{x.namn}</strong>}</td><td class="num">{pris(x.diesel)}</td><td class="num">{x.kod === "SE" ? "" : `${x.diesel >= v.diesel ? "+" : "−"}${pris(Math.abs(x.diesel - v.diesel))}`}</td></tr>)}</tbody>
  </table></div>

  <h2 id="sverige">Är bensinen dyr i Sverige? Placeringen sedan 2005</h2>
  <p>Sverige har länge haft ett av de högre bensinpriserna i EU. Tabellen räknar fram årsgenomsnittet för varje land och visar var Sverige hamnade, räknat från det billigaste landet. Ju högre platsnummer, desto dyrare var bensinen jämfört med resten av EU.</p>
  <div class="tabell"><table>
    <thead><tr><th>År</th><th class="num">Sverige, kr/l</th><th class="num">Plats</th><th>Billigast</th><th>Dyrast</th></tr></thead>
    <tbody>{[...placering].reverse().map((x) => (
      <tr><td>{x.ar}</td><td class="num">{pris(x.se)}</td><td class="num">{x.plats} av {x.antal}</td><td>{namn(x.billigast.kod)} ({pris(x.billigast.p)})</td><td>{namn(x.dyrast.kod)} ({pris(x.dyrast.p)})</td></tr>
    ))}</tbody>
  </table></div>
  <p class="kalla">Bensin 95, årsmedel av veckopriserna i kronor. Antalet länder ökar när nya medlemsländer börjar rapportera.</p>
  <p>Som dyrast i jämförelse var Sverige {dyrastSe.ar}, med plats {dyrastSe.plats} av {dyrastSe.antal}. De senaste åren har Sverige rört sig mot den billigare delen av listan. Det sammanfaller med att skatterna inklusive moms på en liter 95 i Sverige har sjunkit, från {kr(skattAr(2023))} i snitt 2023 till {kr(skattAr(2025))} 2025 och ännu lägre under de tillfälliga sänkningarna {v.datum.slice(0, 4)}. Läs mer under <a href="/guider/vad-bestar-bensinpriset-av/">bensinskatt</a>.</p>

  <h2 id="skatt">Varför skiljer sig priserna så mycket?</h2>
  <p>Produktpriset utan skatt är ganska likt i hela EU, eftersom bensin och diesel handlas på samma världsmarknad. Skillnaden vid pumpen beror främst på skatterna: energiskatt, koldioxidskatt och moms bestäms av varje land. I Sverige var produktpriset för 95 {kr(v.b95utan)} per liter senaste veckan; resten, {procent((1 - v.b95utan / v.b95) * 100)} av priset, var skatt.</p>
  <p>Senaste veckan låg produktpriset mellan {kr(produktMin.b95utan)} ({produktMin.namn}) och {kr(produktMax.b95utan)} ({produktMax.namn}) per liter. Skatterna inklusive moms varierade mer, från {kr(Math.min(...skatt.map((x) => x.skatt)))} till {kr(Math.max(...skatt.map((x) => x.skatt)))} per liter. Sverige har plats {platsSkatt} av {skatt.length} räknat från den största skatteandelen.</p>
  <div class="tabell"><table>
    <thead><tr><th>Land</th><th class="num">Utan skatt</th><th class="num">Skatt</th><th class="num">Skattens andel</th></tr></thead>
    <tbody>{skatt.map((x) => <tr><td>{x.kod === "SE" ? <strong>Sverige</strong> : x.namn}</td><td class="num">{pris(x.b95utan)}</td><td class="num">{pris(x.skatt)}</td><td class="num">{procent(x.andel * 100)}</td></tr>)}</tbody>
  </table></div>
  <p class="kalla">Bensin 95, kronor per liter. Skatt = pumppris minus pris utan skatt (punktskatter och moms).</p>
  <p>Även produktpriset varierar en del. Priset utan skatt i statistiken innehåller nämligen inte bara själva bensinen utan också frakt, lagring och bolagens marginal i respektive land.</p>

  <h2 id="grannar">Grannländerna: Danmark, Finland, Tyskland, Polen och Norge</h2>
  <p>De flesta som funderar på att tanka utomlands gör det i ett grannland eller på väg söderut. Så här såg priset på 95 ut senaste veckan, i landets egen valuta och omräknat till kronor:</p>
  <div class="tabell"><table>
    <thead><tr><th>Land</th><th class="num">Egen valuta</th><th class="num">Kr per liter</th><th class="num">Per tank ({tank} l) mot Sverige</th></tr></thead>
    <tbody>{grannar.map((g) => <tr><td>{g.slug ? <a href={`/europa/${g.slug}/`}>{g.namn}</a> : g.namn}</td><td class="num">{lokal(g)}</td><td class="num">{pris(g.b95)}</td><td class="num">{g.b95 >= v.b95 ? "+" : "−"}{kr(Math.abs(g.b95 - v.b95) * tank, 0)}</td></tr>)}</tbody>
  </table></div>
  <p><strong>Norge</strong> är inte med i EU och rapporterar inte till EU-kommissionens veckostatistik. Därför har vi inga norska priser som går att jämföra på samma sätt. Den som ska tanka i Norge får jämföra med priset vid pumpen.</p>

  <h2 id="tanka">Lönar det sig att tanka utomlands?</h2>
  <p>Med veckans priser är {grannar.filter((g) => g.b95 < v.b95).length === 0 ? "inget av grannländerna billigare än Sverige för bensin 95" : `${grannar.filter((g) => g.b95 < v.b95).map((g) => g.namn).join(" och ")} billigare än Sverige för bensin 95`}. Några saker att tänka på innan du planerar en tankresa:</p>
  <ul>
    <li><strong>Räkna på hela resan.</strong> En omväg på 5 mil tur och retur med en bil som drar 0,6 liter per mil kostar {kr(5 * 0.6 * v.b95, 0)} i bensin med det svenska snittpriset.</li>
    <li><strong>Snittpris är inte stationspris.</strong> Siffrorna är landets genomsnitt. Vid gränsen och längs motorvägar kan priset vara både högre och lägre.</li>
    <li><strong>Kronkursen påverkar.</strong> Omräkningen görs med veckans kurs. Betalar du med kort kan banken använda en annan kurs och ta en avgift.</li>
    {hojning && nyPlats && <li><strong>Den svenska skatten ändras {datumText(nasta.fran)}.</strong> Om bara skatten ändras blir 95 ungefär {kr(Math.abs(hojning))} {hojning > 0 ? "dyrare" : "billigare"} per liter. Då skulle Sverige ha plats {nyPlats} i stället för {plats} i tabellen ovan.</li>}
  </ul>
  <p>För diesel är jämförelsen en annan. Med veckans priser är diesel billigare än i Sverige i {efterD.filter((x) => x.diesel < v.diesel).length} av de {efterD.length - 1} andra länderna. Se tabellen ovan och <a href="/dieselpris/">dagens dieselpris</a>.</p>

  <h2 id="utveckling">Utvecklingen det senaste året</h2>
  <Kurva titel="Bensin 95 i Sverige och grannländerna, kr per liter" linjer={kurvLander.map(([kod, n, farg]) => ({ namn: n, farg, punkter: (kod === "SE" ? VECKOR.map((x) => ({ datum: x.datum, b95: x.b95 })) : landSerie(kod)).filter((x) => x.datum >= ettAr).map((x) => ({ x: x.datum, y: x.b95 })) }))} />
  <p>Kurvorna går i stort sett i takt, eftersom produktpriset följer samma världsmarknad. När den svenska kurvan avviker från de andra beror det oftast på en svensk skatteändring eller på att kronan har stärkts eller försvagats mot euron.</p>

  <h2 id="metod">Så räknar vi</h2>
  <p>Alla priser kommer från EU-kommissionens Weekly Oil Bulletin. Där rapporterar varje medlemsland en gång i veckan sitt genomsnittliga pumppris för bensin 95 och diesel, både med och utan skatter. Priserna anges i euro. Vi räknar om dem till kronor med den växelkurs som anges för samma vecka i samma källa, så att jämförelsen inte påverkas av kursen en annan dag. Skatten per land är skillnaden mellan priset med och utan skatt.</p>
  <p>Ett snittpris för ett helt land döljer stora lokala skillnader. Använd därför tabellerna för att jämföra nivåer, inte för att förutsäga vad det kostar vid en viss station.</p>
</Guide>
