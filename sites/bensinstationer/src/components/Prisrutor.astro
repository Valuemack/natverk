---
// Prisskylt med dagens snittpris per drivmedel och ändring mot föregående dag.
import { DRIVMEDEL, idagPris, dagsAndring, pris, andring, riktning } from "../pris.js";
const { lankar = true } = Astro.props;
const rutor = DRIVMEDEL.filter((d) => idagPris(d.nyckel) != null).map((d) => ({ ...d, p: idagPris(d.nyckel), a: dagsAndring(d.nyckel) }));
---
<ul class="prisrutor">
  {rutor.map((r) => {
    const inner = <>
      <span class="rnamn">{r.namn}</span>
      <span class="pris">{pris(r.p)}</span>
      <span class="andring">{r.enhet}{r.a && <> · <span class={riktning(r.a.varde)}>{andring(r.a.varde)}</span></>}</span>
    </>;
    return <li>{lankar ? <a href={r.href}>{inner}</a> : inner}</li>;
  })}
</ul>
