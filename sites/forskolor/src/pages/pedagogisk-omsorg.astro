  { id: "avgift", rubrik: "Vad kostar pedagogisk omsorg?" },
  { id: "siffror", rubrik: "Pedagogisk omsorg i siffror" },
  { id: "nattis", rubrik: "Nattis – omsorg på kvällar, nätter och helger" },
  { id: "oppen-forskola", rubrik: "Öppen förskola och öppen fritids" },
