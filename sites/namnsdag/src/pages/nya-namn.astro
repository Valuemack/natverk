---
// Förändringar i namnlängden: nya namn 2027 och tidigare ändringar.
import Layout from "../layouts/Sida.astro";
import Faq from "@natverk/core/Faq.astro";
import { faqLd } from "@natverk/core/seo.js";
import "../styles/sajt.css";
import { nyfodda, trend, ursprung, scb, NYF_KALLA, WIKI_HAMTAD } from "../lib/namndata.js";
import { datasetLd, itemListLd, ISOF_KALLA_LD, SCB_KALLA_LD } from "../lib/schema.js";
import { SITE, UPPDATERAD, ANDRINGAR, ALLA_NAMN, AR, SCB_KALLA, dagText, dagHref, namnHref, tal, barare, lista } from "../site.js";

const ar = [...new Set(ANDRINGAR.map((a) => a.ar))].sort((a, b) => b - a);
const senaste = ar[0];
const nyaSenaste = ANDRINGAR.filter((a) => a.ar === senaste && a.nytt);
const harSida = new Set(ALLA_NAMN.map((n) => n.namn));
const bararMap = new Map(ALLA_NAMN.map((n) => [n.namn, barare(n)]));
// De nya namnen i siffror: bärare 2020, nyfödda 2022, trend och betydelse (Wikipedia, ordagrant).
const fakta = nyaSenaste.map((a) => { const serie = nyfodda(a.nytt); return { ...a, s: scb(a.nytt), sist: serie.at(-1), tr: trend(serie), urs: ursprung(a.nytt) }; });
const summaNya = fakta.reduce((x, f) => x + (f.s?.tilltal ?? 0), 0);
const nyfSumma = fakta.reduce((x, f) => x + (f.sist?.x ?? 0), 0);
const nyfAr = fakta.find((f) => f.sist)?.sist.ar;
// Hur har tidigare tillagda namn utvecklats bland nyfödda sedan de kom in i almanackan?
const utv = ANDRINGAR.filter((a) => a.nytt && a.ar < senaste).map((a) => { const serie = nyfodda(a.nytt); const fore = serie.find((r) => r.ar === a.ar - 1); const sist = serie.at(-1); return fore && sist && fore.x > 0 ? { ...a, fore, sist, andr: Math.round(((sist.x - fore.x) / fore.x) * 100) } : null; }).filter(Boolean).sort((a, b) => b.andr - a.andr);
const okat = utv.filter((u) => u.andr > 0).length;
const fragor = [
  { fraga: `Vilka nya namn kommer i almanackan ${senaste}?`, svar: `Från ${senaste} får ${nyaSenaste.length} nya namn namnsdag: ${lista(nyaSenaste.map((a) => `${a.nytt} (${dagText(a.datum)})`))}.` },
  summaNya > 0 && { fraga: `Hur många heter de nya namnen från ${senaste}?`, svar: `${tal(summaNya)} personer i Sverige hade något av de ${nyaSenaste.length} nya namnen som tilltalsnamn i slutet av 2020 (SCB)${nyfAr ? `, och ${tal(nyfSumma)} nyfödda fick något av dem ${nyfAr}` : ""}.` },
  utv.length > 0 && { fraga: "Blir ett namn vanligare när det kommer in i almanackan?", svar: `Inte nödvändigtvis. Av ${utv.length} namn som lagts till sedan ${ar.at(-1)} har ${okat} fått fler nyfödda och ${utv.length - okat} färre, jämfört med året innan de kom in (SCB, nyfödda till och med ${utv[0].sist.ar}).` },
  { fraga: "Hur ofta ändras namnlängden?", svar: `Oregelbundet, med några års mellanrum. Sedan ${ar.at(-1)} har namnlängden ändrats ${ar.length} gånger, med ändringar från ${lista([...ar].reverse().map(String))}.` },
];
---
<Layout site={SITE} titel={`Nya namn i almanackan ${senaste} – ${nyaSenaste.length} namn får namnsdag`}
  beskrivning={`Vilka namn får namnsdag från ${senaste}? Alla ${nyaSenaste.length} nya namn med datum och vilka namn de delar dag med, och alla tidigare ändringar i namnlängden sedan ${ar.at(-1)}.`}
  smulor={[{ namn: "Namnsdag idag", href: "/" }, { namn: "Nya namn", href: "/nya-namn/" }]}
  jsonld={[faqLd(fragor), itemListLd(`Nya namn i almanackan ${senaste}`, nyaSenaste.filter((a) => harSida.has(a.nytt)).map((a) => ({ namn: a.nytt, href: namnHref(a.nytt) })))]} uppdaterad={UPPDATERAD}>
  <h1>Nya namn i almanackan {senaste}</h1>
  <p class="svar">Från {senaste} får <strong>{nyaSenaste.length} nya namn</strong> namnsdag: {lista(nyaSenaste.map((a) => a.nytt))}. {nyaSenaste.some((a) => a.bort) ? <>Några ersätter äldre namn, se tabellen.</> : <>Inga befintliga namn tas bort.</>} Ändringen bygger på Namnlängdskommitténs beslut 2025.</p>
  {ar.map((a) => {
    const rader = ANDRINGAR.filter((x) => x.ar === a);
    return <>
      <h2>Ändringar från {a}</h2>
      <div class="tabell"><table>
        <thead><tr><th>Datum</th><th>Nytt namn</th><th>Borttaget</th><th class="num">Bärare 2020</th></tr></thead>
        <tbody>{rader.map((x) => <tr>
          <td><a href={dagHref(x.datum)}>{dagText(x.datum)}</a></td>
          <td>{x.nytt ? (harSida.has(x.nytt) ? <a href={namnHref(x.nytt)}>{x.nytt}</a> : x.nytt) : "–"}</td>
          <td>{x.bort ?? "–"}</td>
          <td class="num">{x.nytt && bararMap.get(x.nytt) ? tal(bararMap.get(x.nytt)) : "–"}</td>
        </tr>)}</tbody>
      </table></div>
    </>;
  })}
  <p class="kalla">Källa: Institutet för språk och folkminnen (Isof), namnlängden och Namnlängdskommitténs beslut. Antal bärare: SCB, tilltalsnamn 31 december 2020.</p>

  <h2>De nya namnen {senaste} i siffror</h2>
  <p>Tillsammans har {tal(summaNya)} personer i Sverige något av de nya namnen som tilltalsnamn (SCB 2020){nyfAr && <>, och {tal(nyfSumma)} nyfödda fick något av dem {nyfAr}</>}.</p>
  <div class="tabell"><table>
    <thead><tr><th>Namn</th><th>Namnsdag</th><th class="num">Tilltalsnamn 2020</th><th class="num">Nyfödda {nyfAr ?? ""}</th><th>Bland nyfödda</th></tr></thead>
    <tbody>{fakta.map((f) => <tr><td>{harSida.has(f.nytt) ? <a href={namnHref(f.nytt)}>{f.nytt}</a> : f.nytt}</td><td><a href={dagHref(f.datum)}>{dagText(f.datum)}</a></td><td class="num">{f.s?.tilltal ? tal(f.s.tilltal) : "färre än 10"}</td><td class="num">{f.sist ? tal(f.sist.x) : "–"}</td><td>{f.tr?.ord ?? "–"}</td></tr>)}</tbody>
  </table></div>
  <p class="kalla">Källa: {SCB_KALLA}. "Bland nyfödda" jämför snittet av nyfödda 2018–2022 med 2013–2017.</p>
  {fakta.some((f) => f.urs) && <>
    <h3>Vad betyder de nya namnen?</h3>
    <dl class="betydelser">{fakta.filter((f) => f.urs).map((f) => <><dt>{f.nytt}</dt><dd>"{f.urs.ursprung}" <small>(<a href={f.urs.url} rel="noopener">{f.urs.titel}</a>, svenska Wikipedia)</small></dd></>)}</dl>
    <p class="kalla">Ordagranna citat ur svenska Wikipedia, licens <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.sv" rel="license noopener">CC BY-SA 4.0</a>, hämtade {WIKI_HAMTAD}.</p>
  </>}

  {utv.length > 0 && <>
    <h2>Blev de tidigare nya namnen vanligare?</h2>
    <p>Av de {utv.length} namn som lagts till i almanackan sedan {ar.at(-1)} har {okat} fått fler nyfödda och {utv.length - okat} färre, räknat från året innan namnet kom in till {utv[0].sist.ar}.</p>
    <div class="tabell"><table>
      <thead><tr><th>Namn</th><th class="num">I almanackan från</th><th class="num">Nyfödda året innan</th><th class="num">Nyfödda {utv[0].sist.ar}</th><th class="num">Förändring</th></tr></thead>
      <tbody>{utv.map((u) => <tr><td>{harSida.has(u.nytt) ? <a href={namnHref(u.nytt)}>{u.nytt}</a> : u.nytt}</td><td class="num">{u.ar}</td><td class="num">{tal(u.fore.x)}</td><td class="num">{tal(u.sist.x)}</td><td class="num">{u.andr > 0 ? "+" : ""}{u.andr} %</td></tr>)}</tbody>
    </table></div>
    <p class="kalla">Källa: {NYF_KALLA}. SCB redovisar bara namn som minst två barn fått ett visst år.</p>
  </>}
  <Faq fragor={fragor} />
</Layout>
