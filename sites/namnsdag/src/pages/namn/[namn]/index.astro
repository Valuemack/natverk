---
// En sida per namn i almanackan (/namn/ture/) och per vanlig stavningsvariant (/namn/thomas/).
import Layout from "@natverk/core/Layout.astro";
import Faq from "@natverk/core/Faq.astro";
import Annons from "@natverk/core/Annons.astro";
import { faqLd, valjTitel } from "@natverk/core/seo.js";
import "../../../styles/sajt.css";
import { NAMNSIDOR, startDatum } from "../../../lib/namnsidor.js";
import {
  SITE, AR, UPPDATERAD, MANADER, ANDRINGAR, namnPaDag, kommandeNamnPaDag, dagText, dagHref, manadHref, namnHref, lista,
  kommandeAr, fore, efter, FASTA_DAGAR, barare, tal, delMmdd, veckodag, iso, SCB_KALLA, SCB_TOTALT, varianterTill, giltigt,
} from "../../../site.js";

export function getStaticPaths() {
  return NAMNSIDOR.map((s) => ({ params: { namn: s.slug }, props: s }));
}
const { typ, n, v, slug } = Astro.props;
const versal = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const namn = typ === "variant" ? v.namn : n.namn;
const dt = dagText(n.datum);
const { m } = delMmdd(n.datum);
const start = startDatum(n);
const ar = kommandeAr(n.datum, 6).filter((x) => giltigt(n, x.ar));
const samma = [...namnPaDag(n.datum, Math.max(AR, n.fran ?? 0))].filter((x) => x.namn !== n.namn);
const samma2027 = kommandeNamnPaDag(n.datum).filter((x) => x.namn !== n.namn);
const fast = FASTA_DAGAR[n.datum];
const varianter = typ === "namn" ? varianterTill(n) : [];
const andring = ANDRINGAR.filter((a) => a.nytt === n.namn || a.bort === n.namn);
const s = n.scb;
const t2020 = typ === "variant" ? v.antal : barare(n);
const kon = typ === "variant" ? { K: v.kvinnor, M: v.man } : (s?.tilltal2020 ?? {});
const fornamn = s?.fornamn2020 ? (s.fornamn2020.K ?? 0) + (s.fornamn2020.M ?? 0) : null;
const nyf = typ === "namn" && s?.nyfodda ? Object.entries(s.nyfodda).map(([a, x]) => ({ ar: Number(a), x })).sort((a, b) => a.ar - b.ar) : [];
const nyfMax = nyf.reduce((mx, r) => (r.x > mx.x ? r : mx), { x: 0 });
const nyfSenast = nyf.at(-1);
const nyfFull = Array.from({ length: 25 }, (_, i) => 1998 + i).map((a) => ({ ar: a, x: nyf.find((r) => r.ar === a)?.x ?? 0 }));
const konText = (k) => {
  const K = k.K ?? 0, M = k.M ?? 0;
  if (!K && !M) return null;
  if (!K) return "alla män";
  if (!M) return "alla kvinnor";
  return K > M ? `${tal(K)} kvinnor och ${tal(M)} män` : `${tal(M)} män och ${tal(K)} kvinnor`;
};
const ny = n.fran && n.fran > AR;
const huvudBarare = typ === "variant" ? barare(n) : 0;

const titel = typ === "variant"
  ? valjTitel(`${namn} namnsdag – ${dt} (${n.namn}-dagen) | ${tal(t2020)} heter ${namn}`, `${namn} namnsdag – ${dt} (${n.namn}-dagen)`, `${namn} namnsdag – ${dt}`)
  : ny ? valjTitel(`${namn} namnsdag – ${dt} från ${n.fran} (nytt namn i almanackan)`, `${namn} namnsdag – ${dt} från ${n.fran} (nytt namn)`, `${namn} namnsdag – ${dt} från ${n.fran}`)
  : valjTitel(`${namn} namnsdag – ${dt}${t2020 ? ` | ${tal(t2020)} heter ${namn}` : ""}`, `${namn} namnsdag – ${dt}`);
const beskrivning = typ === "variant"
  ? `När har ${namn} namnsdag? ${namn} saknas i almanackan men kan firas på ${n.namn}-dagen den ${dt}. ${tal(t2020)} personer i Sverige heter ${namn} (SCB).`
  : `När har ${namn} namnsdag? ${ny ? `Från ${n.fran} den ${dt}` : `Den ${dt}`}${samma.length ? `, samma dag som ${lista(samma.map((x) => x.namn))}` : ""}. ${t2020 ? `${tal(t2020)} personer i Sverige heter ${namn}.` : ""} ✓ Veckodag ${AR}–${AR + 4} ✓ Lägg in i kalendern.`;

const fragor = [
  { fraga: `När har ${namn} namnsdag?`, svar: typ === "variant"
    ? `${namn} finns inte med i almanackans namnlängd. Namnet är en stavningsvariant av ${n.namn}, som har namnsdag den ${dt}, och språkligt samhöriga namn kan firas samma dag. Alla namn som saknas i almanackan har dessutom gemensam namnsdag den 1 januari.`
    : `${namn} har namnsdag den ${dt}${ny ? ` från och med ${n.fran}` : ""}. Nästa gång är ${veckodag(start)} ${dt} ${start.getUTCFullYear()}.` },
  t2020 > 0 && { fraga: `Hur många heter ${namn}?`, svar: `${tal(t2020)} personer i Sverige hade ${namn} som tilltalsnamn den 31 december 2020 enligt SCB${konText(kon) ? ` – ${konText(kon)}` : ""}.${fornamn ? ` Räknas alla förnamn, inte bara tilltalsnamnet, är det ${tal(fornamn)} personer.` : ""}` },
  (samma.length > 0 || samma2027.length > 0) && { fraga: `Vem mer har namnsdag den ${dt}?`, svar: `${samma.length ? `Samma dag har ${lista(samma.map((x) => x.namn))} namnsdag.` : ""}${samma2027.length ? ` Från ${samma2027[0].fran} tillkommer ${lista(samma2027.map((x) => x.namn))}.` : ""}`.trim() },
  nyfMax.x > 0 && { fraga: `Hur många nyfödda får namnet ${namn}?`, svar: `${nyfSenast.ar} fick ${tal(nyfSenast.x)} nyfödda tilltalsnamnet ${namn}. Flest var det ${nyfMax.ar}, med ${tal(nyfMax.x)} barn (SCB, nyfödda 1998–2022).` },
  andring.length > 0 && { fraga: `Har ${namn} alltid haft namnsdag den ${dt}?`, svar: andring.map((a) => a.nytt === n.namn
    ? `${namn} kom in i almanackan ${a.ar}${a.bort ? ` och ersatte ${a.bort}` : ""}.`
    : `${namn} togs bort från den ${dagText(a.datum)} ${a.ar}.`).join(" ") },
].filter(Boolean);
---
<Layout site={SITE} titel={titel} beskrivning={beskrivning}
  smulor={[{ namn: "Namnsdag idag", href: "/" }, { namn: "Alla namn", href: "/alla-namn/" }, { namn, href: `/namn/${slug}/` }]}
  jsonld={[faqLd(fragor)]} uppdaterad={UPPDATERAD}>
  <h1>{typ === "variant" ? `${namn} namnsdag` : `${namn} har namnsdag ${dt}`}</h1>

  <p class="svar">
    {typ === "variant"
      ? <><strong>{namn}</strong> finns inte i almanackan, men är en stavningsvariant av <a href={namnHref(n.namn)}>{n.namn}</a>, som har namnsdag <strong>{dt}</strong>. Språkligt samhöriga namn kan firas samma dag. Alla namn som saknas i almanackan har också gemensam namnsdag den <a href="/1-januari/">1 januari</a>.</>
      : <><strong>{namn}</strong> har namnsdag den <strong>{dt}</strong>{ny && <> från och med {n.fran}</>}. Nästa gång är {veckodag(start)} {dt} {start.getUTCFullYear()}<span data-nedrakning={iso(start)}></span>.{samma.length > 0 && <> Samma dag har {lista(samma.map((x) => x.namn))} namnsdag.</>}</>}
    {t2020 > 0 && <> {tal(t2020)} personer i Sverige har {namn} som tilltalsnamn (SCB 2020).</>}
  </p>

  <p><a class="knapp" href={`/namn/${slug}/kalender.ics`} download={`namnsdag-${slug}.ics`}>Lägg in {namn}s namnsdag i kalendern</a></p>

  {typ === "variant" && huvudBarare > 0 && <p>Det finns fler som heter {namn} ({tal(t2020)}) än {n.namn} ({tal(huvudBarare)}) – men det är {n.namn} som står i almanackan.</p>}

  {ny && <p><strong>Nytt namn {n.fran}:</strong> Namnlängdskommittén beslutade i januari 2025 att {namn} ska in i almanackan från {n.fran}. Läs mer om <a href="/nya-namn/">nya namn i almanackan</a>.</p>}

  <h2>Vilken veckodag har {namn} namnsdag?</h2>
  <div class="tabell"><table>
    <thead><tr><th>År</th><th>Datum</th><th>Veckodag</th></tr></thead>
    <tbody>{ar.map((x) => <tr><td>{x.ar}</td><td>{dt}</td><td>{x.dag}</td></tr>)}</tbody>
  </table></div>

  {(t2020 > 0 || fornamn) && <>
    <h2>Hur många heter {namn}?</h2>
    <div class="tabell"><table>
      <thead><tr><th>Mått (SCB)</th><th class="num">Antal</th></tr></thead>
      <tbody>
        {t2020 > 0 && <tr><td>Tilltalsnamn 2020</td><td class="num">{tal(t2020)}</td></tr>}
        {konText(kon) && <tr><td>Varav</td><td class="num">{konText(kon)}</td></tr>}
        {typ === "namn" && s?.tilltal2010 && <tr><td>Tilltalsnamn 2010</td><td class="num">{tal(s.tilltal2010)}</td></tr>}
        {typ === "namn" && s?.tilltal2000 && <tr><td>Tilltalsnamn 2000</td><td class="num">{tal(s.tilltal2000)}</td></tr>}
        {fornamn && <tr><td>Har namnet bland sina förnamn (2020)</td><td class="num">{tal(fornamn)}</td></tr>}
        {typ === "namn" && s?.placering2020 && <tr><td>Placering bland {tal(SCB_TOTALT.namn)} tilltalsnamn</td><td class="num">{tal(s.placering2020)}</td></tr>}
      </tbody>
    </table></div>
    {typ === "namn" && s?.tilltal2000 && t2020 > 0 && <p>Sedan 2000 har antalet som heter {namn} {t2020 > s.tilltal2000 ? `ökat med ${tal(t2020 - s.tilltal2000)}` : t2020 < s.tilltal2000 ? `minskat med ${tal(s.tilltal2000 - t2020)}` : "legat still"} ({Math.round(((t2020 - s.tilltal2000) / s.tilltal2000) * 100)} procent).</p>}
    <p class="kalla">Källa: {SCB_KALLA}. Folkbokförda 31 december. Namn med färre än 10 bärare redovisas inte av SCB. <a href="/hur-manga-heter/">Jämför med andra namn</a>.</p>
  </>}

  {nyfMax.x > 0 && <>
    <h2>Nyfödda som fått namnet {namn}</h2>
    <p>{nyfSenast.ar} fick {tal(nyfSenast.x)} nyfödda tilltalsnamnet {namn}. Flest var det {nyfMax.ar}, med {tal(nyfMax.x)} barn.</p>
    <div class="staplar" role="img" aria-label={`Nyfödda med tilltalsnamnet ${namn} per år 1998–2022. Flest ${nyfMax.ar}: ${nyfMax.x}.`}>
      {nyfFull.map((r) => <span style={`height:${Math.max(1, Math.round((r.x / nyfMax.x) * 100))}%`} title={`${r.ar}: ${r.x}`}></span>)}
    </div>
    <div class="staplar-ar"><span>1998</span><span>2010</span><span>2022</span></div>
    <p class="kalla">Källa: SCB, nyfödda efter tilltalsnamn och namngivningsår (BE0001Nyfodda). År med färre än 2 barn redovisas inte.</p>
  </>}

  <Annons plats="namn-1" />

  {varianter.length > 0 && <>
    <h2>Stavningsvarianter som kan firas samma dag</h2>
    <ul class="namnchips">{varianter.map((x) => <li><a href={`/namn/${x.slug}/`}>{x.namn}<small>{tal(x.antal)}</small></a></li>)}</ul>
  </>}

  {andring.length > 0 && typ === "namn" && <>
    <h2>{namn} i almanackans historia</h2>
    <ul>{andring.map((a) => <li>{a.nytt === n.namn
      ? <>{a.ar}: {namn} kom in i almanackan den {dagText(a.datum)}{a.bort && <> och ersatte {a.bort}</>}.</>
      : <>{a.ar}: {namn} togs bort från den {dagText(a.datum)}.</>}</li>)}</ul>
  </>}

  <h2>Namnsdagar runt {dt}</h2>
  <ul class="veckan">
    {[fore(n.datum), n.datum, efter(n.datum)].map((kk) => {
      const ns = namnPaDag(kk, Math.max(AR, n.fran ?? 0));
      return <li aria-current={kk === n.datum ? "page" : undefined}><span class="vd"><a href={dagHref(kk)}>{dagText(kk)}</a></span>
        <span>{ns.length ? ns.map((x, j) => <>{j > 0 && ", "}{x.namn === n.namn ? <strong>{x.namn}</strong> : <a href={namnHref(x.namn)}>{x.namn}</a>}</>) : <em>ingen namnsdag</em>}</span></li>;
    })}
  </ul>
  {fast && <p>Den {dt} är också {fast}.</p>}
  <p><a href={manadHref(m)}>Alla namnsdagar i {MANADER[m - 1]}</a> · <a href="/alla-namn/">Alla namn A–Ö</a> · <a href="/">Namnsdag idag</a></p>

  <Faq fragor={fragor} />

  <script slot="skript" is:inline>
    (() => {
      const el = document.querySelector("[data-nedrakning]");
      if (!el) return;
      const nu = new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Stockholm", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
      const dagar = Math.round((Date.parse(el.dataset.nedrakning) - Date.parse(nu)) / 86400000);
      if (dagar === 0) el.textContent = " – det är idag!";
      else if (dagar > 0) el.textContent = ` (om ${dagar} ${dagar === 1 ? "dag" : "dagar"})`;
    })();
  </script>
</Layout>
