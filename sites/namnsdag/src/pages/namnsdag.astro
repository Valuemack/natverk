    { namn: "Isof – Namnsdagar", url: "https://www.isof.se/utforska/kunskapsbanker/lar-dig-mer-om-arets-namn-och-handelser/namnsdagar", text: "firandet på 1800-talet, kungliga namnsdagar och flaggdagar", datum: "2026-11-25" },
    { namn: "Isof – Alla namn i almanackan", url: "https://www.isof.se/utforska/kunskapsbanker/lar-dig-mer-om-arets-namn-och-handelser/alla-namn-i-almanackan", text: "namnlängden som sajtens data bygger på", datum: "2026-11-22" },
