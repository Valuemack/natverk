---
// Startsidan: namnsdag idag (byggs om varje natt, rättas i webbläsaren om sidan är äldre än dagens datum),
// verktyget "När har … namnsdag?" och veckans namnsdagar.
import Layout from "@natverk/core/Layout.astro";
import Faq from "@natverk/core/Faq.astro";
import Annons from "@natverk/core/Annons.astro";
import { faqLd, websiteLd } from "@natverk/core/seo.js";
import "../styles/sajt.css";
import {
  SITE, IDAG, AR, UPPDATERAD, MANADER, ALLA_NAMN, VARIANTER, namnPaDag, mmddAv, dagText, dagHref, namnHref, manadHref,
  lista, plusDagar, veckodag, iso, barare, tal, UTAN_NAMN, giltigt,
} from "../site.js";
import Sok from "../components/Sok.astro";

const k = mmddAv(IDAG);
const idag = namnPaDag(k);
const imorgonK = mmddAv(plusDagar(IDAG, 1));
const imorgon = namnPaDag(imorgonK, plusDagar(IDAG, 1).getUTCFullYear());
const datumrad = `${veckodag(IDAG)} ${dagText(k)} ${AR}`;
const vecka = Array.from({ length: 7 }, (_, i) => {
  const dt = plusDagar(IDAG, i);
  const kk = mmddAv(dt);
  return { dt, k: kk, namn: namnPaDag(kk, dt.getUTCFullYear()) };
});
const idagText = idag.length ? lista(idag.map((n) => n.namn)) : null;
const flestBarare = [...idag].sort((a, b) => barare(b) - barare(a))[0];
const antalNu = ALLA_NAMN.filter((n) => giltigt(n)).length;
const antal2027 = ALLA_NAMN.length;

const fragor = [
  { fraga: "Vem har namnsdag idag?", svar: idagText ? `Idag, ${datumrad}, har ${idagText} namnsdag.` : `Idag, ${datumrad}, finns inget namn i almanackan – det är ${UTAN_NAMN[k]?.toLowerCase() ?? "en dag utan namn"}.` },
  { fraga: "Vem har namnsdag imorgon?", svar: imorgon.length ? `Imorgon, ${veckodag(plusDagar(IDAG, 1))} ${dagText(imorgonK)}, har ${lista(imorgon.map((n) => n.namn))} namnsdag.` : `Imorgon, ${dagText(imorgonK)}, finns inget namn i almanackan.` },
  { fraga: "Hur många namn finns i almanackan?", svar: `Den svenska namnlängden har ${antalNu} namn ${AR}. Från 2027 blir det ${antal2027}, när Cassandra, Eira, Flora, Mio, Vilgot och Zackarias kommer in.` },
  { fraga: "Vad gör man om man inte har någon namnsdag?", svar: "Den 1 januari finns inget namn i almanackan. Dagen är i stället gemensam namnsdag för alla namn som saknas i namnlängden. Många firar också på dagen för ett närbesläktat namn, till exempel firar många som heter Thomas på Tomas-dagen." },
];
---
<Layout site={SITE} titel={`Namnsdag idag ${dagText(k)} – ${idagText ?? "ingen namnsdag"} | Alla namnsdagar ${AR}`}
  beskrivning={`Vem har namnsdag idag, ${datumrad}? ${idagText ? `${idagText}.` : "Ingen namnsdag idag."} ✓ Sök när ditt namn har namnsdag ✓ Veckans namnsdagar ✓ Alla ${antalNu} namn i almanackan.`}
  smulor={[{ namn: "Namnsdag idag", href: "/" }]} jsonld={[websiteLd(SITE), faqLd(fragor)]} uppdaterad={UPPDATERAD}>
  <h1>Namnsdag idag</h1>

  <section class="idag" id="idag" data-byggdag={iso(IDAG)} aria-live="polite">
    <span class="datumrad" data-falt="datum">{datumrad}</span>
    <p class="stornamn" data-falt="namn">{idag.length
      ? idag.map((n, i) => <>{i > 0 && (i === idag.length - 1 ? " och " : ", ")}<a href={namnHref(n.namn)}>{n.namn}</a></>)
      : <span>{UTAN_NAMN[k]?.split(" –")[0] ?? "Ingen namnsdag"}</span>}</p>
    <p class="extra" data-falt="extra">{idag.length ? "har namnsdag idag." : "Ingen har namnsdag i almanackan idag."}</p>
  </section>

  <p class="svar" data-falt="svar">Idag, {datumrad}, {idagText ? <>har <strong>{idagText}</strong> namnsdag.</> : <>finns inget namn i almanackan.</>}
    {flestBarare && barare(flestBarare) > 0 && <> {tal(barare(flestBarare))} personer i Sverige har {flestBarare.namn} som tilltalsnamn.</>}
    {" "}Imorgon har {imorgon.length ? lista(imorgon.map((n) => n.namn)) : "ingen"} namnsdag.</p>

  <Sok />

  <h2>Namnsdagar de närmaste sju dagarna</h2>
  <ul class="veckan" id="veckan">
    {vecka.map((d, i) => (
      <li aria-current={i === 0 ? "date" : undefined}>
        <span class="vd"><a href={dagHref(d.k)}>{i === 0 ? "Idag" : i === 1 ? "Imorgon" : veckodag(d.dt)} {dagText(d.k)}</a></span>
        <span>{d.namn.length ? d.namn.map((n, j) => <>{j > 0 && ", "}<a href={namnHref(n.namn)}>{n.namn}</a></>) : <em>{UTAN_NAMN[d.k]?.split(" –")[0] ?? "ingen namnsdag"}</em>}</span>
      </li>
    ))}
  </ul>

  <Annons plats="start-1" />

  <h2>Namnsdagar månad för månad</h2>
  <div class="lank-rad">{MANADER.map((m, i) => <a href={manadHref(i + 1)} aria-current={i === IDAG.getUTCMonth() ? "page" : undefined}>{m[0].toUpperCase() + m.slice(1)}</a>)}</div>

  <h2>Mer om namnsdagar</h2>
  <ul>
    <li><a href="/alla-namn/">Alla {antal2027} namn i almanackan från A till Ö</a></li>
    <li><a href="/vanligaste-namnen/#almanackan">Almanackans vanligaste namn</a> – hur många som bär varje namn enligt SCB</li>
    <li><a href="/nya-namn/">Nya namn i almanackan</a> – alla ändringar sedan 2001 och de sex nya namnen 2027</li>
    <li><a href="/namn-utan-namnsdag/">Vanliga namn som saknar namnsdag</a> – och vilken dag de kan firas ({VARIANTER.length} stavningsvarianter)</li>
    <li><a href="/namnsdagar.ics">Alla namnsdagar som kalenderfil</a> för mobilen eller Outlook</li>
  </ul>

  <h2>Guider om namn och namnsdagar</h2>
  <ul>
    <li><a href="/namnsdag/">Namnsdag – historia och almanackan</a>: från helgonkalendern till namnlängden 2001 och vem som bestämmer namnen</li>
    <li><a href="/hur-manga-heter/">Hur många heter …?</a> – sök bland alla förnamn i SCB:s namnstatistik</li>
    <li><a href="/pojknamn/">Pojknamn</a> och <a href="/flicknamn/">flicknamn</a> – populära och klassiska namn med topplistor sedan 1998</li>
    <li><a href="/vanligaste-namnen/">Vanligaste namnen i Sverige</a> – topp 20 för kvinnor och män</li>
    <li><a href="/grattis-pa-namnsdagen/">Grattis på namnsdagen</a> – hälsningar, presentidéer och traditionen</li>
    <li><a href="/ovanliga-namn/">Ovanliga namn och namnens betydelse</a></li>
  </ul>

  <Faq fragor={fragor} />

  <script slot="skript" is:inline>
    // Rättar "idag" om sidan är byggd en tidigare dag (cache eller nattbygget har inte körts än).
    (async () => {
      const el = document.getElementById("idag");
      const nu = new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Stockholm", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
      if (!el || el.dataset.byggdag === nu) return;
      try {
        const d = await (await fetch("/data/namnsdagar.json")).json();
        const [y, m, dd] = nu.split("-").map(Number);
        const dag = (o) => { const t = new Date(Date.UTC(y, m - 1, dd + o)); return { t, k: t.toISOString().slice(5, 10) }; };
        const VD = ["söndag", "måndag", "tisdag", "onsdag", "torsdag", "fredag", "lördag"];
        const MN = ["januari", "februari", "mars", "april", "maj", "juni", "juli", "augusti", "september", "oktober", "november", "december"];
        const txt = (t) => `${t.getUTCDate()} ${MN[t.getUTCMonth()]}`;
        const namn = (o) => { const { t, k } = dag(o); return (d.dagar[k] || []).filter((x) => !x[2] || t.getUTCFullYear() >= x[2]); };
        const lank = (x) => `<a href="/namn/${x[1]}/">${x[0]}</a>`;
        const lista = (xs) => xs.length < 2 ? xs.join("") : xs.slice(0, -1).join(", ") + " och " + xs.at(-1);
        const i0 = dag(0), n0 = namn(0), n1 = namn(1);
        el.querySelector('[data-falt="datum"]').textContent = `${VD[i0.t.getUTCDay()]} ${txt(i0.t)} ${y}`;
        el.querySelector('[data-falt="namn"]').innerHTML = n0.length ? lista(n0.map(lank)) : (d.utan[i0.k] || "Ingen namnsdag");
        el.querySelector('[data-falt="extra"]').textContent = n0.length ? "har namnsdag idag." : "Ingen har namnsdag i almanackan idag.";
        document.querySelector('[data-falt="svar"]').innerHTML = `Idag, ${VD[i0.t.getUTCDay()]} ${txt(i0.t)} ${y}, ${n0.length ? `har <strong>${lista(n0.map((x) => x[0]))}</strong> namnsdag.` : "finns inget namn i almanackan."} Imorgon har ${n1.length ? lista(n1.map((x) => x[0])) : "ingen"} namnsdag.`;
        document.getElementById("veckan").innerHTML = [0, 1, 2, 3, 4, 5, 6].map((o) => {
          const { t } = dag(o), ns = namn(o);
          const rub = o === 0 ? "Idag" : o === 1 ? "Imorgon" : VD[t.getUTCDay()];
          return `<li${o === 0 ? ' aria-current="date"' : ""}><span class="vd">${rub} ${txt(t)}</span><span>${ns.length ? ns.map(lank).join(", ") : "<em>ingen namnsdag</em>"}</span></li>`;
        }).join("");
      } catch {}
    })();
  </script>
</Layout>
