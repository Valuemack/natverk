---
// Tabellcell: namnets namnsdag (egen dag, stavningsvariant eller saknas).
import { namnsdagFor } from "../lib/statistik.js";
import { dagText } from "../site.js";
import { OMDIRIGERADE } from "../lib/namndata.js";
const { namn } = Astro.props;
const d = namnsdagFor(namn);
---
<td>{d ? <a href={OMDIRIGERADE.get(namn)?.mal ?? `/namn/${d.slug}/`}>{dagText(d.n.datum)}</a> : "–"}{d?.typ === "variant" && <small> ({d.n.namn})</small>}{d?.typ === "utan" && <small> (gemensam dag)</small>}</td>
