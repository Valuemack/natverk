---
// Namnsdagssajtens layout: samma struktur och CSS som @natverk/core/Layout.astro, plus det core inte har:
// OG-bild (1200×630) och Twitter-kort med titel/bild, och JSON-LD för WebPage (dateModified),
// Organization och – på startsidan – WebSite med SearchAction. Övrig JSON-LD skickas in via `jsonld`.
// (Core ändras inte här; om core får samma stöd kan sajten gå tillbaka till core-layouten.)
import "@natverk/core/bas.css";
import { abs, breadcrumbLd, kortaBesk } from "@natverk/core/seo.js";
import { TEMAN } from "@natverk/core/teman.js";

const { site, titel: titelRa, beskrivning: beskrivningRa, sokvag = Astro.url.pathname, smulor = [], jsonld = [],
  uppdaterad, noindex = false, ogTyp = "website", ogBild = "/og/standard.png", ogAlt, sidtyp = "WebPage" } = Astro.props;
const canonical = abs(site, sokvag);
const beskrivning = kortaBesk(beskrivningRa);
const titel = String(titelRa ?? "").replace(/­/g, "");
const tema = site.tema ?? "kalender";
const logga = TEMAN[tema]?.logga ?? "";
const bild = abs(site, ogBild);
const bildAlt = ogAlt ?? titel;
const org = { "@type": "Organization", "@id": `${site.url}/#org`, name: site.organisation, url: `${site.url}/`, logo: abs(site, "/favicon.svg") };
const startsida = sokvag === "/";
const grund = [
  { "@context": "https://schema.org", ...org },
  ...(startsida ? [{
    "@context": "https://schema.org", "@type": "WebSite", "@id": `${site.url}/#webbplats`, name: site.namn, url: `${site.url}/`,
    inLanguage: "sv-SE", description: site.beskrivning, publisher: { "@id": `${site.url}/#org` },
    potentialAction: { "@type": "SearchAction", target: { "@type": "EntryPoint", urlTemplate: `${site.url}/?namn={search_term_string}` }, "query-input": "required name=search_term_string" },
  }] : []),
  {
    "@context": "https://schema.org", "@type": sidtyp, "@id": `${canonical}#sida`, url: canonical, name: titel, description: beskrivning,
    inLanguage: "sv-SE", isPartOf: { "@type": "WebSite", "@id": `${site.url}/#webbplats`, name: site.namn, url: `${site.url}/` },
    publisher: { "@id": `${site.url}/#org` }, primaryImageOfPage: { "@type": "ImageObject", url: bild, width: 1200, height: 630 },
    ...(uppdaterad ? { dateModified: uppdaterad } : {}),
  },
];
const allaLd = [...grund, ...(smulor.length > 1 ? [breadcrumbLd(site, smulor)] : []), ...jsonld.filter((x) => x?.["@type"] !== "WebSite")];
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beskrivning} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogTyp} />
    <meta property="og:site_name" content={site.namn} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivning} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={bild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={bildAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titel} />
    <meta name="twitter:description" content={beskrivning} />
    <meta name="twitter:image" content={bild} />
    <meta name="twitter:image:alt" content={bildAlt} />
    <meta name="theme-color" content={site.farg} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style set:html={`:root{--farg:${site.farg}}`}></style>
    {allaLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body class={`tema-${tema}`}>
    <a class="hoppa" href="#innehall">Till innehållet</a>
    <div class="tjanstelist">
      <div class="ram">
        <span>{site.tjanstText ?? "Oberoende informationstjänst"}</span>
        {uppdaterad && <span>Uppdaterad {uppdaterad}</span>}
      </div>
    </div>
    <header class="topp">
      <div class="ram">
        <a class="logga" href="/">
          <span class="logga-ikon" set:html={logga} />
          <span class="logga-text"><strong>{site.visningsnamn}</strong>{site.tagline && <small>{site.tagline}</small>}</span>
        </a>
        <nav aria-label="Huvudmeny">
          {site.meny.map((m) => <a href={m.href} aria-current={Astro.url.pathname === m.href ? "page" : undefined}>{m.namn}</a>)}
        </nav>
      </div>
    </header>
    <main class="ram" id="innehall">
      {smulor.length > 1 && (
        <nav class="smulor" aria-label="Brödsmulor">
          <ol>
            {smulor.map((s, i) => (
              <li>{i < smulor.length - 1 ? <a href={s.href}>{s.namn}</a> : <span aria-current="page">{s.namn}</span>}</li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
      {uppdaterad && <p class="uppdaterad">Uppdaterad <time datetime={uppdaterad}>{uppdaterad}</time></p>}
    </main>
    <footer class="botten">
      <div class="ram">
        <nav aria-label="Sidfot">
          {site.sidfot.map((m) => <a href={m.href}>{m.namn}</a>)}
        </nav>
        {site.natverk?.length > 0 && (
          <p class="natverk">Fler nyttiga sajter: {site.natverk.map((n, i) => <>{i > 0 && " · "}<a href={n.href}>{n.namn}</a></>)}</p>
        )}
        {site.kallor?.length > 0 && <p class="kallor-rad"><strong>Datakällor:</strong> {site.kallor.join(" · ")}</p>}
        <p>{site.sidfotText}</p>
        <p>© {new Date().getFullYear()} {site.organisation}. Oberoende tjänst – inte ansluten till någon myndighet.</p>
      </div>
    </footer>
    <slot name="skript" />
  </body>
</html>
