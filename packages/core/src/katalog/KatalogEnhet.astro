---
// Sida för en enskild enhet (ett apotek, en vårdcentral, ett bibliotek …).
// All text är dagsoberoende; "öppet nu" och dagens rad räknas i webbläsaren.
import Layout from "../Layout.astro";
import Annons from "../Annons.astro";
import Faq from "../Faq.astro";
import { faqLd, besk } from "../seo.js";
import Oppettider from "./Oppettider.astro";
import OppetNu from "./OppetNu.astro";
import EnhetLista from "./EnhetLista.astro";
import OppetNuSkript from "./OppetNuSkript.astro";
import { enhetLd, veckoSammanfattning, narmaste, kmText, telLank, kartLank, adressRad, tolkaIntervall, titelNamn as kortTitelNamn, invanarePer, talText, DAGAR, dagText } from "../katalog.js";
import { helgTider, specialLd, helgFraga } from "../helgtider.js";

const { site, kat, enhet: e, ord, schemaTyp, uppdaterad, kallaText, extraFragor = [], titelOrd = "öppettider", helgdagar = false, kedjaHref = null } = Astro.props;
const kedjaLank = e.kedja && kedjaHref ? kedjaHref(e) : null;
const kommun = kat.kommuner.find((k) => k.slug === e.kommunSlug);
const lan = kat.lan.find((l) => l.slug === kommun.lanSlug);
const vs = veckoSammanfattning(e.oppettider);
// Helgdagstider (jul, nyår m.m.) de närmaste veckorna – bara publicerade uppgifter, inget gissas.
// Tabellen och helgfrågan visas bara när enheten själv publicerat minst en helgtid. En tabell med bara
// "Ej publicerat än" på tusentals sidor är ren mallutfyllnad (Googles "scaled content") och ger besökaren inget.
const htRa = helgdagar && uppdaterad ? helgTider(e, uppdaterad) : null;
const ht = htRa?.harData ? htRa : null;
const forstaOrd = ht && e.oppettider ? (() => { const v = e.oppettider[DAGAR[(new Date(ht.rader[0].iso).getUTCDay() + 6) % 7]]; return v != null ? dagText(v) : null; })() : null;
const nara = narmaste(e, kat.enheter, 5);
const ovriga = kommun.enheter.filter((x) => x !== e && !nara.some((n) => n.enhet === x));
const plats = e.ort ?? e.kommun;
const harOrt = plats && e.namn.toLowerCase().includes(plats.toLowerCase());
const slutTitel = vs ? `${titelOrd.replace(" och ", ", ")} och adress` : "adress och telefon";
// e.skilj sätts av katalogen när flera enheter annars skulle få samma titel.
const titelNamn = e.titelNamn ?? kortTitelNamn(e.namn);
const titelKandidater = e.skilj ? [
  `${titelNamn}, ${e.skilj}${harOrt ? "" : `, ${plats}`} – ${slutTitel}`,
  `${titelNamn}, ${e.skilj}${harOrt ? "" : `, ${plats}`} – ${vs ? titelOrd : "adress"}`,
  `${titelNamn}, ${e.skilj} – ${vs ? titelOrd : "adress"}`,
  `${titelNamn}, ${e.skilj}`,
] : [
  `${titelNamn}${harOrt ? "" : `, ${plats}`} – ${slutTitel}`,
  `${titelNamn}${harOrt ? "" : `, ${plats}`} – ${vs ? titelOrd : "adress"}`,
  `${titelNamn} – ${vs ? titelOrd : "adress"}`,
  `${titelNamn}${harOrt ? "" : `, ${plats}`}`,
];
const titel = titelKandidater.find((t) => t.length <= 60) ?? titelKandidater.at(-1);
const beskrivning = besk(
  `${e.namn}${e.gatuadress ? ` på ${e.gatuadress}` : ""}${plats && !harOrt ? ` i ${plats}` : ""}${e.kommun && plats && plats !== e.kommun ? ` (${e.kommun} kommun)` : ""}${lan ? `, ${lan.namn}` : ""}.`,
  vs && `✓ Öppet ${vs}`,
  ht?.harData && (ht.jul ? "✓ Tider i jul och nyår" : "✓ Helgdagstider"),
  e.telefon && "✓ Telefon",
  nara.length && `✓ Närmaste ${ord.plur}`,
  "✓ Vägbeskrivning och karta",
  `✓ Alla ${ord.plur} i ${kommun.namn}`,
  "Uppdateras varje natt.",
);

// Läget i kommunen: hur många det finns, hur många invånare per enhet och avståndet till närmaste andra.
const iKommunen = kommun.enheter.length;
const perInv = invanarePer(kommun.folk, iKommunen);
const lageText = `${e.namn} är ${iKommunen === 1 ? `${ord.art === "ett" ? "det enda" : "den enda"} ${ord.sing}` : `${ord.art === "ett" ? "ett" : "en"} av ${iKommunen} ${ord.plur}`} i ${kommun.namn} kommun${perInv ? `, där det går ${ord.art} ${ord.sing} på ungefär ${talText(perInv)} invånare` : ""}.${nara[0] ? ` Närmaste andra ${ord.sing} är ${nara[0].enhet.namn}, ${kmText(nara[0].km)} bort fågelvägen.` : ""}`;

const sondag = tolkaIntervall(e.oppettider?.sun);
const fragor = [
  vs && { fraga: `Vilka öppettider har ${e.namn}?`, svar: `${e.namn} har öppet ${vs}. Tiderna kan avvika vid helgdagar.` },
  ht && helgFraga(e, ht, forstaOrd),
  sondag && { fraga: `Har ${e.namn} öppet på söndagar?`, svar: sondag.length ? `Ja, ${e.namn} har öppet på söndagar (${veckoSammanfattning({ sun: e.oppettider.sun }).replace(/^sön /, "")}).` : `Nej, ${e.namn} har stängt på söndagar.` },
  e.gatuadress && { fraga: `Var ligger ${e.namn}?`, svar: `${e.namn} ligger på ${adressRad(e)} i ${e.kommun} kommun${e.lan ? `, ${e.lan}` : ""}.` },
  e.telefon && { fraga: `Vilket telefonnummer har ${e.namn}?`, svar: e.telefon_typ === "kundservice" ? `${e.namn} nås via ${e.kedja ?? "kedjans"} kundtjänst på ${e.telefon}.` : `Telefonnumret till ${e.namn} är ${e.telefon}.` },
  nara[0] && { fraga: `${ord.art === "ett" ? "Vilket" : "Vilken"} ${ord.sing} ligger närmast ${e.namn}?`, svar: `Närmast ligger ${nara[0].enhet.namn}, ${kmText(nara[0].km)} bort fågelvägen${nara[0].enhet.gatuadress ? ` på ${nara[0].enhet.gatuadress}` : ""}.` },
  ...extraFragor,
].filter(Boolean);

const smulor = [
  { namn: "Start", href: "/" },
  ...(lan ? [{ namn: lan.kortnamn, href: lan.href }] : []),
  { namn: kommun.namn, href: kommun.href },
  { namn: e.namn, href: e.href },
];
---
<Layout site={site} titel={titel} beskrivning={beskrivning} smulor={smulor}
  jsonld={[{ ...enhetLd(e, site, schemaTyp), ...(specialLd(ht) && { specialOpeningHoursSpecification: specialLd(ht) }) }, ...(fragor.length ? [faqLd(fragor)] : [])]} uppdaterad={uppdaterad}>
  <h1>{e.namn}</h1>
  <p class="svar">
    {e.gatuadress ? <>{e.namn} ligger på <strong>{adressRad(e)}</strong>{e.kommun && e.kommun !== e.ort && <> i {e.kommun} kommun</>}.</> : <>{e.namn} ligger i <strong>{plats}</strong>{e.kommun && e.kommun !== plats && <> i {e.kommun} kommun</>}.</>}
    {vs && <> Öppet <strong>{vs}</strong>.</>}
    {e.kedja && e.kedja !== e.namn && <> Drivs av {e.kedja}.</>}
  </p>
  <OppetNu enhet={e} />
  <div class="knappar">
    {e.telefon && <a class="knapp" href={telLank(e.telefon)}>{e.telefon_typ === "kundservice" ? "Ring kundtjänst" : `Ring ${e.telefon}`}</a>}
    <a class="knapp sekundar" href={kartLank(e)} rel="nofollow noopener" target="_blank">Vägbeskrivning</a>
    {e.webb && <a class="knapp sekundar" href={e.webb} rel="nofollow noopener" target="_blank">Webbplats</a>}
  </div>

  {vs && <>
    <h2>Öppettider för {e.namn}</h2>
    <Oppettider oppettider={e.oppettider} />
    <p class="kalla">Tiderna kan avvika vid helgdagar och lov.</p>
  </>}

  {ht && <>
    <h2 id="helgdagar">{ht.rubrik}</h2>
    <div class="tabell helgtider"><table>
      <thead><tr><th>Dag</th><th>Datum</th><th>Öppettider</th></tr></thead>
      <tbody>{ht.rader.map((r) => (
        <tr><th scope="row">{r.namn}</th><td>{r.veckodag} {r.datumText}</td>
          <td>{r.text ? <strong>{r.text}</strong> : <span class="ej-publ">Ej publicerat än</span>}</td></tr>
      ))}</tbody>
    </table></div>
    <p class="kalla">{ht.harData
      ? <>Tiderna kommer från {e.kedja ?? "verksamheten"} och kontrolleras varje natt. Dagar utan uppgift har inte publicerats än.</>
      : <>{e.namn} har inte publicerat särskilda tider för helgdagarna än. Ordinarie tider gäller inte alltid på helgdagar och helgaftnar – kontrollera med {e.namn}{e.telefon ? <> på <a href={telLank(e.telefon)}>{e.telefon}</a></> : ""}{e.webb ? <> eller på <a href={e.webb} rel="nofollow noopener" target="_blank">webbplatsen</a></> : ""}. Vi uppdaterar sidan varje natt.</>}</p>
  </>}

  <Annons plats="enhet-1" />

  <h2>Adress och kontakt</h2>
  <p>{lageText}</p>
  <dl class="fakta">
    {e.gatuadress && <><dt>Adress</dt><dd>{e.gatuadress}</dd></>}
    {(e.postnummer || e.ort) && <><dt>Postadress</dt><dd>{[e.postnummer, e.ort].filter(Boolean).join(" ")}</dd></>}
    <dt>Kommun</dt><dd><a href={kommun.href}>{kommun.namn}</a></dd>
    {lan && <><dt>Län</dt><dd><a href={lan.href}>{lan.namn}</a></dd></>}
    {e.telefon && <><dt>{e.telefon_typ === "kundservice" ? "Kundtjänst" : "Telefon"}</dt><dd><a href={telLank(e.telefon)}>{e.telefon}</a>{e.telefon_typ === "kundservice" && e.kedja && <> ({e.kedja})</>}</dd></>}
    {e.webb && <><dt>Webbplats</dt><dd><a href={e.webb} rel="nofollow noopener" target="_blank">{e.webb.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</a></dd></>}
    {e.kedja && <><dt>Drivs av</dt><dd>{kedjaLank ? <a href={kedjaLank}>{e.kedja} – alla butiker och öppettider</a> : e.kedja}</dd></>}
    {e.typ && <><dt>Typ</dt><dd>{e.typ[0].toUpperCase() + e.typ.slice(1)}</dd></>}
    {(e.fakta ?? []).map((f) => <><dt>{f.namn}</dt>{f.varde?.__html ? <dd set:html={f.varde.__html} /> : <dd>{f.varde}</dd>}</>)}
    <slot name="fakta" />
  </dl>

  <slot />

  {nara.length > 0 && <>
    <h2>Närmaste {ord.plur} från {e.namn}</h2>
    <EnhetLista enheter={nara} visaKommun />
  </>}

  <Annons plats="enhet-2" />

  {ovriga.length > 0 && <>
    <h2>Fler {ord.plur} i {kommun.namn}</h2>
    <EnhetLista enheter={ovriga.slice(0, 10)} />
    {ovriga.length > 10 && <p><a href={kommun.href}>Alla {kommun.enheter.length} {ord.plur} i {kommun.namn} →</a></p>}
  </>}

  {fragor.length > 0 && <Faq fragor={fragor} />}
  <p class="kalla">{kallaText} Hittar du ett fel? <a href="/om/#kontakt">Tipsa oss</a>.</p>
  <OppetNuSkript slot="skript" />
</Layout>
