---
// Länssida: alla kommuner i länet med antal enheter.
import Layout from "../Layout.astro";
import Annons from "../Annons.astro";
import Faq from "../Faq.astro";
import { faqLd } from "../seo.js";

const { site, kat, lan: l, ord, uppdaterad, kallaText } = Astro.props;
const Plur = ord.plur[0].toUpperCase() + ord.plur.slice(1);
const storst = [...l.kommuner].sort((a, b) => b.enheter.length - a.enheter.length);
const fragor = [
  { fraga: `Hur många ${ord.plur} finns det i ${l.namn}?`, svar: `Det finns ${l.antal} ${l.antal === 1 ? ord.sing : ord.plur} i ${l.namn}, fördelade på ${l.kommuner.length} kommuner.` },
  { fraga: `Vilken kommun i ${l.namn} har flest ${ord.plur}?`, svar: `${storst[0].namn} har flest med ${storst[0].enheter.length} st${storst[1] ? `, följt av ${storst[1].namn} (${storst[1].enheter.length})` : ""}.` },
];
const titel = [`${Plur} i ${l.namn} – alla ${l.antal} per kommun`, `${Plur} i ${l.namn} – ${l.antal} st`].find((t) => t.length <= 60) ?? `${Plur} i ${l.kortnamn}`;
---
<Layout site={site} titel={titel}
  beskrivning={`Alla ${l.antal} ${ord.plur} i ${l.namn} sorterade per kommun. ✓ Adresser och öppettider ✓ ${l.kommuner.length} kommuner ✓ Uppdateras varje natt.`}
  smulor={[{ namn: "Start", href: "/" }, { namn: l.kortnamn, href: l.href }]} jsonld={[faqLd(fragor)]} uppdaterad={uppdaterad}>
  <h1>{Plur} i {l.namn}</h1>
  <p class="svar">{l.namn} har <strong>{l.antal} {ord.plur}</strong> i {l.kommuner.length} kommuner. Flest finns i {storst[0].namn} ({storst[0].enheter.length} st).</p>
  <div class="tabell"><table>
    <thead><tr><th>Kommun</th><th class="num">{Plur}</th></tr></thead>
    <tbody>{l.kommuner.map((k) => <tr><td><a href={k.href}>{k.namn}</a></td><td class="num">{k.enheter.length}</td></tr>)}</tbody>
  </table></div>
  <Annons plats="lan-1" />
  <Faq fragor={fragor} />
  <p class="kalla">{kallaText}</p>
</Layout>
