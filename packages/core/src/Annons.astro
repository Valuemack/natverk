---
// Annonsyta med reserverad höjd (ingen layoutförskjutning/CLS).
// Ytan renderas bara när ett AdSense-konto finns (env PUBLIC_ADSENSE_KLIENT, t.ex. "ca-pub-123…").
// Utan konto blir det ingenting alls i produktion – inga tomma luckor för besökare eller granskare.
// I dev-läge syns en markering så att placeringen går att se.
const { plats = "innehall", hojd = 280 } = Astro.props;
const dev = import.meta.env.DEV;
const klient = import.meta.env.PUBLIC_ADSENSE_KLIENT;
const visa = dev || !!klient;
---
{visa && (
  <aside class:list={["annons", { "annons-dev": dev && !klient }]} style={`min-height:${hojd}px`} data-plats={plats} data-klient={klient} aria-label="Annons">
    {dev && !klient && <span>Annonsplats ({plats})</span>}
  </aside>
)}
